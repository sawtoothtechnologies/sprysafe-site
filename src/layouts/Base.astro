---
import '../styles/global.css';

const { title, description, image = '/og.png' } = Astro.props;
const year = new Date().getFullYear();
const site = Astro.site ?? new URL('https://sprysafe.com');
const ogImage = new URL(image, site).href;
const canonical = new URL(Astro.url.pathname, site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content="ScamPrep" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <header class="site-header">
      <div class="wrap header-inner">
        <a class="logo" href="/" aria-label="ScamPrep home">
          <!-- Radar dial: outer ring, inner ring, needle, amber center. -->
          <svg width="32" height="32" viewBox="0 0 40 40" fill="none" aria-hidden="true">
            <circle cx="20" cy="20" r="16" fill="none" stroke="currentColor" stroke-width="3" />
            <circle cx="20" cy="20" r="10" fill="none" stroke="currentColor" stroke-width="1.6" opacity="0.45" />
            <line x1="20" y1="20" x2="30.6" y2="9.4" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
            <circle cx="20" cy="20" r="5.5" fill="#f0a11c" />
          </svg>
          <span>ScamPrep</span>
        </a>

        <button class="menu-toggle" aria-expanded="false" aria-controls="site-nav">
          Menu
        </button>

        <nav id="site-nav" class="site-nav" aria-label="Main">
          <a href="/how-it-works">How it works</a>
          <a href="/why-it-works">Why it works</a>
          <a href="/solutions">For organizations</a>
          <a href="/pricing">Pricing</a>
          <a href="/about">About</a>
          <a href="/early-access" class="btn btn--ink btn--nav">Start your free trial</a>
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <div class="footer-grid">
          <div>
            <p class="footer-logo">
              <svg width="26" height="26" viewBox="0 0 40 40" fill="none" aria-hidden="true">
                <circle cx="20" cy="20" r="16" fill="none" stroke="#f8f7f4" stroke-width="3" />
                <circle cx="20" cy="20" r="10" fill="none" stroke="#f8f7f4" stroke-width="1.6" opacity="0.45" />
                <line x1="20" y1="20" x2="30.6" y2="9.4" stroke="#f8f7f4" stroke-width="2" stroke-linecap="round" />
                <circle cx="20" cy="20" r="5.5" fill="#f0a11c" />
              </svg>
              <span>ScamPrep</span>
            </p>
            <p class="footer-tag">A fire drill for scams.</p>
            <p><a href="mailto:hello@sprysafe.com">hello@sprysafe.com</a></p>
          </div>
          <nav aria-label="Footer — product">
            <p class="footer-head">Product</p>
            <a href="/how-it-works">How it works</a>
            <a href="/why-it-works">Why it works</a>
            <a href="/pricing">Pricing</a>
            <a href="/early-access">Start your free trial</a>
          </nav>
          <nav aria-label="Footer — solutions">
            <p class="footer-head">Solutions</p>
            <a href="/solutions">For organizations</a>
            <a href="/solutions#pricing">Partner pricing</a>
            <a href="mailto:hello@sprysafe.com?subject=ScamPrep%20partner%20call">Book a call</a>
          </nav>
          <nav aria-label="Footer — company">
            <p class="footer-head">Company</p>
            <a href="/about">About</a>
            <a href="/promise">Our promise</a>
            <a href="/faq">FAQ</a>
            <a href="/privacy">Privacy</a>
            <a href="/terms">Terms</a>
          </nav>
        </div>
        <p class="footer-disclaimer">
          ScamPrep provides educational simulations and training. It does not provide financial,
          legal, or medical advice, and no training program can guarantee protection from fraud.
          ScamPrep is a product of Sawtooth Technologies LLC. © {year} Sawtooth Technologies LLC.
        </p>
      </div>
    </footer>

    <script>
      const toggle = document.querySelector('.menu-toggle');
      const navEl = document.querySelector('.site-nav');
      toggle?.addEventListener('click', () => {
        const open = navEl.classList.toggle('is-open');
        toggle.setAttribute('aria-expanded', String(open));
      });

      // Gentle scroll-reveal on cards, stats, and step tiles, sitewide.
      // The .reveal class (and its hidden starting state) is only ever added
      // here, so no-JS visitors and reduced-motion users see everything
      // immediately. Siblings stagger slightly for a composed feel.
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if ('IntersectionObserver' in window && !reduceMotion) {
        const targets = document.querySelectorAll(
          '.card, .stat, .step, .faq-item, .table-scroll, .price-card'
        );
        const siblingIndex = new Map();
        targets.forEach((el) => {
          const parent = el.parentElement;
          const i = siblingIndex.get(parent) || 0;
          siblingIndex.set(parent, i + 1);
          el.style.setProperty('--reveal-delay', Math.min(i * 90, 360) + 'ms');
          el.classList.add('reveal');
        });
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('reveal--in');
                io.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.12, rootMargin: '0px 0px -40px 0px' }
        );
        targets.forEach((el) => io.observe(el));
      }
    </script>

    <style>
      .site-header {
        position: sticky;
        top: 0;
        z-index: 50;
        background: rgba(248, 247, 244, 0.94);
        backdrop-filter: blur(8px);
        border-bottom: 1px solid var(--line);
      }
      .header-inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        padding-top: 14px;
        padding-bottom: 14px;
      }
      .logo {
        display: flex;
        align-items: center;
        gap: 10px;
        font-family: var(--font-display);
        font-size: 1.4rem;
        font-weight: 800;
        letter-spacing: -0.04em;
        color: var(--ink);
        text-decoration: none;
      }
      .site-nav {
        display: flex;
        align-items: center;
        gap: 26px;
      }
      .site-nav > a:not(.btn), .dropdown__trigger {
        text-decoration: none;
        color: var(--ink);
        font-weight: 600;
        font-size: 0.98rem;
        white-space: nowrap;
      }
      .site-nav > a:not(.btn):hover, .dropdown__trigger:hover { color: var(--amber-text); }
      .btn--nav { padding: 11px 22px; font-size: 0.95rem; }

      .dropdown { position: relative; }
      .dropdown__menu {
        position: absolute;
        top: 100%;
        left: -14px;
        padding: 10px 0;
        min-width: 230px;
        background: var(--white);
        border: 1px solid var(--line);
        border-radius: var(--radius);
        box-shadow: var(--shadow-lg);
        display: none;
        flex-direction: column;
      }
      .dropdown:hover .dropdown__menu,
      .dropdown:focus-within .dropdown__menu { display: flex; }
      .dropdown__menu a {
        padding: 10px 20px;
        text-decoration: none;
        color: var(--ink);
        font-weight: 600;
        font-size: 0.98rem;
      }
      .dropdown__menu a:hover { background: var(--sand); color: var(--ink); }

      .menu-toggle {
        display: none;
        font: inherit;
        font-family: var(--font-body);
        font-weight: 700;
        background: none;
        border: 1.5px solid var(--line-strong);
        border-radius: var(--radius-ctrl);
        padding: 9px 15px;
        color: var(--ink);
        cursor: pointer;
      }
      .menu-toggle:hover { border-color: var(--ink); }

      @media (max-width: 900px) {
        .menu-toggle { display: block; }
        .site-nav {
          display: none;
          position: absolute;
          top: 100%;
          left: 0;
          right: 0;
          flex-direction: column;
          align-items: stretch;
          background: var(--paper-bg);
          border-bottom: 1px solid var(--line);
          padding: 18px 24px 26px;
          gap: 18px;
          box-shadow: var(--shadow-lg);
        }
        .site-nav.is-open { display: flex; }
        .site-nav .btn--nav { text-align: center; }
        .dropdown__menu {
          position: static;
          display: flex;
          box-shadow: none;
          border: none;
          background: transparent;
          padding: 6px 0 0 16px;
        }
        .dropdown__trigger { pointer-events: none; }
      }

      .site-footer {
        background: var(--ink);
        color: var(--gray-400);
        padding: 64px 0 40px;
        margin-top: 0;
      }
      .footer-grid {
        display: grid;
        gap: 36px;
        grid-template-columns: 1fr;
        margin-bottom: 40px;
      }
      @media (min-width: 760px) {
        .footer-grid { grid-template-columns: 1.4fr 1fr 1fr 1fr; }
      }
      .footer-logo {
        display: flex;
        align-items: center;
        gap: 9px;
        font-family: var(--font-display);
        font-size: 1.35rem;
        font-weight: 800;
        letter-spacing: -0.03em;
        color: var(--paper-bg);
        margin-bottom: 4px;
      }
      .footer-tag { color: var(--gray-500); margin-bottom: 14px; }
      .footer-head {
        font-size: 0.7rem;
        font-weight: 800;
        letter-spacing: 0.13em;
        text-transform: uppercase;
        color: var(--gray-500);
        margin-bottom: 12px;
      }
      .site-footer nav { display: flex; flex-direction: column; gap: 9px; }
      .site-footer a { color: #d5d2cc; text-decoration: none; font-size: 0.98rem; }
      .site-footer a:hover { color: var(--amber); text-decoration: underline; }
      .footer-disclaimer {
        font-size: 0.85rem;
        color: var(--gray-500);
        border-top: 1px solid var(--ink-2);
        padding-top: 24px;
        max-width: 900px;
      }
    </style>
  </body>
</html>
