---
import '../styles/global.css';

const { title, description, image = '/og.png' } = Astro.props;
const year = new Date().getFullYear();
const site = Astro.site ?? new URL('https://getscamprep.com');
const ogImage = new URL(image, site).href;
const canonical = new URL(Astro.url.pathname, site).href;

// Organization structured data: tells Google that "ScamPrep" the brand entity
// lives at this domain and owns these social profiles. Add profiles to sameAs
// as they become active (same rule as the footer icons).
const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'ScamPrep',
  url: site.href,
  logo: new URL('/apple-touch-icon.png', site).href,
  email: 'hello@getscamprep.com',
  description:
    'Simulated scam drills and coaching that help seniors and vulnerable adults build resistance to fraud.',
  parentOrganization: { '@type': 'Organization', name: 'Sawtooth Technologies LLC' },
  sameAs: [
    'https://www.linkedin.com/company/scamprep',
    'https://www.facebook.com/profile.php?id=61592872956928',
    'https://x.com/ScamPrep',
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content="ScamPrep" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <script type="application/ld+json" set:html={JSON.stringify(orgSchema)} />
    <!-- Cloudflare Web Analytics. Paste the site token from
         Cloudflare dashboard → Analytics & Logs → Web Analytics. -->
    <script
      defer
      src="https://static.cloudflareinsights.com/beacon.min.js"
      data-cf-beacon='{"token": "REPLACE_WITH_CF_BEACON_TOKEN"}'
    ></script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <header class="site-header">
      <div class="wrap header-inner">
        <a class="logo" href="/" aria-label="ScamPrep home">
          <!-- Radar dial: outer ring, inner ring, needle, amber center. -->
          <svg width="32" height="32" viewBox="0 0 40 40" fill="none" aria-hidden="true">
            <circle cx="20" cy="20" r="16" fill="none" stroke="currentColor" stroke-width="3" />
            <circle cx="20" cy="20" r="10" fill="none" stroke="currentColor" stroke-width="1.6" opacity="0.45" />
            <line x1="20" y1="20" x2="30.6" y2="9.4" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
            <circle cx="20" cy="20" r="5.5" fill="#f0a11c" />
          </svg>
          <span>ScamPrep</span>
        </a>

        <button class="menu-toggle" aria-expanded="false" aria-controls="site-nav">
          Menu
        </button>

        <nav id="site-nav" class="site-nav" aria-label="Main">
          <a href="/how-it-works">How it works</a>
          <a href="/why-it-works">Why it works</a>
          <a href="/solutions">For organizations</a>
          <a href="/pricing">Pricing</a>
          <a href="/about">About</a>
          <a href="/early-access" class="btn btn--ink btn--nav">Get early access</a>
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <div class="footer-grid">
          <div>
            <p class="footer-logo">
              <svg width="26" height="26" viewBox="0 0 40 40" fill="none" aria-hidden="true">
                <circle cx="20" cy="20" r="16" fill="none" stroke="#f8f7f4" stroke-width="3" />
                <circle cx="20" cy="20" r="10" fill="none" stroke="#f8f7f4" stroke-width="1.6" opacity="0.45" />
                <line x1="20" y1="20" x2="30.6" y2="9.4" stroke="#f8f7f4" stroke-width="2" stroke-linecap="round" />
                <circle cx="20" cy="20" r="5.5" fill="#f0a11c" />
              </svg>
              <span>ScamPrep</span>
            </p>
            <p class="footer-tag">A fire drill for scams.</p>
            <p><a href="mailto:hello@getscamprep.com">hello@getscamprep.com</a></p>
            <div class="footer-social">
              <!-- Active channels only. Add a platform's icon here the week it starts
                   carrying content — an empty profile is worse than no link. -->
              <a href="https://www.linkedin.com/company/scamprep" target="_blank" rel="noopener" aria-label="ScamPrep on LinkedIn">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M20.45 20.45h-3.55v-5.57c0-1.33-.03-3.04-1.85-3.04-1.86 0-2.14 1.45-2.14 2.94v5.67H9.36V9h3.41v1.56h.05c.47-.9 1.63-1.85 3.36-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12zM7.12 20.45H3.55V9h3.57v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.72v20.55C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.72C24 .77 23.2 0 22.22 0z"/>
                </svg>
              </a>
              <a href="https://www.facebook.com/profile.php?id=61592872956928" target="_blank" rel="noopener" aria-label="ScamPrep on Facebook">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M22 12.06C22 6.5 17.52 2 12 2S2 6.5 2 12.06c0 5.02 3.66 9.18 8.44 9.94v-7.03H7.9v-2.9h2.54V9.85c0-2.52 1.49-3.9 3.77-3.9 1.09 0 2.24.19 2.24.19v2.47h-1.26c-1.24 0-1.63.77-1.63 1.56v1.88h2.78l-.44 2.9h-2.34V22c4.78-.76 8.44-4.92 8.44-9.94z"/>
                </svg>
              </a>
              <a href="https://x.com/ScamPrep" target="_blank" rel="noopener" aria-label="ScamPrep on X">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M18.9 1.15h3.68l-8.04 9.19L24 22.85h-7.41l-5.8-7.58-6.64 7.58H.47l8.6-9.83L0 1.15h7.6l5.24 6.93 6.06-6.93Zm-1.29 19.5h2.04L6.49 3.24H4.3l13.31 17.4Z"/>
                </svg>
              </a>
            </div>
          </div>
          <nav aria-label="Footer — product">
            <p class="footer-head">Product</p>
            <a href="/how-it-works">How it works</a>
            <a href="/why-it-works">Why it works</a>
            <a href="/pricing">Pricing</a>
            <a href="/early-access">Get early access</a>
          </nav>
          <nav aria-label="Footer — solutions">
            <p class="footer-head">Solutions</p>
            <a href="/solutions">For organizations</a>
            <a href="/solutions#pricing">Partner pricing</a>
            <a href="https://cal.com/scamprep/partner-call">Book a call</a>
          </nav>
          <nav aria-label="Footer — company">
            <p class="footer-head">Company</p>
            <a href="/about">About</a>
            <a href="/promise">Our promise</a>
            <a href="/faq">FAQ</a>
            <a href="/privacy">Privacy</a>
            <a href="/terms">Terms</a>
          </nav>
        </div>
        <p class="footer-disclaimer">
          ScamPrep provides educational simulations and training. It does not provide financial,
          legal, or medical advice, and no training program can guarantee protection from fraud.
          ScamPrep is a product of Sawtooth Technologies LLC. © {year} Sawtooth Technologies LLC.
        </p>
      </div>
    </footer>

    <script>
      const toggle = document.querySelector('.menu-toggle');
      const navEl = document.querySelector('.site-nav');
      toggle?.addEventListener('click', () => {
        const open = navEl.classList.toggle('is-open');
        toggle.setAttribute('aria-expanded', String(open));
      });

      // Gentle scroll-reveal on cards, stats, and step tiles, sitewide.
      // The .reveal class (and its hidden starting state) is only ever added
      // here, so no-JS visitors and reduced-motion users see everything
      // immediately. Siblings stagger slightly for a composed feel.
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if ('IntersectionObserver' in window && !reduceMotion) {
        const targets = document.querySelectorAll(
          '.card, .stat, .step, .faq-item, .table-scroll, .price-card'
        );
        const siblingIndex = new Map();
        targets.forEach((el) => {
          const parent = el.parentElement;
          const i = siblingIndex.get(parent) || 0;
          siblingIndex.set(parent, i + 1);
          el.style.setProperty('--reveal-delay', Math.min(i * 90, 360) + 'ms');
          el.classList.add('reveal');
        });
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('reveal--in');
                io.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.12, rootMargin: '0px 0px -40px 0px' }
        );
        targets.forEach((el) => io.observe(el));
      }
    </script>

    <style>
      .site-header {
        position: sticky;
        top: 0;
        z-index: 50;
        background: rgba(248, 247, 244, 0.94);
        backdrop-filter: blur(8px);
        border-bottom: 1px solid var(--line);
      }
      .header-inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        padding-top: 14px;
        padding-bottom: 14px;
      }
      .logo {
        display: flex;
        align-items: center;
        gap: 10px;
        font-family: var(--font-display);
        font-size: 1.4rem;
        font-weight: 800;
        letter-spacing: -0.04em;
        color: var(--ink);
        text-decoration: none;
      }
      .site-nav {
        display: flex;
        align-items: center;
        gap: 26px;
      }
      .site-nav > a:not(.btn), .dropdown__trigger {
        text-decoration: none;
        color: var(--ink);
        font-weight: 600;
        font-size: 0.98rem;
        white-space: nowrap;
      }
      .site-nav > a:not(.btn):hover, .dropdown__trigger:hover { color: var(--amber-text); }
      .btn--nav { padding: 11px 22px; font-size: 0.95rem; }

      .dropdown { position: relative; }
      .dropdown__menu {
        position: absolute;
        top: 100%;
        left: -14px;
        padding: 10px 0;
        min-width: 230px;
        background: var(--white);
        border: 1px solid var(--line);
        border-radius: var(--radius);
        box-shadow: var(--shadow-lg);
        display: none;
        flex-direction: column;
      }
      .dropdown:hover .dropdown__menu,
      .dropdown:focus-within .dropdown__menu { display: flex; }
      .dropdown__menu a {
        padding: 10px 20px;
        text-decoration: none;
        color: var(--ink);
        font-weight: 600;
        font-size: 0.98rem;
      }
      .dropdown__menu a:hover { background: var(--sand); color: var(--ink); }

      .menu-toggle {
        display: none;
        font: inherit;
        font-family: var(--font-body);
        font-weight: 700;
        background: none;
        border: 1.5px solid var(--line-strong);
        border-radius: var(--radius-ctrl);
        padding: 9px 15px;
        color: var(--ink);
        cursor: pointer;
      }
      .menu-toggle:hover { border-color: var(--ink); }

      @media (max-width: 900px) {
        .menu-toggle { display: block; }
        /* 44px touch targets for the logo and open-menu links. */
        .logo { padding: 4px 0; }
        .site-nav > a:not(.btn) { padding: 10px 0; }
        .site-nav {
          display: none;
          position: absolute;
          top: 100%;
          left: 0;
          right: 0;
          flex-direction: column;
          align-items: stretch;
          background: var(--paper-bg);
          border-bottom: 1px solid var(--line);
          padding: 18px 24px 26px;
          gap: 18px;
          box-shadow: var(--shadow-lg);
        }
        .site-nav.is-open { display: flex; }
        .site-nav .btn--nav { text-align: center; }
        .dropdown__menu {
          position: static;
          display: flex;
          box-shadow: none;
          border: none;
          background: transparent;
          padding: 6px 0 0 16px;
        }
        .dropdown__trigger { pointer-events: none; }
      }

      .site-footer {
        background: var(--ink);
        color: var(--gray-400);
        padding: 64px 0 40px;
        margin-top: 0;
      }
      .footer-grid {
        display: grid;
        gap: 36px;
        grid-template-columns: 1fr;
        margin-bottom: 40px;
      }
      @media (min-width: 760px) {
        .footer-grid { grid-template-columns: 1.4fr 1fr 1fr 1fr; }
      }
      .footer-logo {
        display: flex;
        align-items: center;
        gap: 9px;
        font-family: var(--font-display);
        font-size: 1.35rem;
        font-weight: 800;
        letter-spacing: -0.03em;
        color: var(--paper-bg);
        margin-bottom: 4px;
      }
      .footer-tag { color: var(--gray-500); margin-bottom: 14px; }
      .footer-head {
        font-size: 0.7rem;
        font-weight: 800;
        letter-spacing: 0.13em;
        text-transform: uppercase;
        color: var(--gray-500);
        margin-bottom: 12px;
      }
      .site-footer nav { display: flex; flex-direction: column; gap: 9px; }
      .site-footer a { color: #d5d2cc; text-decoration: none; font-size: 0.98rem; }
      .site-footer a:hover { color: var(--amber); text-decoration: underline; }
      .footer-social { display: flex; gap: 16px; margin-top: 14px; }
      .footer-social a { color: #d5d2cc; line-height: 0; }
      .footer-social a:hover { color: var(--amber); }
      .footer-disclaimer {
        font-size: 0.85rem;
        color: var(--gray-500);
        border-top: 1px solid var(--ink-2);
        padding-top: 24px;
        max-width: 900px;
      }
      /* 44px touch targets for footer links on touch-width screens. */
      @media (max-width: 900px) {
        .site-footer nav a,
        .site-footer p > a { display: inline-block; padding: 10px 0; }
        .footer-social { gap: 22px; }
        .footer-social a { padding: 11px; margin: -11px; }
      }
    </style>

    <script>
      // Remember campaign tags (?utm_source=...) from the landing page for the whole
      // visit, so the early-access form can report which channel produced the signup
      // even when the visitor browses other pages first.
      try {
        const p = new URLSearchParams(location.search);
        for (const k of ['utm_source', 'utm_medium', 'utm_campaign']) {
          const v = p.get(k);
          if (v) sessionStorage.setItem(k, v);
        }
      } catch {}
    </script>
  </body>
</html>
