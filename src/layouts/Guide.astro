---
// One guide at /guides/<slug>. The rules every guide follows are in
// ~/ScamPrep/seo/article-standard.md; this layout supplies the parts that never
// change: byline, dates, sources, related guides, the early-access ask, and the
// structured data Google and AI search read.
import Base from './Base.astro';
import { HUBS } from '../data/guides.js';
import { curly, formatDate, isoDate } from '../lib/guides.js';

const { guide, related = [], headings = [] } = Astro.props;
const d = guide.data;
// "On this page": the h2 headings as jump links, shown only on longer guides (four or
// more sections), so a reader in a hurry can go straight to the part they need.
const toc = headings.filter((h) => h.depth === 2);
const showToc = toc.length >= 4;
const hub = HUBS.find((h) => h.id === d.hub);
const site = Astro.site ?? new URL('https://getscamprep.com');
const url = new URL(`/guides/${guide.id}`, site).href;
// The guide's own share image, falling back to the site default for older guides.
const image = d.image ?? '/og-v3.png';
const imageAlt = d.imageAlt ?? 'ScamPrep. Pamphlets fade. Practice sticks.';

const author = {
  '@type': 'Person',
  name: 'Bryce Wachtell',
  jobTitle: 'Founder',
  url: new URL('/about', site).href,
  sameAs: ['https://www.linkedin.com/in/j-bryce-wachtell/'],
  worksFor: { '@type': 'Organization', name: 'ScamPrep', url: site.href },
};
const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: d.title,
  description: d.description,
  datePublished: isoDate(d.published),
  dateModified: isoDate(d.reviewed),
  author,
  publisher: {
    '@type': 'Organization',
    name: 'ScamPrep',
    url: site.href,
    logo: { '@type': 'ImageObject', url: new URL('/apple-touch-icon.png', site).href },
  },
  mainEntityOfPage: { '@type': 'WebPage', '@id': url },
  image: new URL(image, site).href,
  isPartOf: { '@type': 'CollectionPage', name: 'ScamPrep guides', url: new URL('/guides', site).href },
  citation: d.sources.map((s) => s.url),
};
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Guides', item: new URL('/guides', site).href },
    { '@type': 'ListItem', position: 2, name: hub.name, item: new URL(`/guides#${hub.id}`, site).href },
    { '@type': 'ListItem', position: 3, name: d.title, item: url },
  ],
};
---

<Base
  title={`${d.seoTitle ?? d.title} | ScamPrep`}
  shareTitle={d.seoTitle ?? d.title}
  description={d.description}
  image={image}
  imageAlt={imageAlt}
  ogType="article"
>
  <Fragment slot="head">
    <meta property="article:published_time" content={isoDate(d.published)} />
    <meta property="article:modified_time" content={isoDate(d.reviewed)} />
    <meta property="article:author" content="Bryce Wachtell" />
    <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  </Fragment>

  <article class="section guide">
    <div class="wrap">
      <nav class="crumbs" aria-label="Breadcrumb">
        <a href="/guides">Guides</a>
        <span aria-hidden="true">/</span>
        <a href={`/guides#${hub.id}`}>{hub.name}</a>
      </nav>

      <header class="guide__head">
        <h1>{d.title}</h1>
        <p class="byline">
          By <a href="/about" rel="author">Bryce Wachtell</a>, founder of ScamPrep
        </p>
        <p class="dates">
          <span>Published <time datetime={isoDate(d.published)}>{formatDate(d.published)}</time></span>
          <span>Last reviewed <time datetime={isoDate(d.reviewed)}>{formatDate(d.reviewed)}</time></span>
        </p>
      </header>

      {showToc && (
        <nav class="guide__toc" aria-labelledby="toc-title">
          <p id="toc-title" class="guide__toc-title">On this page</p>
          <ol>
            {toc.map((h) => (
              <li><a href={`#${h.slug}`}>{h.text}</a></li>
            ))}
          </ol>
        </nav>
      )}

      <div class="guide__body prose">
        <slot />
      </div>

      <aside class="guide__ask" aria-labelledby="guide-ask-title">
        <h2 id="guide-ask-title">Practice spotting scams before the real thing</h2>
        <p>
          ScamPrep provides realistic scam practice for older adults, with friendly coaching
          after a slip. For yourself, or for someone you love.
        </p>
        <p><a class="btn btn--primary" href="/pricing">See plans</a></p>
      </aside>

      {related.length > 0 && (
        <section class="guide__related" aria-labelledby="related-title">
          <h2 id="related-title">Related guides</h2>
          <ul>
            {related.map((r) => (
              <li><a href={`/guides/${r.id}`}>{r.data.title}</a></li>
            ))}
          </ul>
        </section>
      )}

      <section class="guide__sources prose" aria-label="Sources">
        <p class="guide__sources-list">
          <strong>Sources:</strong>{' '}
          {d.sources.map((s, i) => (
            <>
              {s.publisher}, <a href={s.url}>{curly(s.title)}</a>{s.date && <>, {s.date}</>}
              {i < d.sources.length - 1 ? '; ' : '.'}
            </>
          ))}
        </p>
        {d.corrections.length > 0 && (
          <>
            <h3>Corrections</h3>
            <ul>
              {d.corrections.map((c) => (
                <li><time datetime={isoDate(c.date)}>{formatDate(c.date)}</time>: {c.note}</li>
              ))}
            </ul>
          </>
        )}
        <p class="guide__standards">
          This guide is education, not legal or financial advice.
          <a href="/editorial-standards">How we write our guides</a>.
          Spot a mistake or have a suggestion? Email <a href="mailto:corrections@getscamprep.com">corrections@getscamprep.com</a> and we’ll take a look.
        </p>
      </section>
    </div>
  </article>
</Base>

<style>
  .guide .wrap { max-width: calc(var(--maxw-text) + 48px); }
  .crumbs {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 10px;
    font-size: 1rem;
    font-weight: 600;
    color: var(--gray-500);
    margin-bottom: 18px;
  }
  .crumbs a {
    color: var(--amber-text);
    text-decoration: none;
    display: inline-block;
    padding: 11px 0;
    margin: -11px 0;
  }
  .crumbs a:hover { text-decoration: underline; }
  .guide__head { margin-bottom: 36px; padding-bottom: 24px; border-bottom: 1px solid var(--line); }
  .guide__head h1 { margin-bottom: 18px; }
  .byline { font-weight: 600; margin: 0 0 4px; }
  .byline a { color: var(--ink); }
  .dates {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 18px;
    margin: 0;
    font-size: 1rem;
    color: var(--gray-500);
  }

  .guide__toc {
    margin: 0 0 36px;
    padding: 18px 22px;
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    font-size: 1rem;
  }
  .guide__toc-title {
    margin: 0 0 8px;
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    color: var(--gray-500);
  }
  .guide__toc ol { margin: 0; padding-left: 1.3em; }
  .guide__toc li { margin: 0; }
  /* Block, not inline-block: an inline-block link that wraps drags the list number
     down to its last line on phones. */
  .guide__toc a {
    display: block;
    padding: 9px 0;
    color: var(--amber-text);
    text-decoration: none;
    text-underline-offset: 3px;
  }
  .guide__toc a:hover { text-decoration: underline; }

  /* Guide text: a little roomier than marketing prose, since people read these
     slowly and often on a phone. */
  .guide__body { font-size: 1.0625rem; line-height: 1.7; }
  /* Room for the sticky header, so a jump link (and a browser's #anchor) lands with the
     heading in view instead of under the header. */
  .guide__body :global(h2) { margin-top: 2em; scroll-margin-top: 96px; }
  .guide__body :global(ul), .guide__body :global(ol) { padding-left: 1.3em; }
  .guide__body :global(li) { margin-bottom: 0.5em; }
  .guide__body :global(a) { color: var(--amber-text); text-underline-offset: 3px; }
  .guide__body :global(a:hover) { color: var(--amber-deep); }

  /* The lines to say, set off so they're easy to find again (and to read aloud). */
  .guide__body :global(.say) {
    background: var(--glow);
    border: 1px solid var(--amber);
    border-radius: var(--radius);
    padding: 18px 22px;
    margin: 24px 0;
  }
  .guide__body :global(.say p:last-child) { margin-bottom: 0; }

  /* A simulated scam, always labeled "Simulated". */
  .guide__body :global(.simulated) {
    background: var(--white);
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    padding: 18px 22px;
    margin: 24px 0;
  }
  .guide__body :global(.simulated__label) {
    display: inline-block;
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--amber-deep);
    background: var(--amber-tint);
    border-radius: var(--radius-chip);
    padding: 2px 10px;
    margin: 0 0 12px;
  }
  .guide__body :global(.simulated p:last-child) { margin-bottom: 0; }

  .guide__ask {
    margin: 56px 0 0;
    padding: 28px;
    background: var(--glow);
    border: 1px solid var(--amber);
    border-radius: var(--radius);
  }
  .guide__ask h2 { margin-top: 0; font-size: 1.4rem; }
  .guide__ask p:last-child { margin-bottom: 0; }

  .guide__related { margin-top: 48px; }
  .guide__related h2 { font-size: 1.4rem; }
  .guide__related ul { list-style: none; padding: 0; margin: 0; }
  .guide__related li { border-top: 1px solid var(--line); }
  .guide__related li:last-child { border-bottom: 1px solid var(--line); }
  .guide__related a {
    display: block;
    padding: 14px 0;
    font-weight: 700;
    color: var(--ink);
    text-decoration: none;
  }
  .guide__related a:hover { color: var(--amber-text); }

  .guide__sources { margin-top: 48px; font-size: 1rem; line-height: 1.6; color: var(--gray-500); }
  .guide__sources-list { overflow-wrap: anywhere; }
  .guide__sources h3 { font-size: 1rem; margin-top: 1.5em; }
  .guide__sources a { color: var(--amber-text); }
  .guide__standards { margin-top: 28px; padding-top: 20px; border-top: 1px solid var(--line); }
  .guide__standards a { color: var(--amber-text); }
</style>
