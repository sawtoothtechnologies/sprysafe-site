---
import Base from '../layouts/Base.astro';

// FORM BACKEND: Formspree (form "ScamPrep early access", ID moeajjvb). This page was
// /early-access until October 28, 2026; public/_redirects sends the old address here.
// Submissions arrive at hello@getscamprep.com. Keep reCAPTCHA OFF in Formspree
// settings — the fetch-based submit below is rejected if it's on.
const FORM_ACTION = 'https://formspree.io/f/moeajjvb';
---

<Base
  title="Stay in Touch | ScamPrep"
  shareTitle="Stay in touch with ScamPrep"
  description="Not ready to choose a plan? Leave your email for the occasional note on what's new at ScamPrep."
>
  <section class="section">
    <div class="wrap form-layout">
      <div>
        <p class="kicker">Stay in touch</p>
        <h1>Not ready yet? Stay in touch.</h1>
        <p class="lede">
          Leave your email and we'll send the occasional note on what's new at ScamPrep.
          <strong>When you're ready, <a href="/pricing">plans are here</a>.</strong>
        </p>
        <p class="trust-line">
          Consent-first. No bank access. Cancel anytime. 60-day money-back guarantee. We'll never
          sell your information.
        </p>

        <div class="org-callout org-callout--top">
          <p class="org-callout__head">Financial advisor or enterprise?</p>
          <p class="org-callout__body">
            Financial advisors, credit unions, and others: pilots start with a short call.
          </p>
          <a class="btn btn--ghost" href="/solutions">See partner options</a>
        </div>
      </div>

      <form class="form-card" method="POST" action={FORM_ACTION}>
        <input type="hidden" id="plan" name="plan" value="" />
        <input type="hidden" id="utm_source" name="utm_source" value="" />
        <input type="hidden" id="utm_medium" name="utm_medium" value="" />
        <input type="hidden" id="utm_campaign" name="utm_campaign" value="" />
        <input type="hidden" id="referrer" name="referrer" value="" />
        <input type="hidden" id="landing_page" name="landing_page" value="" />
        <input type="hidden" id="previous_page" name="previous_page" value="" />
        <input type="hidden" id="latest_landing_page" name="latest_landing_page" value="" />
        <input type="hidden" id="latest_referrer" name="latest_referrer" value="" />
        <input type="hidden" id="latest_utm_source" name="latest_utm_source" value="" />
        <input type="hidden" id="latest_utm_medium" name="latest_utm_medium" value="" />
        <input type="hidden" id="latest_utm_campaign" name="latest_utm_campaign" value="" />
        <div class="field">
          <label for="name">Your name</label>
          <input type="text" id="name" name="name" autocomplete="name" />
        </div>

        <div class="field">
          <label for="email">Email <span class="hint">(required)</span></label>
          <input type="email" id="email" name="email" required autocomplete="email" />
        </div>

        <div class="field">
          <label for="role">I want to…</label>
          <select id="role" name="role">
            <option>Protect someone I care for</option>
            <option>Protect myself</option>
            <option>Other</option>
          </select>
        </div>

        <div class="field">
          <label for="heard_about">How did you hear about us? <span class="hint">(optional)</span></label>
          <input type="text" id="heard_about" name="heard_about" />
        </div>
        <div class="field">
          <label for="worry">What worries you most right now? <span class="hint">(optional)</span></label>
          <textarea id="worry" name="worry" rows="4"></textarea>
        </div>

        <button class="btn btn--primary" type="submit" style="width: 100%;">Stay in touch</button>

        <p class="form-error" id="form-error" role="alert" hidden></p>

        <p class="footnote" style="margin: 16px 0 0;">
                    We'll email you about ScamPrep and nothing else. Unsubscribe anytime.
        </p>
      </form>

      <!-- Phones: the partner box sits after the form instead of before it. -->
      <div class="org-callout org-callout--bottom">
          <p class="org-callout__head">Financial advisor or enterprise?</p>
          <p class="org-callout__body">
            Financial advisors, credit unions, and others: pilots start with a short call.
          </p>
          <a class="btn btn--ghost" href="/solutions">See partner options</a>
        </div>
    </div>
  </section>
</Base>

<script>
  // Carry the plan chosen on /pricing into the submission (?plan=individual|couples|family).
  const query = new URLSearchParams(location.search);
  const planInput = document.getElementById('plan') as HTMLInputElement | null;
  const plan = query.get('plan');
  if (planInput && plan) planInput.value = plan;

  // Where the visit came from, so we can see which guides and channels produce signups
  // (src/lib/attribution.js, inlined by Base.astro, has the rules; if it is missing the
  // signup still works without these fields). The first arrival in this tab fills
  // landing_page, referrer and the utm_ fields as one set; if the visitor came back
  // through another link, that arrival fills the latest_ set. previous_page is the page
  // they clicked through from. Unknown values stay blank and are left out of the email.
  const setField = (id: string, v: string | undefined) => {
    const el = document.getElementById(id) as HTMLInputElement | null;
    if (el && v) el.value = v;
  };
  const attribution = (window as any).scamprepAttribution;
  const TAG_KEYS: string[] = attribution?.TAG_KEYS || ['utm_source', 'utm_medium', 'utm_campaign'];
  const fill = (arrival: Record<string, string> | null, prefix: string) => {
    if (!arrival) return;
    setField(prefix + 'landing_page', arrival.page);
    setField(prefix + 'referrer', arrival.referrer);
    for (const k of TAG_KEYS) setField(prefix + k, arrival[k]);
  };
  if (attribution) {
    const { first, latest } = attribution.recordArrival();
    fill(first, '');
    fill(latest, 'latest_');
    setField('previous_page', attribution.previousPage());
  }
  const ARRIVAL_FIELDS = ['landing_page', 'referrer', ...TAG_KEYS];
  const OPTIONAL_FIELDS = ['plan', 'previous_page', 'heard_about', ...ARRIVAL_FIELDS, ...ARRIVAL_FIELDS.map((k) => 'latest_' + k)];

  // Submit via fetch so visitors land on our own /thanks page. (Formspree's hosted
  // redirect is a paid feature; this works on the free plan.) No-JS visitors get a
  // normal POST to Formspree's default confirmation page.
  //
  // If the send fails, the visitor stays here with everything they typed and a
  // plain message. (The old fallback re-posted the form, which sent people to
  // Formspree's page or to a browser "no connection" page with their details lost.)
  const form = document.querySelector('form.form-card') as HTMLFormElement | null;
  const errorEl = document.getElementById('form-error');
  const CONTACT = 'If it keeps happening, email <a href="mailto:hello@getscamprep.com">hello@getscamprep.com</a> and we\'ll add you.';
  const showError = (message: string) => {
    if (!errorEl) return;
    errorEl.innerHTML = `${message} ${CONTACT}`;
    errorEl.hidden = false;
    errorEl.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
  };
  const send = async (data: FormData) => {
    const ctl = new AbortController();
    const timer = setTimeout(() => ctl.abort(), 15000);
    try {
      return await fetch(form!.action, { method: 'POST', body: data, headers: { Accept: 'application/json' }, signal: ctl.signal });
    } finally {
      clearTimeout(timer);
    }
  };
  if (form) {
    let sending = false;
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (sending) return;
      sending = true;
      if (errorEl) errorEl.hidden = true;
      const btn = form.querySelector('button[type="submit"]') as HTMLButtonElement | null;
      if (btn) { btn.disabled = true; btn.textContent = 'Sending…'; }
      const data = new FormData(form);
      // Drop empty attribution fields so signup emails stay clean.
      for (const k of OPTIONAL_FIELDS) {
        if (!data.get(k)) data.delete(k);
      }
      let res: Response | null = null;
      try {
        res = await send(data);
        // A dropped connection or a server hiccup gets one quiet retry.
        if (res.status >= 500) throw new Error(String(res.status));
      } catch {
        await new Promise((r) => setTimeout(r, 1500));
        try { res = await send(data); } catch { res = null; }
      }
      if (res && res.ok) {
        window.location.href = '/thanks';
        return;
      }
      sending = false;
      if (btn) { btn.disabled = false; btn.textContent = 'Stay in touch'; }
      if (res && res.status >= 400 && res.status < 500) {
        showError('That didn\'t go through. Please check your email address and try again.');
      } else {
        showError('We couldn\'t reach our signup service just now. Your details are still here, so please try again in a moment.');
      }
    });
  }
</script>

<style>
  /* On this page only: when the browser jumps to a field (for example an empty
     required field on submit), it lands below the sticky header, not under it. */
  :global(html) { scroll-padding-top: 96px; }
  .form-layout {
    display: grid;
    gap: 48px;
    align-items: start;
  }
  @media (min-width: 920px) {
    .form-layout { grid-template-columns: 1fr 1.1fr; }
  }
  .org-callout {
    margin-top: 34px;
    padding: 22px 24px;
    border: 1px solid var(--line);
    border-radius: 14px;
    background: var(--sand);
  }
  .org-callout--bottom { display: none; margin-top: 0; }
  @media (max-width: 919px) {
    .org-callout--top { display: none; }
    .org-callout--bottom { display: block; }
  }
  .org-callout__head {
    font-weight: 800;
    margin: 0 0 6px;
  }
  .form-error {
    margin: 16px 0 0;
    padding: 14px 16px;
    border: 1px solid var(--alert-line);
    border-radius: var(--radius-ctrl);
    background: var(--alert-tint);
    color: var(--ink);
    font-size: 1rem;
    line-height: 1.5;
  }
  .form-error a { color: var(--ink); font-weight: 700; }
  .org-callout__body {
    font-size: 1rem;
    margin: 0 0 14px;
  }
</style>
