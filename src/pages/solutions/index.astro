---
import Base from '../../layouts/Base.astro';
import CtaBand from '../../components/CtaBand.astro';
import OrgPricing from '../../components/OrgPricing.astro';
import ReportCard from '../../components/ReportCard.astro';
import Faq from '../../components/Faq.astro';

// The objections advisors raise on a first call, answered plainly.
const advisorFaqs = [
  {
    q: 'How will my clients react?',
    a: `<p>Better than you'd guess. Framing does the work, and you control it. This is the same simulate-and-coach training Fortune 500 firms require of every employee, including the CEO. It's offered as a benefit, never an accusation: every participant opts in personally, drills are gentle, and coaching is private. Sharp clients tend to enjoy catching them.</p>`,
  },
  {
    q: 'What will our compliance team ask?',
    a: `<p>The usual questions have short answers:</p>
<ul>
  <li><strong>Account access:</strong> none — ScamPrep never touches money, accounts, or credentials.</li>
  <li><strong>Integrations and data feeds:</strong> none.</li>
  <li><strong>Data held:</strong> the contact channels a participant consents to — nothing financial.</li>
  <li><strong>Texts and calls:</strong> only with written consent, per the TCPA. Enrollment starts with email.</li>
</ul>
<p>There's very little surface to review.</p>`,
  },
  {
    q: 'What happens when a client misses a drill?',
    a: `<p>A private, 30-second, friendly lesson in the moment — no shame, no public score. The family sees the quarter's trend, not a gotcha log, and you see aggregates. The design follows published research on older-adult learning: positive framing, immediate reassurance, never fear.</p>`,
  },
  {
    q: 'Where does this sit with the Senior Safe Act and trusted-contact rules?',
    a: `<p>ScamPrep is not a compliance product and doesn't claim to satisfy any rule. But the regulatory direction is clear: the Senior Safe Act protects firms that train and report, and trusted-contact rules push firms to engage families <em>before</em> there's a problem. A prevention program with quarterly family touchpoints is exactly that posture, documented.</p>`,
  },
];

// Advisor-first: the page speaks only to the cohorts we're actively doing
// outreach to. Order matches the rotating hero; each entry has an anchor id
// for deep links. (Home care, senior living, and community banks were cut
// 2026-08 — restore from git history if outreach widens.)
const audiences = [
  {
    id: 'financial-advisors',
    name: 'Financial advisors',
    hook: 'Protect the person, not just the portfolio.',
    body: "You can diversify away market risk. You can't diversify away a persuasive phone call. ScamPrep trains your clients to hang up on the scams aimed at their savings, and puts the proof in front of their families.",
  },
  {
    id: 'credit-unions',
    name: 'Credit unions',
    hook: 'Protect the member, not just the account.',
    body: 'Every scammed member costs you twice: drained deposits, then the fraud-ops hours and the shaken trust. ScamPrep works upstream of transaction monitoring, training members to hang up before anything moves. Nothing for branch staff to run.',
  },
  {
    id: 'wealth-advisors',
    name: 'Wealth advisors',
    hook: 'The bridge to the next generation.',
    body: 'Estate plans assume the money is still there when it transfers. ScamPrep protects the balance sheet you plan around, and gives the heirs a reason to know your firm before the estate settles.',
  },
];

const rotatorItems = [
  'financial advisors',
  'credit unions',
  'wealth advisors',
];
const partnerCall = 'https://cal.com/scamprep/partner-call';
---

<Base
  title="ScamPrep for Financial Advisors, Credit Unions & Wealth Managers"
  description="One provable scam-resilience program for the advisors families trust — financial advisors, credit unions, and wealth managers. Co-branded quarterly Resilience Report, nothing for staff to run, never touches accounts. Founding-partner pilots open."
>
  <!-- ============ HERO (rotating audience) ============ -->
  <section class="section soln-hero">
    <div class="wrap center">
      <p class="kicker">For organizations</p>
      <h1 class="soln-hero__title">
        <span aria-hidden="true">ScamPrep for <span class="rot" id="rot" data-words={JSON.stringify(rotatorItems)}><span class="rot__inner" id="rot-inner">{rotatorItems[0]}</span></span></span>
        <span class="sr-only">ScamPrep for financial advisors, credit unions, and wealth advisors.</span>
      </h1>
      <p class="lede" style="margin-inline: auto;">
        Train your clients to catch scams before money moves, protecting their financial
        well-being and building goodwill with the next generation.
      </p>
      <div class="btn-row" style="justify-content: center; margin-top: 30px;">
        <a class="btn btn--primary" href={partnerCall}>Book a 20-minute call</a>
        <a class="btn btn--ghost" href="#pricing">See partner pricing</a>
      </div>
    </div>
  </section>

  <!-- ============ WHY PRACTICES (stat band + ledger) ============ -->
  <section class="section section--paper">
    <div class="wrap">
      <!-- The numbers open the section; heading follows them. Same three-up
           treatment as the homepage "Why now" band: dots / ping / trace
           micro-graphics with count-ups, played on scroll into view. -->
      <div class="stat-row" id="why-stats" style="margin-top: 0;">
        <!-- 7 in 10 — ten client households, seven lit (the ones that walk) -->
        <div class="stat-col">
          <div class="stat-line">
            <span class="stat__num">7 in 10</span>
            <p class="stat__label">heirs switch financial advisors after inheriting</p>
          </div>
          <div class="stat__graphic dots" aria-hidden="true">
            <span class="dot dot--on"></span><span class="dot dot--on"></span><span class="dot dot--on"></span>
            <span class="dot dot--on"></span><span class="dot dot--on"></span><span class="dot dot--on"></span>
            <span class="dot dot--on"></span>
            <span class="dot"></span><span class="dot"></span><span class="dot"></span>
          </div>
        </div>

        <!-- $124T — ping rings behind the number -->
        <div class="stat-col">
          <div class="stat-line stat-line--ping">
            <span class="loss-ping" aria-hidden="true"></span>
            <span class="loss-ping loss-ping--2" aria-hidden="true"></span>
            <span class="stat__num" data-countup data-target="124" data-prefix="$" data-suffix="T">$124T</span>
            <p class="stat__label">changing hands by 2048 in the great wealth transfer</p>
          </div>
        </div>

        <!-- 12,000+ — rising trace -->
        <div class="stat-col">
          <div class="stat-line">
            <span class="stat__num" data-countup data-target="12000" data-suffix="+">12,000+</span>
            <p class="stat__label">people each lost $100k+ to fraud in 2025</p>
          </div>
          <div class="stat__graphic" aria-hidden="true">
            <svg class="trace" viewBox="0 0 220 32" preserveAspectRatio="none">
              <path class="trace__line" d="M4 27 C 60 24, 120 18, 160 11 S 204 4, 212 4" fill="none" pathLength="600" />
              <circle cx="212" cy="4" r="3.5" fill="#f0a11c" />
            </svg>
          </div>
        </div>
      </div>

      <div style="margin-top: 48px;">
        <p class="kicker">Why practices run ScamPrep</p>
        <!-- max-width tuned so the line breaks in two on desktop; balance evens the split. -->
        <h2 style="max-width: 38rem;">One convincing phone call can undo a decade of careful planning.</h2>
      </div>

      <ul class="why-list">
        <li>
          <h3><span class="blip" aria-hidden="true"></span>Keep the assets through the wealth transfer</h3>
          <p>When assets pass on to heirs, the financial advisor usually doesn't. The Resilience Report puts your name in front of clients' adult children every quarter, associated with good news about their parent.</p>
        </li>
        <li>
          <h3><span class="blip" aria-hidden="true"></span>A scam is an AUM event</h3>
          <p>More than twelve thousand people each lost $100k+ to fraud in 2025. And that's just what was reported. Those are withdrawals no portfolio plans for, and sometimes the greater cost is the family conversation after. Trained clients lower the odds of both.</p>
        </li>
        <li>
          <h3><span class="blip" aria-hidden="true"></span>Differentiation that takes one sentence</h3>
          <p>“We train our clients against scams, and show their families the progress.” No rate table, model portfolio, or planning tool says that.</p>
        </li>
        <li>
          <h3><span class="blip" aria-hidden="true"></span>Fewer fire drills of the bad kind</h3>
          <p>Talking clients out of scams, or supporting them through the fallout, can take days or weeks. Trained clients spare your practice those unforeseen costs.</p>
        </li>
      </ul>

    </div>
  </section>

  <!-- ============ THE DELIVERABLE (Resilience Report) ============ -->
  <section class="section section--air section--ink" id="report">
    <div class="radar-rings report-band__radar" aria-hidden="true"></div>
    <div class="radar-sweep report-band__radar report-band__sweep" aria-hidden="true"></div>
    <span class="report-band__blip" aria-hidden="true"></span>
    <span class="report-band__blip report-band__blip--2" aria-hidden="true"></span>
    <div class="wrap report-band">
      <div>
        <p class="kicker">The deliverable</p>
        <h2>A quarterly report with your name on it</h2>
        <p class="lede">
          Every three months, the family members each client chooses receive a one-page Resilience
          Report: what was practiced, what was caught, and what comes next.
        </p>
        <ul class="deliv-list">
          <li><strong>Good news, on a schedule.</strong> Monitoring tools write to families after something goes wrong. This is recurring proof their parent is getting harder to fool.</li>
          <li><strong>Your name on every one.</strong> Each report is co-branded to your firm and lands in the inboxes of the generation that inherits.</li>
          <li><strong>Your view stays aggregate.</strong> Participation, catch rates, and who might need a closer look.</li>
        </ul>
      </div>
      <div class="report-band__stage">
        <!-- Callout: the point of the artifact, planted above the letterhead. -->
        <div class="annot annot--top">
          <p class="annot__label annot__label--lg">Your name, in family inboxes, every quarter</p>
          <span class="annot__line" aria-hidden="true"></span>
        </div>

        <!-- The card carries a fictional firm's letterhead: co-branding shown
             in the artifact, not described beside it. -->
        <ReportCard variant="full" tone="dark" cobrand />

        <!-- Callout: the aggregate stat, docked at the card's bottom corner. -->
        <div class="annot annot--stat">
          <p class="annot__chip">
            <span class="annot__num">92%</span>
            <span>practice-wide catch rate · 34 clients enrolled</span>
          </p>
          <span class="annot__line" aria-hidden="true"></span>
          <p class="annot__label">The stat your practice quotes</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ HOW PARTNERSHIPS WORK (reveal panels) ============ -->
  <section class="section">
    <div class="wrap">
      <h2>One program, built to run itself</h2>

      <!-- Titles show first; hover, tap, or tab into a panel for the detail.
           Without JS every panel renders open, so nothing is ever hidden. -->
      <div class="runs" id="runs">
        <button type="button" class="runs__panel" aria-expanded="true">
          <span class="runs__title">Folds into your onboarding<span class="runs__plus" aria-hidden="true">+</span></span>
          <span class="runs__body"><span>Enrollment and consent ride along with your existing client-onboarding or membership flow. We screen for cognitive fit together: appropriate participants only.</span></span>
        </button>
        <button type="button" class="runs__panel" aria-expanded="true">
          <span class="runs__title">Nothing for your staff to run<span class="runs__plus" aria-hidden="true">+</span></span>
          <span class="runs__body"><span>Email-first drills, in-the-moment coaching, and briefings on the newest scams are all handled by ScamPrep. Your team is never in the alert loop.</span></span>
        </button>
        <button type="button" class="runs__panel" aria-expanded="true">
          <span class="runs__title">A co-branded quarterly touchpoint<span class="runs__plus" aria-hidden="true">+</span></span>
          <span class="runs__body"><span>The Resilience Report reaches the family members each client chooses: a recurring, co-branded bridge to the next generation.</span></span>
        </button>
        <button type="button" class="runs__panel" aria-expanded="true">
          <span class="runs__title">Clean on compliance<span class="runs__plus" aria-hidden="true">+</span></span>
          <span class="runs__body"><span>ScamPrep never touches money, accounts, or core systems. No integrations, no data feeds, no client credentials. Vendor review stays short.</span></span>
        </button>
      </div>

    </div>
  </section>

  <!-- ============ AUDIENCE GRID ============ -->
  <section class="section--tight section section--paper">
    <div class="wrap">
      <h2 style="max-width: 34rem;">Built for the people families already trust</h2>
      <!-- Rule-separated ledger mirroring the why-practices list — not another card grid. -->
      <ul class="aud-list">
        {audiences.map((a) => (
          <li id={a.id}>
            <h3><span class="blip" aria-hidden="true"></span>{a.name}</h3>
            <p class="aud-list__hook">{a.hook}</p>
            <p>{a.body}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ============ EVIDENCE STRIP ============ -->
  <section class="section--tight section">
    <div class="wrap center">
      <p class="lede" style="max-width: 48rem; margin-inline: auto;">
        A 2024 federal research review found one-time scam education fades within weeks, and
        called training that <em>simulates</em> scams “promising.” A University of Florida study
        found performance on safe practice drills predicts real-world risk. It's the same
        simulate-coach-measure loop enterprise security teams have run for years.
        <a href="/why-it-works">Read the full case →</a>
      </p>
    </div>
  </section>

  <!-- ============ ADVISOR FAQ ============ -->
  <section class="section--tight section section--paper">
    <div class="wrap faq-split">
      <div class="faq-split__rail">
        <h2>Questions advisors ask</h2>
        <p><a href="/faq">Read the full FAQ →</a></p>
      </div>
      <div class="faq-split__list">
        <Faq items={advisorFaqs} />
      </div>
    </div>
  </section>

  <!-- ============ FOUNDING PILOT TIMELINE ============ -->
  <section class="section">
    <div class="wrap">
      <!-- Artifact-first: the timeline leads; the heading rides beside it on wide screens. -->
      <div class="pilot-open">
        <h2 style="max-width: 34rem;">What a founding pilot looks like</h2>
        <ol class="pilot-steps">
        <li>
          <h3>A 20-minute call</h3>
          <p>Whether ScamPrep fits your clients, what a pilot includes, and pricing. No pitch, no obligation.</p>
        </li>
        <li>
          <h3>You select clients to enroll</h3>
          <p>You know who's a fit — we screen for cognitive appropriateness together.</p>
        </li>
        <li>
          <h3>We handle invitations and consent — nothing for your staff</h3>
          <p>Participants opt in personally, families get visibility, and nobody is monitored behind their back. Oversight without overreach.</p>
        </li>
        <li>
          <h3>Drills begin within two weeks</h3>
          <p>You see your book's baseline catch rate in the first month. The first co-branded Resilience Report lands at quarter's end, alongside your day-90 readout and decision.</p>
        </li>
        </ol>
      </div>
    </div>
  </section>

  <!-- ============ PARTNER PRICING ============ -->
  <section class="section section--paper" id="pricing">
    <div class="wrap center">
      <!-- Artifact-first: the interactive pricing card beside the heading.
           The two payment models ride in the left column as amber-dot bullets
           (same grammar as the deliverable section's list), with the
           founding-pilot note and the on-the-house freebie beneath. -->
      <div class="price-open">
        <div>
          <h2>Simple, volume-based pricing</h2>
          <ul class="price-points">
            <li>
              <strong>Practice-sponsored.</strong> You cover enrollment for the clients you
              choose, at partner pricing. Reads as client appreciation &mdash; and you control
              the roster.
            </li>
            <li>
              <strong>Client-referred.</strong> Families pay for their own plan; your practice
              still gets the co-branded Resilience Report and the aggregate stat.
            </li>
          </ul>
          <p class="price-points__note">
            Every founding pilot starts sponsored &mdash; 90 days, a small roster &mdash; then
            you pick the model that fits.
          </p>
          <p class="price-points__house">
            <strong>On the house:</strong> every founding partner gets ScamPrep for their own
            family, free &mdash; experience a drill before your clients do.
          </p>
        </div>
        <div><OrgPricing onTheHouse={false} /></div>
      </div>
    </div>
  </section>

  <CtaBand
    layout="split"
    headline="Become a founding partner."
    body="A 20-minute call is enough to see whether ScamPrep fits your practice or institution, and how a pilot works."
    cta="Book a 20-minute call"
    href={partnerCall}
  />

  <!-- Sources for the stats quoted across this page — a quiet gray-on-ink
       strip between the CTA band and the footer, deliberately low-contrast
       so it reads as footer matter, not a section. -->
  <div class="sources-strip">
    <div class="wrap center">
      <p class="footnote">
        Sources: <a href="https://www.ic3.gov/AnnualReport/Reports/2025_IC3Report.pdf">FBI IC3 2025 Internet Crime Report</a> ·
        <a href="https://www.cerulli.com/press-releases/cerulli-anticipates-124-trillion-in-wealth-will-transfer-through-2048">Cerulli Associates</a>, on the great wealth transfer and heir retention
      </p>
    </div>
  </div>
</Base>

<style>
  .soln-hero { padding-bottom: 64px; }
  .soln-hero__title {
    font-size: clamp(1.9rem, 4.2vw, 3rem);
    max-width: 46rem;
    margin-inline: auto;
  }
  /* Inline single-line rotator: "ScamPrep for [word]" stays on one line; the word box
     grows/shrinks to fit each incoming audience, which floats up into place. */
  .rot {
    display: inline-block;
    position: relative;
    overflow: hidden;
    vertical-align: bottom;
    height: 1.3em;
    line-height: 1.3;
    white-space: nowrap;
    transition: width 0.45s cubic-bezier(0.22, 0.61, 0.36, 1);
  }
  .rot__inner {
    display: inline-block;
    color: var(--amber-deep);
    white-space: nowrap;
    will-change: transform, opacity;
  }

  .sr-only {
    position: absolute;
    width: 1px; height: 1px;
    padding: 0; margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  /* Why-practices stat band — same dots / ping / trace treatment as the
     homepage "Why now" band (micro-graphic CSS mirrored from index.astro). */
  .dots { display: flex; gap: 9px; align-items: center; }
  .dot { width: 12px; height: 12px; border-radius: 50%; border: 1.5px solid #b5b0a6; }
  .dot--on { background: var(--amber); border-color: var(--amber); }
  .stats--anim .dot--on { opacity: 0.25; }
  .stats--play .dot--on { animation: spryBlip 2.8s linear infinite; }
  .stats--play .dot--on:nth-child(2) { animation-delay: 0.25s; }
  .stats--play .dot--on:nth-child(3) { animation-delay: 0.5s; }
  .stats--play .dot--on:nth-child(4) { animation-delay: 0.75s; }
  .stats--play .dot--on:nth-child(5) { animation-delay: 1s; }
  .stats--play .dot--on:nth-child(6) { animation-delay: 1.25s; }
  .stats--play .dot--on:nth-child(7) { animation-delay: 1.5s; }

  .stat-line--ping { position: relative; }
  .loss-ping {
    position: absolute;
    left: 44px;
    top: 50%;
    width: 130px;
    height: 130px;
    margin: -65px 0 0 -65px;
    border-radius: 50%;
    border: 1.5px solid rgba(240, 161, 28, 0.8);
    opacity: 0;
    pointer-events: none;
  }
  .stats--play .loss-ping { animation: spryPing 2.7s cubic-bezier(0, 0, 0.2, 1) infinite; }
  .stats--play .loss-ping--2 { animation-delay: 1.35s; }
  .stat-line--ping .stat__num, .stat-line--ping .stat__label { position: relative; }

  .trace { display: block; width: 100%; }
  .stat__graphic .trace { max-width: 220px; height: 32px; }
  .trace__line {
    stroke: var(--amber);
    stroke-width: 2.5;
    stroke-linecap: round;
    stroke-dasharray: 600;
  }
  .trace--anim .trace__line { stroke-dashoffset: 600; }
  .trace--play .trace__line { animation: spryDash 3.8s ease-in-out forwards; }

  /* ---------- Report band. Inverted from the homepage's: the artifact is
     large and carries the co-branding as a letterhead; one loud tag above,
     the aggregate stat docked below. Copy sits in the margin. ---------- */
  .report-band {
    position: relative;
    display: grid;
    gap: 56px;
    align-items: center;
  }
  @media (min-width: 920px) {
    .report-band { grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.3fr); }
  }
  .report-band__stage { width: 100%; max-width: 600px; margin-inline: auto; }
  .report-band__stage :global(.report-wrap) { max-width: none; position: relative; z-index: 1; }

  /* Callout labels: mini-kickers joined by a dashed amber connector. */
  .annot__label {
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: var(--amber);
    margin: 0;
  }
  .annot__line {
    display: block;
    width: 1.5px;
    height: 18px;
    background: repeating-linear-gradient(to bottom, var(--amber) 0 3px, transparent 3px 6px);
    margin: 6px 0;
  }

  /* Loud tag above the card, aligned with the letterhead it points at. */
  .annot--top {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    margin-left: 28px;
  }
  .annot__label--lg { font-size: 0.95rem; letter-spacing: 0.11em; }

  /* Aggregate stat: chip overlapping the card's bottom-right corner. */
  .annot--stat {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    text-align: right;
    position: relative;
    z-index: 2;
  }
  .annot--stat .annot__line { margin-right: 24px; }
  .annot--stat .annot__label { margin-right: 24px; }
  .annot__chip {
    display: inline-flex;
    align-items: baseline;
    gap: 8px;
    margin: 0;
    background: var(--ink);
    border: 1px solid var(--ink-3);
    border-radius: var(--radius-ctrl);
    padding: 10px 14px;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--gray-400);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.35);
  }
  .annot__num {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.35rem;
    letter-spacing: -0.03em;
    line-height: 1;
    color: var(--paper-bg);
  }
  @media (min-width: 920px) {
    /* Dock the chip over the card corner on wide screens only. */
    .annot--stat { margin-right: -18px; margin-top: -22px; }
  }
  @media (max-width: 919px) {
    .annot--stat { margin-top: 14px; }
  }

  /* Left-column deliverable points: blip-marked, compact. */
  .deliv-list {
    list-style: none;
    padding: 0;
    margin: 20px 0 0;
    display: grid;
    gap: 14px;
  }
  .deliv-list li { position: relative; padding-left: 24px; }
  .deliv-list li::before {
    content: '';
    position: absolute;
    left: 4px;
    top: 0.55em;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--amber);
    box-shadow: 0 0 10px rgba(240, 161, 28, 0.55);
  }
  .deliv-list strong { color: var(--paper-bg); }
  .report-band__radar {
    left: -140px;
    bottom: -180px;
    width: 480px;
    height: 480px;
    background: repeating-radial-gradient(circle, transparent 0 35px, rgba(240, 161, 28, 0.14) 35px 36px);
  }
  /* The pulsing radar: a slow sweep over the rings, plus two blinking blips. */
  .report-band__sweep {
    background: conic-gradient(from 0deg, rgba(240, 161, 28, 0.16), transparent 90deg);
    animation: spryRot 10s linear infinite;
  }
  .report-band__blip {
    position: absolute;
    left: 96px;
    bottom: 120px;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--amber);
    animation: spryBlip 7s linear infinite;
    pointer-events: none;
  }
  .report-band__blip--2 {
    left: 210px;
    bottom: 48px;
    width: 6px;
    height: 6px;
    animation-delay: 3.5s;
  }

  /* ---------- Why-practices ledger: rule-separated entries, no card boxes,
     so the section reads differently from every grid on the page ---------- */
  .why-list {
    list-style: none;
    padding: 0;
    margin: 44px 0 0;
    display: grid;
    gap: 0 48px;
  }
  @media (min-width: 880px) {
    .why-list { grid-template-columns: 1fr 1fr; }
  }
  .why-list li { padding: 22px 0 24px; border-top: 1px solid var(--divider); }
  .why-list h3 {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 1.15rem;
    margin: 0 0 8px;
  }
  .why-list p { margin: 0; font-size: 1rem; color: var(--gray-700); }

  /* ---------- "Runs itself" reveal panels: titles first, detail on
     hover / tap / focus. Progressive: no JS = all panels open. ---------- */
  .runs { display: grid; gap: 14px; margin-top: 36px; }
  @media (min-width: 760px) {
    .runs { grid-template-columns: 1fr 1fr; align-items: start; }
    /* Reserve two title lines so a one-line title ("Clean on compliance")
       doesn't leave its panel shorter than its neighbors, closed or open. */
    .runs__title { min-height: 2.6em; }
  }
  @media (min-width: 1040px) { .runs { grid-template-columns: repeat(4, 1fr); } }
  .runs__panel {
    display: block;
    width: 100%;
    text-align: left;
    font-family: var(--font-body);
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 22px 22px 20px;
    cursor: pointer;
    transition: background 0.3s ease, border-color 0.25s ease;
  }
  .runs__panel:hover { border-color: var(--line-strong); }
  .runs__panel.is-open { background: var(--ink); border-color: var(--ink); }
  .runs__title {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 12px;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.08rem;
    letter-spacing: -0.01em;
    line-height: 1.3;
    color: var(--ink);
    transition: color 0.25s ease;
  }
  .runs__panel.is-open .runs__title { color: var(--paper-bg); }
  .runs__plus {
    flex: none;
    color: var(--amber);
    font-size: 1.35rem;
    font-weight: 400;
    line-height: 1;
    transition: transform 0.3s ease;
  }
  .runs__panel.is-open .runs__plus { transform: rotate(45deg); }
  /* Detail expands via the 0fr → 1fr grid trick (same as the home carousel). */
  .runs__body {
    display: grid;
    grid-template-rows: 1fr;
    transition: grid-template-rows 0.45s cubic-bezier(0.22, 0.61, 0.36, 1), opacity 0.3s ease 0.08s;
  }
  .runs__body > span {
    display: block;
    overflow: hidden;
    min-height: 0;
    font-size: 1rem;
    line-height: 1.55;
    color: var(--gray-700);
    transition: color 0.25s ease;
  }
  .runs__body > span::before { content: ''; display: block; height: 10px; }
  .runs--js .runs__panel:not(.is-open) .runs__body { grid-template-rows: 0fr; opacity: 0; }
  .runs__panel.is-open .runs__body > span { color: var(--gray-400); }

  .pilot-steps {
    list-style: none;
    counter-reset: pilot;
    padding: 0;
    margin: 36px 0 0;
    max-width: 46rem;
  }
  .pilot-steps li {
    counter-increment: pilot;
    position: relative;
    padding: 0 0 28px 64px;
  }
  /* Ghost ledger numerals — the numbered-circle rail already lives on the
     homepage carousel; this page doesn't repeat it. */
  .pilot-steps li::before {
    content: counter(pilot, decimal-leading-zero);
    position: absolute;
    left: 0;
    top: 0;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.5rem;
    line-height: 1.2;
    letter-spacing: -0.02em;
    color: var(--gray-400);
  }
  .pilot-steps h3 { margin: 0 0 6px; font-size: 1.15rem; }
  .pilot-steps p { margin: 0; color: var(--ink-soft); font-size: 1rem; }

  /* Pay models — ink/paper contrast pair, deliberately not bordered cards. */
  /* Payment models — amber-dot bullets under the pricing title, the light-
     surface twin of the report band's deliv-list. */
  .price-points {
    list-style: none;
    padding: 0;
    margin: 22px 0 0;
    display: grid;
    gap: 14px;
  }
  .price-points li { position: relative; padding-left: 24px; color: var(--gray-700); }
  .price-points li::before {
    content: '';
    position: absolute;
    left: 4px;
    top: 0.55em;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--amber);
  }
  .price-points strong { color: var(--ink); }
  .price-points__note {
    margin: 18px 0 0;
    font-size: 0.95rem;
    color: var(--gray-500);
  }
  .price-points__house {
    margin: 22px 0 0;
    padding-top: 18px;
    border-top: 1px solid var(--divider);
    font-size: 1rem;
    color: var(--gray-700);
  }
  .price-points__house strong { color: var(--ink); }

  /* Audience ledger — rule-separated entries mirroring .why-list. */
  .aud-list {
    list-style: none;
    padding: 0;
    margin: 36px 0 0;
    display: grid;
    gap: 0 48px;
  }
  @media (min-width: 880px) {
    .aud-list { grid-template-columns: repeat(3, 1fr); }
  }
  .aud-list li {
    padding: 22px 0 24px;
    border-top: 1px solid var(--divider);
    scroll-margin-top: 96px;
  }
  .aud-list h3 {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 1.15rem;
    margin: 0 0 8px;
  }
  .aud-list__hook {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.1rem;
    color: var(--ink);
    margin: 0 0 6px;
  }
  .aud-list p:last-child { margin: 0; font-size: 1rem; color: var(--gray-700); }

  /* ---------- Section openers — varied per section so no two sections start
     with the same kicker → h2 → lede stack. The two kickers that remain mark
     register changes: the hero and the ink deliverable band. ---------- */

  /* Partnerships: heading left, lede right on wide screens. */
  /* Advisor FAQ: sticky heading rail left, accordion right. */
  .faq-split { display: grid; gap: 28px 64px; align-items: start; }
  @media (min-width: 880px) {
    .faq-split { grid-template-columns: minmax(0, 1fr) minmax(0, 1.6fr); }
    .faq-split__rail { position: sticky; top: 96px; }
  }
  .faq-split__rail h2 { margin-bottom: 14px; }
  .faq-split__rail p { margin: 0; }

  /* Pilot: the timeline itself opens the section; the heading rides beside it. */
  .pilot-open { display: grid; gap: 0 64px; }
  .pilot-open h2 { margin-bottom: 0; }
  @media (min-width: 1040px) {
    .pilot-open { grid-template-columns: minmax(0, 46rem) minmax(0, 1fr); align-items: start; }
    .pilot-open h2 { grid-column: 2; grid-row: 1; margin-top: 6px; }
    .pilot-open .pilot-steps { grid-column: 1; grid-row: 1; margin-top: 0; }
  }

  /* Pricing: the interactive pricing card opens the section beside the heading. */
  .price-open { display: grid; gap: 28px 56px; text-align: left; }
  @media (min-width: 920px) {
    .price-open { grid-template-columns: minmax(0, 1fr) minmax(0, 620px); align-items: center; }
  }

  /* Final CTA (the page's second ink moment) gets the airy density step. */
  :global(section.cta-band) { padding: 128px 0; }

  /* Sources strip — ink surface continuous with the CTA band and footer;
     hairline divider above, muted gray text so it stays out of the way. */
  .sources-strip { background: var(--ink); }
  .sources-strip .footnote {
    margin: 0;
    padding: 20px 0 24px;
    border-top: 1px solid var(--ink-2);
    color: var(--gray-500);
  }
  .sources-strip .footnote a { color: var(--gray-400); }
</style>

<script>
  // Vertical audience rotator. Progressive + reduced-motion safe: without JS (or with
  // reduced-motion) the viewport simply shows the first audience, statically.
  const rot = document.getElementById('rot');
  const inner = document.getElementById('rot-inner');
  if (rot && inner) {
    const words = JSON.parse(rot.dataset.words || '[]');
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // Off-screen measurer so the word box can size to each incoming word — this keeps
    // "ScamPrep for" anchored while the box grows/shrinks around the new audience.
    const meas = document.createElement('span');
    const cs = getComputedStyle(inner);
    Object.assign(meas.style, {
      position: 'absolute', visibility: 'hidden', whiteSpace: 'nowrap', left: '-9999px', top: '0',
      fontFamily: cs.fontFamily, fontSize: cs.fontSize, fontWeight: cs.fontWeight,
      fontStyle: cs.fontStyle, letterSpacing: cs.letterSpacing,
    });
    document.body.appendChild(meas);
    const widthOf = (w) => { meas.textContent = w; return Math.ceil(meas.getBoundingClientRect().width) + 2; };
    const setWidth = (w) => { rot.style.width = widthOf(w) + 'px'; };

    setWidth(words[0] || inner.textContent);
    window.addEventListener('resize', () => {
      meas.style.fontSize = getComputedStyle(inner).fontSize;
      const prev = rot.style.transition;
      rot.style.transition = 'none';
      setWidth(inner.textContent);
      rot.getBoundingClientRect();
      rot.style.transition = prev;
    });

    if (!reduce && words.length > 1) {
      let i = 0;
      const DUR = 420;
      window.setInterval(() => {
        const next = words[(i + 1) % words.length];
        // Old word floats up and out; box width eases to the next word concurrently.
        inner.style.transition = 'transform ' + DUR + 'ms cubic-bezier(0.22,0.61,0.36,1), opacity ' + DUR + 'ms ease';
        inner.style.transform = 'translateY(-0.6em)';
        inner.style.opacity = '0';
        setWidth(next);
        window.setTimeout(() => {
          inner.textContent = next;
          inner.style.transition = 'none';
          inner.style.transform = 'translateY(0.6em)';
          inner.getBoundingClientRect(); // reflow before animating in
          inner.style.transition = 'transform ' + DUR + 'ms cubic-bezier(0.22,0.61,0.36,1), opacity ' + DUR + 'ms ease';
          inner.style.transform = 'translateY(0)';
          inner.style.opacity = '1';
          i = (i + 1) % words.length;
        }, DUR);
      }, 2000);
    }
  }

  // Why-practices stat band — count-up numbers plus the dot / ping / trace motifs,
  // armed and played on scroll into view (same behavior as the home "Why now" band).
  // Markup ships the final numbers, so no-JS and reduced-motion visitors see real values.
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const countEls = document.querySelectorAll('[data-countup]');

  const renderCount = (el, value) => {
    el.textContent = (el.dataset.prefix || '') + Math.round(value).toLocaleString('en-US') + (el.dataset.suffix || '');
  };
  const animateCount = (el) => {
    const target = parseFloat(el.dataset.target || '0');
    if (reduceMotion) { renderCount(el, target); return; }
    const duration = 1400;
    let startTime;
    const tick = (now) => {
      if (startTime === undefined) startTime = now;
      const progress = Math.min((now - startTime) / duration, 1);
      const eased = 1 - Math.pow(1 - progress, 3); // ease-out cubic
      renderCount(el, target * eased);
      if (progress < 1) requestAnimationFrame(tick);
    };
    requestAnimationFrame(tick);
  };

  if (countEls.length && 'IntersectionObserver' in window && !reduceMotion) {
    countEls.forEach((el) => renderCount(el, 0)); // zero out only once JS is confirmed running
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            animateCount(entry.target);
            io.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.35 }
    );
    countEls.forEach((el) => io.observe(el));
  }

  const band = document.getElementById('why-stats');
  if (band && 'IntersectionObserver' in window && !reduceMotion) {
    band.classList.add('stats--anim');
    const bandIo = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            band.classList.add('stats--play');
            bandIo.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.25 }
    );
    bandIo.observe(band);
  }

  // Trace motif — the line draws itself once, on scroll into view (same
  // behavior as the homepage trace).
  const traces = Array.from(document.querySelectorAll('.trace'));
  if (traces.length && 'IntersectionObserver' in window && !reduceMotion) {
    traces.forEach((t) => t.classList.add('trace--anim'));
    const traceIo = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('trace--play');
            traceIo.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.4 }
    );
    traces.forEach((t) => traceIo.observe(t));
  }

  // "Runs itself" panels — titles first; detail on hover (pointer devices),
  // tap (touch), or keyboard focus. Without JS all panels stay open.
  const runs = document.getElementById('runs');
  if (runs) {
    runs.classList.add('runs--js');
    const canHover = window.matchMedia('(hover: hover)').matches;
    const panels = Array.from(runs.querySelectorAll('.runs__panel'));
    const setOpen = (panel, open) => {
      panel.classList.toggle('is-open', open);
      panel.setAttribute('aria-expanded', open ? 'true' : 'false');
    };
    panels.forEach((panel) => {
      setOpen(panel, false);
      if (canHover) {
        panel.addEventListener('mouseenter', () => setOpen(panel, true));
        panel.addEventListener('mouseleave', () => setOpen(panel, false));
      }
      panel.addEventListener('focus', () => setOpen(panel, true));
      panel.addEventListener('blur', () => setOpen(panel, false));
      // Tap-to-toggle on touch; on hover devices click just pins the open state.
      panel.addEventListener('click', () => {
        if (!canHover) setOpen(panel, !panel.classList.contains('is-open'));
      });
    });
  }
</script>
