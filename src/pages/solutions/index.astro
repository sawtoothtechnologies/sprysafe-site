---
import Base from '../../layouts/Base.astro';
import CtaBand from '../../components/CtaBand.astro';
import OrgPricing from '../../components/OrgPricing.astro';
import ReportCard from '../../components/ReportCard.astro';
import Faq from '../../components/Faq.astro';

// The objections advisors raise on a first call, answered plainly.
const advisorFaqs = [
  {
    q: 'How will my clients react?',
    a: `<p>Clients are worried about this too, and the program is offered as a benefit, never an accusation. It's the same simulate-and-coach training Fortune 500 firms require of every employee, including the CEO. Every participant opts in personally, drills are gentle, and coaching is private. Catching a practice scam feels good, and the quarterly report shows them the proof.</p>`,
  },
  {
    q: 'What will our compliance team ask?',
    a: `<p>The usual questions have short answers:</p>
<ul>
  <li><strong>Account access:</strong> none. ScamPrep never touches money, accounts, or credentials.</li>
  <li><strong>Integrations and data feeds:</strong> none.</li>
  <li><strong>Data held:</strong> the contact channels a participant consents to; nothing financial.</li>
  <li><strong>Texts and calls:</strong> only with written consent, per the TCPA (enrollment starts with email).</li>
</ul>`,
  },
  {
    q: 'What happens when a client misses a drill?',
    a: `<p>When a client slips (as we all do!) they see or hear a private, 30-second, friendly lesson. No shame or public score. Recipients of the resilience report see the quarter's trend, not a &ldquo;gotcha&rdquo; log, and you see aggregates. The design follows published research on older-adult learning: positive framing, immediate reassurance, never fear.</p>`,
  },
  {
    q: 'Where does this sit with the Senior Safe Act and trusted-contact rules?',
    a: `<p>ScamPrep is not a compliance product and doesn't satisfy any legal requirements. But the regulatory direction is clear: the Senior Safe Act protects firms that train and report, and trusted-contact rules push firms to engage families <em>before</em> there's a problem. A prevention program with quarterly family touchpoints is exactly that posture, documented.</p>`,
  },
];

const partnerCall = 'https://cal.com/scamprep/partner-call';
---

<Base
  title="For Financial Advisors | ScamPrep"
  shareTitle="Scam practice for your clients"
  description="Help clients catch scams before money moves, with a white-labeled quarterly Resilience Report. Nothing for your staff to run, and no access to accounts."
>
  <!-- ============ HERO ============ -->
  <section class="section soln-hero">
    <div class="wrap center">
      <p class="kicker">For financial advisors</p>
      <h1 class="soln-hero__title">Defend your clients against scams and differentiate your practice.</h1>
      <p class="lede" style="margin-inline: auto;">
        Train clients to catch scams before money moves, protecting their financial well-being, defending your fees, and building a bridge to the next generation.
      </p>
      <div class="btn-row" style="justify-content: center; margin-top: 30px;">
        <a class="btn btn--primary" href={partnerCall}>Book a 20-minute call</a>
        <a class="btn btn--ghost" href="#pricing">See partner pricing</a>
      </div>
    </div>
  </section>

  <!-- ============ WHY PRACTICES (stat band + ledger) ============ -->
  <section class="section section--paper">
    <div class="wrap">
      <!-- The numbers open the section; heading follows them. Same three-up
           treatment as the homepage "Why now" band. -->
      <div class="stat-row" id="why-stats" style="margin-top: 0;">
        <!-- 7 in 10 — ten client households, seven lit (the ones that walk) -->
        <div class="stat-col">
          <div class="stat-line">
            <span class="stat__num">7 in 10</span>
            <p class="stat__label">heirs switch advisors after inheriting</p>
          </div>
          <div class="stat__graphic dots" aria-hidden="true">
            <span class="dot dot--on"></span><span class="dot dot--on"></span><span class="dot dot--on"></span>
            <span class="dot dot--on"></span><span class="dot dot--on"></span><span class="dot dot--on"></span>
            <span class="dot dot--on"></span>
            <span class="dot"></span><span class="dot"></span><span class="dot"></span>
          </div>
        </div>

        <!-- 12,000+ -->
        <div class="stat-col">
          <div class="stat-line">
            <span class="stat__num">12,000+</span>
            <p class="stat__label">people each lost $100k+ to fraud in 2025</p>
          </div>
        </div>

        <!-- $124T -->
        <div class="stat-col">
          <div class="stat-line">
            <span class="stat__num">$124T</span>
            <p class="stat__label">changing hands in the great wealth transfer</p>
          </div>
        </div>
      </div>

      <div style="margin-top: 48px;">
        <p class="kicker">Why practices run ScamPrep</p>
        <!-- max-width tuned so the line breaks in two on desktop; balance evens the split. -->
        <h2 style="max-width: 38rem;">One convincing phone call can undo a decade of careful planning.</h2>
      </div>

      <ul class="why-list">
        <li>
          <h3><span class="blip" aria-hidden="true"></span>Differentiate your practice from the pack</h3>
          <p>Demonstrate your unique value to clients. Show them, and their families, you have their holistic financial well-being in mind with scam defense training. No rate table or model portfolio says that.</p>
        </li>
        <li>
          <h3><span class="blip" aria-hidden="true"></span>Keep the assets through the wealth transfer</h3>
          <p>When assets pass to the next generation, the financial advisor usually doesn't. The Resilience Report puts your firm’s name in front of clients' adult children every quarter, associated with good news about their parent.</p>
        </li>
        <li>
          <h3><span class="blip" aria-hidden="true"></span>Scams threaten AUM</h3>
          <p>More than twelve thousand people reported losing $100k+ to fraud in 2025. Those are withdrawals no portfolio plans for. Trained clients lower the odds of unexpected loss to their portfolio and hits to your bottom line.</p>
        </li>
        <li>
          <h3><span class="blip" aria-hidden="true"></span>Stop the drain on your time</h3>
          <p>Talking clients out of scams, or supporting them through the fallout, can take days or weeks. Trained clients spare your practice those unforeseen costs.</p>
        </li>
      </ul>

    </div>
  </section>

  <!-- ============ THE DELIVERABLE (Resilience Report) ============ -->
  <section class="section section--band" id="report">
    <div class="wrap report-band">
      <div>
        <p class="kicker">The deliverable</p>
        <h2>A quarterly report with your name on it</h2>
        <p class="lede">
          Every three months your client and their chosen family members receive a one-page Resilience Report: what was practiced, what was caught, and what comes next.
        </p>
        <ul class="deliv-list">
          <li><strong>Good news, on a schedule.</strong> Most alerts arrive after something goes wrong. ScamPrep provides recurring proof they’re getting harder to fool.</li>
          <li><strong>Your name on every one.</strong> Each report is white-labeled with your firm and, if they choose, lands in the inboxes of the generation that inherits.</li>
          <li><strong>Your view stays aggregate.</strong> Participation, catch rates, and who might need a closer look.</li>
        </ul>
      </div>
      <div class="report-band__stage">
        <!-- Callout: the point of the artifact, planted above the letterhead. -->
        <div class="annot annot--top">
          <p class="annot__label annot__label--lg">Good news with your name on it every quarter</p>
          <span class="annot__line" aria-hidden="true"></span>
        </div>

        <!-- The card carries a fictional firm's letterhead: co-branding shown
             in the artifact, not described beside it. -->
        <ReportCard variant="full" tone="dark" cobrand />

        <!-- Callout: the aggregate stat, docked at the card's bottom corner. -->
        <div class="annot annot--stat">
          <p class="annot__chip">
            <span class="annot__num">92%</span>
            <span>practice-wide catch rate with 34 clients enrolled</span>
          </p>
          <span class="annot__line" aria-hidden="true"></span>
          <p class="annot__label">The stat your practice quotes</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ HOW PARTNERSHIPS WORK (reveal panels) ============ -->
  <section class="section">
    <div class="wrap">
      <h2>Simple to set up, runs on autopilot</h2>

      <!-- Titles show first; hover, tap, or tab into a panel for the detail.
           Without JS every panel renders open, so nothing is ever hidden. -->
      <div class="runs" id="runs">
        <button type="button" class="runs__panel" aria-expanded="true">
          <span class="runs__title">Folds into your tools and onboarding<span class="runs__plus" aria-hidden="true">+</span></span>
          <span class="runs__body"><span>Enrollment integrates simply into your client onboarding and takes two minutes to complete. Benefits compound from there. No CRM integration needed.</span></span>
        </button>
        <button type="button" class="runs__panel" aria-expanded="true">
          <span class="runs__title">Nothing for your staff to run<span class="runs__plus" aria-hidden="true">+</span></span>
          <span class="runs__body"><span>Scam drills, in-the-moment coaching, and briefings on the newest scams are all handled by ScamPrep. Your team is never in the alert loop.</span></span>
        </button>
        <button type="button" class="runs__panel" aria-expanded="true">
          <span class="runs__title">Clean on compliance<span class="runs__plus" aria-hidden="true">+</span></span>
          <span class="runs__body"><span>ScamPrep never touches money, accounts, or core systems. There’s no managing integrations, data feeds, or client credentials. Vendor review stays short.</span></span>
        </button>
      </div>

    </div>
  </section>

  <!-- ============ EVIDENCE STRIP ============ -->
  <section class="section--tight section">
    <div class="wrap center">
      <p class="lede" style="max-width: 48rem; margin-inline: auto;">
        A 2024 federal research review found one-time scam education fades within weeks. A University of Florida study showed performance on safe practice drills predicts real-world risk. ScamPrep uses the same simulate-coach-measure loop enterprise security teams have run for years.
        <a href="/why-it-works">Read the full case</a>
      </p>
    </div>
  </section>

  <!-- ============ ADVISOR FAQ ============ -->
  <section class="section--tight section section--paper">
    <div class="wrap faq-split">
      <div class="faq-split__rail">
        <h2>Questions advisors ask</h2>
        <p><a href="/faq">Read the full FAQ</a></p>
      </div>
      <div class="faq-split__list">
        <Faq items={advisorFaqs} />
      </div>
    </div>
  </section>

  <!-- ============ FOUNDING PILOT TIMELINE ============ -->
  <section class="section">
    <div class="wrap">
      <!-- Artifact-first: the timeline leads; the heading rides beside it on wide screens. -->
      <div class="pilot-open">
        <h2 style="max-width: 34rem;">What a founding pilot looks like</h2>
        <ol class="pilot-steps">
        <li>
          <h3>A 20-minute call</h3>
          <p>Discuss whether ScamPrep fits your clients, what a pilot includes, and discounted pricing (for after the pilot). No pitch, no obligation.</p>
        </li>
        <li>
          <h3>You select clients to enroll</h3>
          <p>We suggest enrolling every client, though you can also start with the clients who may benefit most.</p>
        </li>
        <li>
          <h3>We handle invitations and consent</h3>
          <p>Participants opt in personally, families get visibility if they choose, and nobody is monitored behind their back.</p>
        </li>
        <li>
          <h3>Drills begin within two weeks</h3>
          <p>You see your book's baseline catch rate in the first month. The first white-labeled Resilience Report lands at quarter's end, alongside your day-90 readout and founding pilot decision.</p>
        </li>
        </ol>
      </div>
    </div>
  </section>

  <!-- ============ PARTNER PRICING ============ -->
  <section class="section section--paper" id="pricing">
    <div class="wrap center">
      <!-- Artifact-first: the interactive pricing card beside the heading.
           The two payment models ride in the left column as amber-dot bullets
           (same grammar as the deliverable section's list), with the
           founding-pilot note and the on-the-house freebie beneath. -->
      <div class="price-open">
        <div>
          <h2>Simple, volume-based pricing</h2>
          <ul class="price-points">
            <li>
              <strong>Practice-sponsored.</strong> You cover enrollment for the clients you choose, at partner pricing.
            </li>
            <li>
              <strong>Practice-referred.</strong> Families pay for their own plan at a discounted rate. Your practice still gets the white-labeled Resilience Report.
            </li>
          </ul>
          <p class="price-points__note">
            Every founding pilot starts sponsored (90 days, a small roster), then you pick the
            model that fits.
          </p>
          <p class="price-points__house">
            <strong>On the house:</strong> every founding partner gets ScamPrep for their own
            family, free, so you can experience a drill before your clients do.
          </p>
        </div>
        <div><OrgPricing onTheHouse={false} /></div>
      </div>
    </div>
  </section>

  <CtaBand
    layout="split"
    headline="Become a founding partner."
    body="Book a 20-minute call to see whether ScamPrep fits your practice and get your pilot started."
    cta="Book a 20-minute call"
    href={partnerCall}
    note="Credit union, caregiving facility, wealth manager, or something else? Write to <a href='mailto:hello@getscamprep.com'>hello@getscamprep.com</a> and we'll talk."
  />

  <!-- Sources for the stats quoted across this page — a quiet gray-on-ink
       strip between the CTA band and the footer, deliberately low-contrast
       so it reads as footer matter, not a section. -->
  <div class="sources-strip">
    <div class="wrap center">
      <p class="footnote">
        Sources: <a href="https://www.ic3.gov/AnnualReport/Reports/2025_IC3Report.pdf">FBI IC3 2025 Internet Crime Report</a> ·
        <a href="https://www.cerulli.com/press-releases/cerulli-anticipates-124-trillion-in-wealth-will-transfer-through-2048">Cerulli Associates</a>, on the great wealth transfer and heir retention
      </p>
    </div>
  </div>
</Base>

<style>
  /* The middle stat (12,000+) is the widest number; give that column more room. */
  @media (min-width: 880px) { #why-stats { grid-template-columns: 0.9fr 1.25fr 0.85fr; } }

  .soln-hero { padding-bottom: 64px; }
  .soln-hero__title {
    font-size: clamp(1.9rem, 4.2vw, 3rem);
    max-width: 54rem;
    margin-inline: auto;
  }

  /* Solutions figures ("12,000+", "7 in 10") run wider than the homepage's
     ("71%", "$38k"), so label wrap counts can drift apart between columns.
     A uniform line-box keeps all three numbers and the dots/trace row on
     identical baselines at every width; balance evens the label lines. */
  @media (min-width: 880px) {
    #why-stats .stat-line { min-height: 92px; }
  }
  #why-stats .stat__label { text-wrap: balance; }

  /* Why-practices stat band — same dot treatment as the homepage "Why now"
     band (CSS mirrored from index.astro). */
  .dots { display: flex; gap: 9px; align-items: center; }
  .dot { width: 12px; height: 12px; border-radius: 50%; border: 1.5px solid #b5b0a6; }
  .dot--on { background: var(--amber); border-color: var(--amber); }
  .stats--anim .dot--on { opacity: 0.25; }
  /* The lit dots count up once, then stay lit. Nothing loops. */
  .stats--play .dot--on { animation: dotOn 0.45s ease-out both; }
  .stats--play .dot--on:nth-child(2) { animation-delay: 0.25s; }
  .stats--play .dot--on:nth-child(3) { animation-delay: 0.5s; }
  .stats--play .dot--on:nth-child(4) { animation-delay: 0.75s; }
  .stats--play .dot--on:nth-child(5) { animation-delay: 1s; }
  .stats--play .dot--on:nth-child(6) { animation-delay: 1.25s; }
  .stats--play .dot--on:nth-child(7) { animation-delay: 1.5s; }
  @keyframes dotOn { from { opacity: 0.25; transform: scale(0.7); } to { opacity: 1; transform: scale(1); } }

  /* ---------- Report band. Inverted from the homepage's: the artifact is
     large and carries the co-branding as a letterhead; one loud tag above,
     the aggregate stat docked below. Copy sits in the margin. ---------- */
  .report-band {
    position: relative;
    display: grid;
    gap: 56px;
    align-items: center;
  }
  @media (min-width: 920px) {
    .report-band { grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.3fr); }
  }
  .report-band__stage { width: 100%; max-width: 600px; margin-inline: auto; }
  .report-band__stage :global(.report-wrap) { max-width: none; position: relative; z-index: 1; }

  /* Callout labels: mini-kickers joined by a dashed amber connector. */
  .annot__label {
    font-size: 0.9375rem;
    font-weight: 700;
    line-height: 1.3;
    color: var(--amber-deep);
    margin: 0;
  }
  .annot__line {
    display: block;
    width: 1.5px;
    height: 18px;
    background: repeating-linear-gradient(to bottom, var(--amber-deep) 0 3px, transparent 3px 6px);
    margin: 6px 0;
  }

  /* Loud tag above the card, aligned with the letterhead it points at. */
  .annot--top {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    margin-left: 28px;
  }
  .annot__label--lg { font-size: 1.0625rem; }

  /* Aggregate stat: chip overlapping the card's bottom-right corner. */
  .annot--stat {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    text-align: right;
    position: relative;
    z-index: 2;
  }
  .annot--stat .annot__line { margin-right: 24px; }
  .annot--stat .annot__label { margin-right: 24px; }
  .annot__chip {
    display: inline-flex;
    align-items: baseline;
    gap: 8px;
    margin: 0;
    background: var(--white);
    border: 1.5px solid var(--ink);
    border-radius: var(--radius-ctrl);
    padding: 10px 14px;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--gray-700);
  }
  .annot__num {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.35rem;
    letter-spacing: -0.03em;
    line-height: 1;
    color: var(--ink);
  }
  @media (min-width: 920px) {
    /* Dock the chip over the card corner on wide screens only. */
    .annot--stat { margin-right: -18px; margin-top: -22px; }
  }
  @media (max-width: 919px) {
    .annot--stat { margin-top: 14px; }
  }

  /* Left-column deliverable points: blip-marked, compact. */
  .deliv-list {
    list-style: none;
    padding: 0;
    margin: 20px 0 0;
    display: grid;
    gap: 14px;
  }
  .deliv-list li { position: relative; padding-left: 24px; }
  .deliv-list li::before {
    content: '';
    position: absolute;
    left: 4px;
    top: 0.55em;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--amber);
    box-shadow: 0 0 0 3px rgba(240, 161, 28, 0.25);
  }
  .deliv-list strong { color: var(--ink); }
  /* ---------- Why-practices ledger: rule-separated entries, no card boxes,
     so the section reads differently from every grid on the page ---------- */
  .why-list {
    list-style: none;
    padding: 0;
    margin: 44px 0 0;
    display: grid;
    gap: 0 48px;
  }
  @media (min-width: 880px) {
    .why-list { grid-template-columns: 1fr 1fr; }
  }
  .why-list li { padding: 22px 0 24px; border-top: 1px solid var(--divider); }
  .why-list h3 {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 1.15rem;
    margin: 0 0 8px;
  }
  .why-list p { margin: 0; font-size: 1rem; color: var(--gray-700); }

  /* ---------- "Runs itself" reveal panels: titles first, detail on
     hover / tap / focus. Progressive: no JS = all panels open. ---------- */
  .runs { display: grid; gap: 14px; margin-top: 36px; }
  @media (min-width: 760px) {
    .runs { grid-template-columns: 1fr 1fr; align-items: start; }
    /* Reserve two title lines so a one-line title ("Clean on compliance")
       doesn't leave its panel shorter than its neighbors, closed or open. */
    .runs__title { min-height: 2.6em; }
  }
  @media (min-width: 1040px) { .runs { grid-template-columns: repeat(3, 1fr); } }
  .runs__panel {
    display: block;
    width: 100%;
    text-align: left;
    font-family: var(--font-body);
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 22px 22px 20px;
    cursor: pointer;
    transition: background 0.3s ease, border-color 0.25s ease;
  }
  .runs__panel:hover { border-color: var(--line-strong); }
  /* Open panel: lit, not inverted (same as the homepage steps). */
  .runs__panel.is-open { background: var(--glow); border-color: var(--amber); }
  .runs__title {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 12px;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.08rem;
    letter-spacing: -0.01em;
    line-height: 1.3;
    color: var(--ink);
    transition: color 0.25s ease;
  }
  .runs__plus {
    flex: none;
    color: var(--amber);
    font-size: 1.35rem;
    font-weight: 400;
    line-height: 1;
    transition: transform 0.3s ease;
  }
  .runs__panel.is-open .runs__plus { transform: rotate(45deg); }
  /* Detail expands via the 0fr → 1fr grid trick (same as the home carousel). */
  .runs__body {
    display: grid;
    grid-template-rows: 1fr;
    transition: grid-template-rows 0.45s cubic-bezier(0.22, 0.61, 0.36, 1), opacity 0.3s ease 0.08s;
  }
  .runs__body > span {
    display: block;
    overflow: hidden;
    min-height: 0;
    font-size: 1rem;
    line-height: 1.55;
    color: var(--gray-700);
    transition: color 0.25s ease;
  }
  .runs__body > span::before { content: ''; display: block; height: 10px; }
  .runs--js .runs__panel:not(.is-open) .runs__body { grid-template-rows: 0fr; opacity: 0; }

  .pilot-steps {
    list-style: none;
    counter-reset: pilot;
    padding: 0;
    margin: 36px 0 0;
    max-width: 46rem;
  }
  .pilot-steps li {
    counter-increment: pilot;
    position: relative;
    padding: 0 0 28px 64px;
  }
  /* Ghost ledger numerals — the numbered-circle rail already lives on the
     homepage carousel; this page doesn't repeat it. */
  .pilot-steps li::before {
    content: counter(pilot, decimal-leading-zero);
    position: absolute;
    left: 0;
    top: 0;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.5rem;
    line-height: 1.2;
    letter-spacing: -0.02em;
    color: var(--gray-400);
  }
  .pilot-steps h3 { margin: 0 0 6px; font-size: 1.15rem; }
  .pilot-steps p { margin: 0; color: var(--ink-soft); font-size: 1rem; }

  /* Pay models — ink/paper contrast pair, deliberately not bordered cards. */
  /* Payment models — amber-dot bullets under the pricing title, the light-
     surface twin of the report band's deliv-list. */
  .price-points {
    list-style: none;
    padding: 0;
    margin: 22px 0 0;
    display: grid;
    gap: 14px;
  }
  .price-points li { position: relative; padding-left: 24px; color: var(--gray-700); }
  .price-points li::before {
    content: '';
    position: absolute;
    left: 4px;
    top: 0.55em;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--amber);
  }
  .price-points strong { color: var(--ink); }
  .price-points__note {
    margin: 18px 0 0;
    font-size: 0.95rem;
    color: var(--gray-500);
  }
  .price-points__house {
    margin: 22px 0 0;
    padding-top: 18px;
    border-top: 1px solid var(--divider);
    font-size: 1rem;
    color: var(--gray-700);
  }
  .price-points__house strong { color: var(--ink); }

  /* Audience ledger — rule-separated entries mirroring .why-list. */
  .aud-list {
    list-style: none;
    padding: 0;
    margin: 36px 0 0;
    display: grid;
    gap: 0 48px;
  }
  @media (min-width: 880px) {
    .aud-list { grid-template-columns: repeat(3, 1fr); }
  }
  .aud-list li {
    padding: 22px 0 24px;
    border-top: 1px solid var(--divider);
    scroll-margin-top: 96px;
  }
  .aud-list h3 {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 1.15rem;
    margin: 0 0 8px;
  }
  .aud-list__hook {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.1rem;
    color: var(--ink);
    margin: 0 0 6px;
  }
  .aud-list p:last-child { margin: 0; font-size: 1rem; color: var(--gray-700); }

  /* ---------- Section openers — varied per section so no two sections start
     with the same kicker → h2 → lede stack. The two kickers that remain mark
     register changes: the hero and the ink deliverable band. ---------- */

  /* Partnerships: heading left, lede right on wide screens. */
  /* Advisor FAQ: sticky heading rail left, accordion right. */
  .faq-split { display: grid; gap: 28px 64px; align-items: start; }
  @media (min-width: 880px) {
    .faq-split { grid-template-columns: minmax(0, 1fr) minmax(0, 1.6fr); }
    .faq-split__rail { position: sticky; top: 96px; }
  }
  .faq-split__rail h2 { margin-bottom: 14px; }
  .faq-split__rail p { margin: 0; }

  /* Pilot: the timeline itself opens the section; the heading rides beside it. */
  .pilot-open { display: grid; gap: 0 64px; }
  .pilot-open h2 { margin-bottom: 0; }
  @media (min-width: 1040px) {
    .pilot-open { grid-template-columns: minmax(0, 46rem) minmax(0, 1fr); align-items: start; }
    .pilot-open h2 { grid-column: 2; grid-row: 1; margin-top: 6px; }
    .pilot-open .pilot-steps { grid-column: 1; grid-row: 1; margin-top: 0; }
  }

  /* Pricing: the interactive pricing card opens the section beside the heading. */
  .price-open { display: grid; gap: 28px 56px; text-align: left; }
  @media (min-width: 920px) {
    .price-open { grid-template-columns: minmax(0, 1fr) minmax(0, 620px); align-items: center; }
  }

  /* Final CTA band gets a little more air than a standard section. */
  :global(section.cta-band) { padding: 104px 0; }

  /* Sources strip — ink surface continuous with the CTA band and footer;
     hairline divider above, muted gray text so it stays out of the way. */
  .sources-strip { background: var(--ink); }
  .sources-strip .footnote {
    margin: 0;
    padding: 20px 0 24px;
    border-top: 1px solid var(--ink-2);
    color: var(--gray-400);
  }
  .sources-strip .footnote a { color: var(--gray-400); }
</style>

<script>
  // Why-practices stat band — the dot pictograph is armed and played on scroll
  // into view (same behavior as the home "Why now" band). Markup ships the
  // final state, so no-JS and reduced-motion visitors see everything.
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const band = document.getElementById('why-stats');
  if (band && 'IntersectionObserver' in window && !reduceMotion) {
    band.classList.add('stats--anim');
    const bandIo = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            band.classList.add('stats--play');
            bandIo.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.25 }
    );
    bandIo.observe(band);
  }

  // "Runs itself" panels — titles first; detail on hover (pointer devices),
  // tap (touch), or keyboard focus. Without JS all panels stay open.
  const runs = document.getElementById('runs');
  if (runs) {
    runs.classList.add('runs--js');
    const canHover = window.matchMedia('(hover: hover)').matches;
    const panels = Array.from(runs.querySelectorAll('.runs__panel'));
    const setOpen = (panel, open) => {
      panel.classList.toggle('is-open', open);
      panel.setAttribute('aria-expanded', open ? 'true' : 'false');
    };
    panels.forEach((panel) => {
      setOpen(panel, false);
      if (canHover) {
        panel.addEventListener('mouseenter', () => setOpen(panel, true));
        panel.addEventListener('mouseleave', () => setOpen(panel, false));
      }
      // Keyboard focus opens a panel. Focus from a tap or click does not:
      // Android focuses a button on tap, and opening on that focus let the
      // click below toggle the panel straight back shut.
      panel.addEventListener('focus', () => {
        if (panel.matches(':focus-visible')) setOpen(panel, true);
      });
      panel.addEventListener('blur', () => {
        if (!(canHover && panel.matches(':hover'))) setOpen(panel, false);
      });
      // Tap-to-toggle on touch; on hover devices the hover already opened it.
      panel.addEventListener('click', () => {
        if (!canHover) setOpen(panel, !panel.classList.contains('is-open'));
      });
    });
  }
</script>
