---
import Base from '../../layouts/Base.astro';
import CtaBand from '../../components/CtaBand.astro';
import OrgPricing from '../../components/OrgPricing.astro';
import ReportCard from '../../components/ReportCard.astro';
import Faq from '../../components/Faq.astro';

// The objections advisors raise on a first call, answered plainly.
const advisorFaqs = [
  {
    q: 'How will my clients react?',
    a: `<p>Better than you'd guess — framing does the work, and you control it. This is the same simulate-and-coach training Fortune 500 firms require of every employee, including the CEO. It's offered as a benefit, never an accusation: every participant opts in personally, drills are gentle, and coaching is private. Sharp clients tend to enjoy catching them.</p>`,
  },
  {
    q: 'What will our compliance team ask?',
    a: `<p>The usual questions have short answers:</p>
<ul>
  <li><strong>Account access:</strong> none — ScamPrep never touches money, accounts, or credentials.</li>
  <li><strong>Integrations and data feeds:</strong> none.</li>
  <li><strong>Data held:</strong> the contact channels a participant consents to — nothing financial.</li>
  <li><strong>Texts and calls:</strong> only with written consent, per the TCPA. Enrollment starts with email.</li>
</ul>
<p>There's very little surface to review.</p>`,
  },
  {
    q: 'What happens when a client misses a drill?',
    a: `<p>A private, 30-second, friendly lesson in the moment — no shame, no public score. The family sees the month's trend, not a gotcha log, and you see aggregates. The design follows published research on older-adult learning: positive framing, immediate reassurance, never fear.</p>`,
  },
  {
    q: 'Where does this sit with the Senior Safe Act and trusted-contact rules?',
    a: `<p>ScamPrep is not a compliance product and doesn't claim to satisfy any rule. But the regulatory direction is clear: the Senior Safe Act protects firms that train and report, and trusted-contact rules push firms to engage families <em>before</em> there's a problem. A documented prevention program with monthly family touchpoints is exactly that posture — on paper.</p>`,
  },
];

// Audience order matches the rotating hero. Financial institutions lead (top row);
// each has an anchor id for deep links.
const audiences = [
  {
    id: 'financial-advisors',
    name: 'Financial advisors',
    hook: 'Protect the person, not just the portfolio.',
    body: 'You can diversify away market risk — not one convincing phone call. ScamPrep trains your older clients to catch scams before money moves, and shows their families the progress every month.',
  },
  {
    id: 'credit-unions',
    name: 'Credit unions',
    hook: 'Protect the member, not just the account.',
    body: 'Every scammed member costs you twice — drained deposits, then the fraud-ops hours and the shaken trust. ScamPrep works upstream of transaction monitoring, training members to hang up before anything moves. Nothing for branch staff to run.',
  },
  {
    id: 'wealth-advisors',
    name: 'Wealth advisors',
    hook: 'The bridge to the next generation.',
    body: 'Estate plans assume the money is still there when it transfers. ScamPrep protects the balance sheet you plan around — and gives the heirs a reason to know your firm before the estate settles.',
  },
  {
    id: 'home-care',
    name: 'Home-care agencies',
    hook: 'The safety add-on client families thank you for.',
    body: "You're already the trusted safety layer in your clients' lives. ScamPrep extends that trust to the threat that arrives by phone — a co-branded protection families value, with zero clinical burden on caregivers.",
  },
  {
    id: 'senior-living',
    name: 'Senior-living communities',
    hook: "The move-in differentiator down the street can't claim.",
    body: 'Every community sells the same amenities. ScamPrep lets you sell what families actually lose sleep over — and prove it every month with a family report and a community stat worth putting in the tour brochure.',
  },
  {
    id: 'banks',
    name: 'Community banks',
    hook: 'Protect the customer, not just the balance.',
    body: 'Fraud alerts catch some of it — after it starts. ScamPrep trains the customer themselves to stop the scam before money leaves, co-branded to your bank. Reduce losses, keep deposits, and earn loyalty across generations.',
  },
];

const rotatorItems = [
  'financial advisors',
  'credit unions',
  'wealth advisors',
  'home care',
  'senior living',
  'community banks',
];
const partnerCall = 'https://cal.com/scamprep/partner-call';
---

<Base
  title="ScamPrep for Financial Advisors, Credit Unions & Wealth Managers"
  description="One provable scam-resilience program for the organizations families trust — financial advisors, credit unions, wealth managers, community banks, home-care agencies, and senior-living communities. Co-branded monthly Resilience Report, nothing for staff to run, never touches accounts. Founding-partner pilots open."
>
  <!-- ============ HERO (rotating audience) ============ -->
  <section class="section soln-hero">
    <div class="wrap center">
      <p class="kicker">For organizations</p>
      <h1 class="soln-hero__title">
        <span aria-hidden="true">ScamPrep for <span class="rot" id="rot" data-words={JSON.stringify(rotatorItems)}><span class="rot__inner" id="rot-inner">{rotatorItems[0]}</span></span></span>
        <span class="sr-only">ScamPrep for financial advisors, credit unions, wealth advisors, home care, senior living, and community banks.</span>
      </h1>
      <p class="lede" style="margin-inline: auto;">
        If you serve older adults, ScamPrep gives you a <em>provable</em> answer to the question every
        family is quietly asking: will you keep the person I love safe?
      </p>
      <div class="btn-row" style="justify-content: center; margin-top: 30px;">
        <a class="btn btn--primary" href={partnerCall}>Book a 20-minute call</a>
        <a class="btn btn--ghost" href="#pricing">See partner pricing</a>
      </div>
    </div>
  </section>

  <!-- ============ WHY PRACTICES (stat band + ledger) ============ -->
  <section class="section section--paper">
    <div class="wrap">
      <p class="kicker">For advisory practices</p>
      <h2 style="max-width: 34rem;">Why practices run ScamPrep</h2>
      <p class="lede">
        One convincing phone call can undo a decade of careful planning — and the fallout lands
        on the practice, not just the client.
      </p>

      <div class="stat-row" id="why-stats">
        <!-- $38k — ping rings behind the number -->
        <div class="stat-col">
          <div class="stat-line stat-line--ping">
            <span class="loss-ping" aria-hidden="true"></span>
            <span class="loss-ping loss-ping--2" aria-hidden="true"></span>
            <span class="stat__num" data-countup data-target="38" data-prefix="$" data-suffix="k">$38k</span>
            <p class="stat__label">average reported senior-fraud loss</p>
          </div>
        </div>

        <!-- $124T — handoff arc: wealth passing from one generation (gray dot) to
             the next (amber dot), drawn left to right. Deliberately distinct from
             the home page's rising data trace. -->
        <div class="stat-col">
          <div class="stat-line">
            <span class="stat__num" data-countup data-target="124" data-prefix="$" data-suffix="T">$124T</span>
            <p class="stat__label">changing hands by 2048 in the great wealth transfer</p>
          </div>
          <div class="stat__graphic" aria-hidden="true">
            <svg class="trace" viewBox="0 0 220 32" preserveAspectRatio="none">
              <circle cx="7" cy="26" r="3.5" fill="#a3a09a" />
              <path class="trace__line" d="M7 26 C 60 2, 160 2, 213 26" fill="none" pathLength="600" />
              <circle cx="213" cy="26" r="3.5" fill="#f0a11c" />
              <circle cx="213" cy="26" r="7.5" fill="none" stroke="rgba(240, 161, 28, 0.4)" stroke-width="1.5" />
            </svg>
          </div>
        </div>

        <!-- 7 in 10 — ten dots, seven lit -->
        <div class="stat-col">
          <div class="stat-line">
            <span class="stat__num" data-countup data-target="7" data-suffix=" in 10">7 in 10</span>
            <p class="stat__label">heirs switch advisors after inheriting</p>
          </div>
          <div class="stat__graphic dots" aria-hidden="true">
            <span class="dot dot--on"></span><span class="dot dot--on"></span><span class="dot dot--on"></span>
            <span class="dot dot--on"></span><span class="dot dot--on"></span><span class="dot dot--on"></span>
            <span class="dot dot--on"></span>
            <span class="dot"></span><span class="dot"></span><span class="dot"></span>
          </div>
        </div>
      </div>

      <ul class="why-list">
        <li>
          <h3><span class="blip" aria-hidden="true"></span>Keep the assets through the wealth transfer</h3>
          <p>When assets pass on to heirs, the financial advisor usually doesn't. The Resilience Report puts your name in front of clients' adult children every month, associated with good news about their parent.</p>
        </li>
        <li>
          <h3><span class="blip" aria-hidden="true"></span>A scam is an AUM event</h3>
          <p>More than twelve thousand people each lost $100k+ to fraud in 2025 — and that's just what was reported. Those are withdrawals no portfolio plans for, and sometimes the greater cost is the family conversation after. Trained clients lower the odds of both.</p>
        </li>
        <li>
          <h3><span class="blip" aria-hidden="true"></span>Differentiation that takes one sentence</h3>
          <p>“We train our clients against scams — and show their families the progress.” No rate table, model portfolio, or planning tool says that.</p>
        </li>
        <li>
          <h3><span class="blip" aria-hidden="true"></span>Fewer fire drills of the bad kind</h3>
          <p>Talking clients out of scams, or supporting them through the fallout, can take days or weeks. Trained clients spare your practice those unforeseen costs.</p>
        </li>
      </ul>

      <p class="lede" style="margin-top: 28px; max-width: 44rem;">
        Preventing a single loss pays for years of the program.
      </p>
      <p class="footnote" style="margin-top: 14px;">
        Sources: <a href="https://www.ic3.gov/AnnualReport/Reports/2025_IC3Report.pdf">FBI IC3 2025 Internet Crime Report</a> ·
        <a href="https://www.cerulli.com/press-releases/cerulli-anticipates-124-trillion-in-wealth-will-transfer-through-2048">Cerulli Associates</a>, on the great wealth transfer and heir retention
      </p>
    </div>
  </section>

  <!-- ============ THE DELIVERABLE (Resilience Report) ============ -->
  <section class="section section--ink" id="report">
    <div class="radar-rings report-band__radar" aria-hidden="true"></div>
    <div class="wrap report-band">
      <div>
        <p class="kicker">The deliverable</p>
        <h2>A monthly report with your name on it</h2>
        <p class="lede">
          Every month, the family members each client chooses receive a one-page Resilience
          Report — what was practiced, what was caught, what's being reinforced next —
          co-branded to your firm.
        </p>
        <p class="lede" style="margin-top: 14px;">
          Monitoring tools message families when something bad may have happened. This is the
          opposite: recurring proof that their parent is getting harder to fool — and it
          arrives with your name on it, in the inboxes of the generation that inherits.
          Your practice sees the aggregate view: participation, catch rates, and who might
          need a closer look.
        </p>
      </div>
      <div class="report-band__card">
        <ReportCard variant="full" tone="dark" />
      </div>
    </div>
  </section>

  <!-- ============ HOW PARTNERSHIPS WORK (reveal panels) ============ -->
  <section class="section">
    <div class="wrap">
      <p class="kicker">How partnerships work</p>
      <h2 style="max-width: 34rem;">One program, built to run itself</h2>
      <p class="lede">Four commitments to your operations.</p>

      <!-- Titles show first; hover, tap, or tab into a panel for the detail.
           Without JS every panel renders open, so nothing is ever hidden. -->
      <div class="runs" id="runs">
        <button type="button" class="runs__panel" aria-expanded="true">
          <span class="runs__title">Folds into your onboarding<span class="runs__plus" aria-hidden="true">+</span></span>
          <span class="runs__body"><span>Enrollment and consent ride along with your existing client-onboarding, membership, or move-in flow. We screen for cognitive fit together — appropriate participants only.</span></span>
        </button>
        <button type="button" class="runs__panel" aria-expanded="true">
          <span class="runs__title">Nothing for your staff to run<span class="runs__plus" aria-hidden="true">+</span></span>
          <span class="runs__body"><span>Email-first drills, in-the-moment coaching, and briefings on the newest scams are all handled by ScamPrep. Your team is never in the alert loop.</span></span>
        </button>
        <button type="button" class="runs__panel" aria-expanded="true">
          <span class="runs__title">A co-branded monthly touchpoint<span class="runs__plus" aria-hidden="true">+</span></span>
          <span class="runs__body"><span>The Resilience Report reaches the family members each client chooses — a recurring, co-branded bridge to the next generation.</span></span>
        </button>
        <button type="button" class="runs__panel" aria-expanded="true">
          <span class="runs__title">Clean on compliance<span class="runs__plus" aria-hidden="true">+</span></span>
          <span class="runs__body"><span>ScamPrep never touches money, accounts, or core systems — no integrations, no data feeds, no client credentials. Vendor review stays short.</span></span>
        </button>
      </div>

    </div>
  </section>

  <!-- ============ AUDIENCE GRID ============ -->
  <section class="section section--paper">
    <div class="wrap">
      <p class="kicker">Who it's for</p>
      <h2 style="max-width: 34rem;">Built for the people families already trust</h2>
      <div class="grid grid--3" style="margin-top: 36px;">
        {audiences.map((a) => (
          <div class="card aud-card" id={a.id}>
            <h3>{a.name}</h3>
            <p class="aud-card__hook">{a.hook}</p>
            <p>{a.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ EVIDENCE STRIP ============ -->
  <section class="section--tight section">
    <div class="wrap center">
      <p class="kicker">The evidence</p>
      <p class="lede" style="max-width: 48rem; margin-inline: auto;">
        A 2024 federal research review found one-time scam education fades within weeks — and
        called training that <em>simulates</em> scams “promising.” A University of Florida study
        found performance on safe practice drills predicts real-world risk. It's the same
        simulate-coach-measure loop enterprise security teams have run for years.
        <a href="/why-it-works">Read the full case →</a>
      </p>
    </div>
  </section>

  <!-- ============ ADVISOR FAQ ============ -->
  <section class="section section--paper">
    <div class="wrap" style="max-width: 800px;">
      <h2 class="center">Questions advisors ask</h2>
      <div style="margin-top: 32px;">
        <Faq items={advisorFaqs} />
      </div>
      <p class="center" style="margin-top: 26px;"><a href="/faq">Read the full FAQ →</a></p>
    </div>
  </section>

  <!-- ============ FOUNDING PILOT TIMELINE ============ -->
  <section class="section">
    <div class="wrap">
      <p class="kicker">Founding pilots</p>
      <h2 style="max-width: 34rem;">What a founding pilot looks like</h2>
      <ol class="pilot-steps">
        <li>
          <h3>A 20-minute call</h3>
          <p>Whether ScamPrep fits your clients, what a pilot includes, and pricing. No pitch, no obligation.</p>
        </li>
        <li>
          <h3>You select clients to enroll</h3>
          <p>You know who's a fit — we screen for cognitive appropriateness together.</p>
        </li>
        <li>
          <h3>We handle invitations and consent — nothing for your staff</h3>
          <p>Participants opt in personally, families get visibility, and nobody is monitored behind their back. Oversight without overreach.</p>
        </li>
        <li>
          <h3>Drills begin within two weeks</h3>
          <p>You see your book's baseline catch rate in the first month. Co-branded Resilience Reports monthly, then a day-90 readout and your decision.</p>
        </li>
      </ol>
    </div>
  </section>

  <!-- ============ PARTNER PRICING ============ -->
  <section class="section section--paper" id="pricing">
    <div class="wrap center">
      <p class="kicker">Partner pricing</p>
      <h2>Simple, volume-based pricing</h2>

      <div class="grid grid--2 paymodels" style="margin-top: 36px;">
        <div class="card">
          <h3>Practice-sponsored</h3>
          <p>You cover enrollment for the clients you choose, at the partner pricing below. Reads as client appreciation — and you control the roster.</p>
        </div>
        <div class="card">
          <h3>Client-referred</h3>
          <p>Families pay for their own plan; your practice still gets the co-branded Resilience Report and the aggregate stat.</p>
        </div>
      </div>
      <p class="paymodels__note">
        Every founding pilot starts sponsored — 90 days, a small roster — then you pick the model that fits.
      </p>

      <div style="margin-top: 32px;">
        <OrgPricing />
      </div>
    </div>
  </section>

  <CtaBand
    headline="Become a founding partner."
    body="A 20-minute call is enough to see whether ScamPrep fits your practice, institution, agency, or community — and how a pilot works."
    cta="Book a 20-minute call"
    href={partnerCall}
  />
</Base>

<style>
  .soln-hero { padding-bottom: 64px; }
  .soln-hero__title {
    font-size: clamp(1.9rem, 4.2vw, 3rem);
    max-width: 46rem;
    margin-inline: auto;
  }
  /* Inline single-line rotator: "ScamPrep for [word]" stays on one line; the word box
     grows/shrinks to fit each incoming audience, which floats up into place. */
  .rot {
    display: inline-block;
    position: relative;
    overflow: hidden;
    vertical-align: bottom;
    height: 1.3em;
    line-height: 1.3;
    white-space: nowrap;
    transition: width 0.45s cubic-bezier(0.22, 0.61, 0.36, 1);
  }
  .rot__inner {
    display: inline-block;
    color: var(--amber-deep);
    white-space: nowrap;
    will-change: transform, opacity;
  }

  .sr-only {
    position: absolute;
    width: 1px; height: 1px;
    padding: 0; margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  /* ---------- Why-practices stat band (mirrors the home "Why now" motifs:
     ping = event, trace = data, dots = pictograph) ---------- */
  .dots { display: flex; gap: 9px; align-items: center; }
  .dot { width: 12px; height: 12px; border-radius: 50%; border: 1.5px solid #b5b0a6; }
  .dot--on { background: var(--amber); border-color: var(--amber); }
  .stats--anim .dot--on { opacity: 0.25; }
  .stats--play .dot--on { animation: spryBlip 2.8s linear infinite; }
  .stats--play .dot--on:nth-child(2) { animation-delay: 0.2s; }
  .stats--play .dot--on:nth-child(3) { animation-delay: 0.4s; }
  .stats--play .dot--on:nth-child(4) { animation-delay: 0.6s; }
  .stats--play .dot--on:nth-child(5) { animation-delay: 0.8s; }
  .stats--play .dot--on:nth-child(6) { animation-delay: 1s; }
  .stats--play .dot--on:nth-child(7) { animation-delay: 1.2s; }
  .stats--play .dot--on:nth-child(8) { animation-delay: 1.4s; }
  .stats--play .dot--on:nth-child(9) { animation-delay: 1.6s; }

  .stat-line--ping { position: relative; }
  .loss-ping {
    position: absolute;
    left: 44px;
    top: 50%;
    width: 130px;
    height: 130px;
    margin: -65px 0 0 -65px;
    border-radius: 50%;
    border: 1.5px solid rgba(240, 161, 28, 0.8);
    opacity: 0;
    pointer-events: none;
  }
  .stats--play .loss-ping { animation: spryPing 2.7s cubic-bezier(0, 0, 0.2, 1) infinite; }
  .stats--play .loss-ping--2 { animation-delay: 1.35s; }
  .stat-line--ping .stat__num, .stat-line--ping .stat__label { position: relative; }

  .trace { display: block; width: 100%; }
  .stat__graphic .trace { max-width: 220px; height: 32px; }
  .trace__line {
    stroke: var(--amber);
    stroke-width: 2.5;
    stroke-linecap: round;
    stroke-dasharray: 600;
  }
  .trace--anim .trace__line { stroke-dashoffset: 600; }
  .trace--play .trace__line { animation: spryDash 3.8s ease-in-out forwards; }

  /* ---------- Report band (mirrors the home report section's ink treatment) ---------- */
  .report-band {
    position: relative;
    display: grid;
    gap: 56px;
    align-items: center;
  }
  @media (min-width: 920px) {
    .report-band { grid-template-columns: 1.15fr 1fr; }
  }
  .report-band__card { display: flex; justify-content: center; }
  .report-band__radar {
    left: -140px;
    bottom: -180px;
    width: 480px;
    height: 480px;
    background: repeating-radial-gradient(circle, transparent 0 35px, rgba(240, 161, 28, 0.14) 35px 36px);
  }

  /* ---------- Why-practices ledger: rule-separated entries, no card boxes,
     so the section reads differently from every grid on the page ---------- */
  .why-list {
    list-style: none;
    padding: 0;
    margin: 44px 0 0;
    display: grid;
    gap: 0 48px;
  }
  @media (min-width: 880px) {
    .why-list { grid-template-columns: 1fr 1fr; }
  }
  .why-list li { padding: 22px 0 24px; border-top: 1px solid var(--divider); }
  .why-list h3 {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 1.15rem;
    margin: 0 0 8px;
  }
  .why-list p { margin: 0; font-size: 1rem; color: var(--gray-700); }

  /* ---------- "Runs itself" reveal panels: titles first, detail on
     hover / tap / focus. Progressive: no JS = all panels open. ---------- */
  .runs { display: grid; gap: 14px; margin-top: 36px; }
  @media (min-width: 760px) { .runs { grid-template-columns: 1fr 1fr; align-items: start; } }
  @media (min-width: 1040px) { .runs { grid-template-columns: repeat(4, 1fr); } }
  .runs__panel {
    display: block;
    width: 100%;
    text-align: left;
    font-family: var(--font-body);
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 22px 22px 20px;
    cursor: pointer;
    transition: background 0.3s ease, border-color 0.25s ease;
  }
  .runs__panel:hover { border-color: var(--line-strong); }
  .runs__panel.is-open { background: var(--ink); border-color: var(--ink); }
  .runs__title {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 12px;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.08rem;
    letter-spacing: -0.01em;
    line-height: 1.3;
    color: var(--ink);
    transition: color 0.25s ease;
  }
  .runs__panel.is-open .runs__title { color: var(--paper-bg); }
  .runs__plus {
    flex: none;
    color: var(--amber);
    font-size: 1.35rem;
    font-weight: 400;
    line-height: 1;
    transition: transform 0.3s ease;
  }
  .runs__panel.is-open .runs__plus { transform: rotate(45deg); }
  /* Detail expands via the 0fr → 1fr grid trick (same as the home carousel). */
  .runs__body {
    display: grid;
    grid-template-rows: 1fr;
    transition: grid-template-rows 0.45s cubic-bezier(0.22, 0.61, 0.36, 1), opacity 0.3s ease 0.08s;
  }
  .runs__body > span {
    display: block;
    overflow: hidden;
    min-height: 0;
    font-size: 0.95rem;
    line-height: 1.55;
    color: var(--gray-700);
    transition: color 0.25s ease;
  }
  .runs__body > span::before { content: ''; display: block; height: 10px; }
  .runs--js .runs__panel:not(.is-open) .runs__body { grid-template-rows: 0fr; opacity: 0; }
  .runs__panel.is-open .runs__body > span { color: var(--gray-400); }

  .pilot-steps {
    list-style: none;
    counter-reset: pilot;
    padding: 0;
    margin: 36px 0 0;
    max-width: 46rem;
  }
  .pilot-steps li {
    counter-increment: pilot;
    position: relative;
    padding: 0 0 28px 64px;
  }
  .pilot-steps li::before {
    content: counter(pilot);
    position: absolute;
    left: 0;
    top: -2px;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    border: 2px solid var(--ink);
    display: grid;
    place-items: center;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.05rem;
  }
  .pilot-steps li:not(:last-child)::after {
    content: '';
    position: absolute;
    left: 19px;
    top: 44px;
    bottom: 2px;
    width: 2px;
    background: var(--line);
  }
  .pilot-steps h3 { margin: 0 0 6px; font-size: 1.15rem; }
  .pilot-steps p { margin: 0; color: var(--ink-soft); font-size: 1rem; }

  .paymodels { text-align: left; max-width: 880px; margin-inline: auto; }
  .paymodels__note {
    color: var(--ink-soft);
    font-size: 0.98rem;
    margin: 18px auto 0;
    max-width: 44rem;
  }

  .aud-card { scroll-margin-top: 96px; }
  .aud-card__hook {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.1rem;
    color: var(--pine);
    margin-bottom: 0.5em;
  }
  .aud-card p:last-child { margin-bottom: 0; font-size: 1rem; color: var(--ink-soft); }
</style>

<script>
  // Vertical audience rotator. Progressive + reduced-motion safe: without JS (or with
  // reduced-motion) the viewport simply shows the first audience, statically.
  const rot = document.getElementById('rot');
  const inner = document.getElementById('rot-inner');
  if (rot && inner) {
    const words = JSON.parse(rot.dataset.words || '[]');
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // Off-screen measurer so the word box can size to each incoming word — this keeps
    // "ScamPrep for" anchored while the box grows/shrinks around the new audience.
    const meas = document.createElement('span');
    const cs = getComputedStyle(inner);
    Object.assign(meas.style, {
      position: 'absolute', visibility: 'hidden', whiteSpace: 'nowrap', left: '-9999px', top: '0',
      fontFamily: cs.fontFamily, fontSize: cs.fontSize, fontWeight: cs.fontWeight,
      fontStyle: cs.fontStyle, letterSpacing: cs.letterSpacing,
    });
    document.body.appendChild(meas);
    const widthOf = (w) => { meas.textContent = w; return Math.ceil(meas.getBoundingClientRect().width) + 2; };
    const setWidth = (w) => { rot.style.width = widthOf(w) + 'px'; };

    setWidth(words[0] || inner.textContent);
    window.addEventListener('resize', () => {
      meas.style.fontSize = getComputedStyle(inner).fontSize;
      const prev = rot.style.transition;
      rot.style.transition = 'none';
      setWidth(inner.textContent);
      rot.getBoundingClientRect();
      rot.style.transition = prev;
    });

    if (!reduce && words.length > 1) {
      let i = 0;
      const DUR = 420;
      window.setInterval(() => {
        const next = words[(i + 1) % words.length];
        // Old word floats up and out; box width eases to the next word concurrently.
        inner.style.transition = 'transform ' + DUR + 'ms cubic-bezier(0.22,0.61,0.36,1), opacity ' + DUR + 'ms ease';
        inner.style.transform = 'translateY(-0.6em)';
        inner.style.opacity = '0';
        setWidth(next);
        window.setTimeout(() => {
          inner.textContent = next;
          inner.style.transition = 'none';
          inner.style.transform = 'translateY(0.6em)';
          inner.getBoundingClientRect(); // reflow before animating in
          inner.style.transition = 'transform ' + DUR + 'ms cubic-bezier(0.22,0.61,0.36,1), opacity ' + DUR + 'ms ease';
          inner.style.transform = 'translateY(0)';
          inner.style.opacity = '1';
          i = (i + 1) % words.length;
        }, DUR);
      }, 2000);
    }
  }

  // Why-practices stat band — count-up numbers plus the dot / ping / trace motifs,
  // armed and played on scroll into view (same behavior as the home "Why now" band).
  // Markup ships the final numbers, so no-JS and reduced-motion visitors see real values.
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const countEls = document.querySelectorAll('[data-countup]');

  const renderCount = (el, value) => {
    el.textContent = (el.dataset.prefix || '') + Math.round(value).toLocaleString('en-US') + (el.dataset.suffix || '');
  };
  const animateCount = (el) => {
    const target = parseFloat(el.dataset.target || '0');
    if (reduceMotion) { renderCount(el, target); return; }
    const duration = 1400;
    let startTime;
    const tick = (now) => {
      if (startTime === undefined) startTime = now;
      const progress = Math.min((now - startTime) / duration, 1);
      const eased = 1 - Math.pow(1 - progress, 3); // ease-out cubic
      renderCount(el, target * eased);
      if (progress < 1) requestAnimationFrame(tick);
    };
    requestAnimationFrame(tick);
  };

  if (countEls.length && 'IntersectionObserver' in window && !reduceMotion) {
    countEls.forEach((el) => renderCount(el, 0)); // zero out only once JS is confirmed running
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            animateCount(entry.target);
            io.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.35 }
    );
    countEls.forEach((el) => io.observe(el));
  }

  const band = document.getElementById('why-stats');
  if (band && 'IntersectionObserver' in window && !reduceMotion) {
    band.classList.add('stats--anim');
    const bandIo = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            band.classList.add('stats--play');
            bandIo.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.25 }
    );
    bandIo.observe(band);
  }

  const traces = Array.from(document.querySelectorAll('.trace'));
  if (traces.length && 'IntersectionObserver' in window && !reduceMotion) {
    traces.forEach((t) => t.classList.add('trace--anim'));
    const traceIo = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('trace--play');
            traceIo.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.4 }
    );
    traces.forEach((t) => traceIo.observe(t));
  }

  // "Runs itself" panels — titles first; detail on hover (pointer devices),
  // tap (touch), or keyboard focus. Without JS all panels stay open.
  const runs = document.getElementById('runs');
  if (runs) {
    runs.classList.add('runs--js');
    const canHover = window.matchMedia('(hover: hover)').matches;
    const panels = Array.from(runs.querySelectorAll('.runs__panel'));
    const setOpen = (panel, open) => {
      panel.classList.toggle('is-open', open);
      panel.setAttribute('aria-expanded', open ? 'true' : 'false');
    };
    panels.forEach((panel) => {
      setOpen(panel, false);
      if (canHover) {
        panel.addEventListener('mouseenter', () => setOpen(panel, true));
        panel.addEventListener('mouseleave', () => setOpen(panel, false));
      }
      panel.addEventListener('focus', () => setOpen(panel, true));
      panel.addEventListener('blur', () => setOpen(panel, false));
      // Tap-to-toggle on touch; on hover devices click just pins the open state.
      panel.addEventListener('click', () => {
        if (!canHover) setOpen(panel, !panel.classList.contains('is-open'));
      });
    });
  }
</script>
