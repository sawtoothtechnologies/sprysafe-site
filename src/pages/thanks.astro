---
import Base from '../layouts/Base.astro';

// Stay in touch confirmation. The /stay-in-touch form redirects here after a
// successful submission. When Stripe checkout goes live, give checkout its own
// /welcome page with trial copy rather than reusing this one (see STRIPE-SETUP.md).
// Kept out of search: noindex here, and filtered from the sitemap in astro.config.mjs.
---

<Base
  title="Thanks, We'll Be in Touch | ScamPrep"
  description="You're on the ScamPrep list. Here's what happens next."
  noindex
>
  <section class="section">
    <div class="wrap center" style="max-width: 640px;">
      <svg width="64" height="64" viewBox="10 10 76 76" fill="none" aria-hidden="true" style="margin-bottom: 20px;">
        <path d="M 57.02 19.39 A 30 30 0 1 0 76.61 38.98" stroke="#121110" stroke-width="8.5" stroke-linecap="round" />
        <circle cx="48" cy="48" r="11" fill="#f0a11c" />
      </svg>
      <h1>Thanks, we'll be in touch.</h1>
      <p class="lede" style="margin-inline: auto;">
        You're on the list. We'll send the occasional note on what's new at ScamPrep, and
        nothing else.
      </p>
      <p style="margin-top: 28px;">
        <a class="btn btn--primary" href="/pricing">See plans</a>
      </p>
      <p class="thanks__questions">
        Questions? <a href="mailto:hello@getscamprep.com">hello@getscamprep.com</a>
      </p>
    </div>
  </section>
</Base>

<style>
  .thanks__questions { margin: 22px 0 0; font-size: 1rem; color: var(--ink-soft); }
  .thanks__questions a { color: var(--ink); text-decoration: underline; text-underline-offset: 3px; }
</style>
