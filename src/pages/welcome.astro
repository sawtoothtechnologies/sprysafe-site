---
import Base from '../layouts/Base.astro';

// Post-checkout page. Each Stripe Payment Link redirects here after a successful
// payment: /welcome?plan=individual|pairs|family&session_id={CHECKOUT_SESSION_ID}.
// Monthly and annual share a URL. "couples" (the old site key) is read as pairs.
// The page only knows the plan, not the amount, so it never shows a price.
// The session ID ties the submission to the Stripe payment. A visit without one
// (for example from a link in an email) asks for the buyer's email instead, and
// leaves out the "payment received" check, since nothing confirms a payment.
//
// FORM BACKEND: Formspree, the separate post-purchase form (ID mbggyean, created
// October 28, 2026). The Stay in touch form (/stay-in-touch) is moeajjvb; keep them apart
// so enrollment details never mix with signups. Keep reCAPTCHA OFF: the page submits
// with fetch and a captcha would silently block it.
// Kept out of search: noindex here, and filtered from the sitemap in astro.config.mjs.
// Decisions behind this page: ~/ScamPrep/product/decisions.md, "/welcome page shape".
const FORM_ACTION = 'https://formspree.io/f/mbggyean';
---

<Base
  title="Welcome | ScamPrep"
  description="Finish setting up ScamPrep. Tell us who's enrolling, and we'll email each person a short invite to say yes."
  noindex
>
  <section class="section welcome">
    <div class="wrap welcome__wrap">
      <div class="paid" id="paid" hidden>
        <svg class="paid__icon" viewBox="0 0 48 48" width="48" height="48" aria-hidden="true">
          <circle class="paid__circle" cx="24" cy="24" r="24" />
          <path class="paid__check" d="M15 24.5l6 6 12-13" />
        </svg>
      </div>
      <p class="kicker" id="kicker">Welcome to ScamPrep</p>
      <h1 id="heading" tabindex="-1">One last step: add your recipients</h1>
      <p class="lede" id="intro">
        Tell us who's enrolling, and we'll email each person an invite. Nothing
        starts until they say yes.
      </p>

      <div id="setup">
        <form class="form-card welcome__form" id="welcome-form" method="POST" action={FORM_ACTION} novalidate>
          <input type="hidden" name="_subject" id="subject" value="New ScamPrep enrollment" />
          <input type="hidden" name="form" value="welcome" />
          <input type="hidden" name="plan" id="plan" value="" />
          <input type="hidden" name="session_id" id="session_id" value="" />

          <div class="field" id="buyer-email-field" hidden>
            <label for="buyer_email">Your email <span class="hint">(the one you paid with)</span></label>
            <input type="email" id="buyer_email" name="buyer_email" autocomplete="email" required />
            <p class="field-note field-note--quiet">This lets us match these details to your plan.</p>
          </div>

          <h2 class="welcome__h2">Recipients</h2>
          <div id="people"></div>

          <div class="add-row" id="add-row">
            <button type="button" class="btn btn--ghost add-btn" id="add-person">
              <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true"><path d="M10 4.5v11M4.5 10h11" /></svg>
              Add another recipient
            </button>
          </div>
          <p class="field-note field-note--quiet" id="later-note" hidden>
            Don't have everyone's details on hand right now? Share what you have, and email
            <a href="mailto:hello@getscamprep.com">hello@getscamprep.com</a> to add someone later.
          </p>
          <hr class="section-rule" />

          <label class="checkbox heads-up" id="heads-up" for="wait_a_day">
            <input type="checkbox" name="wait_a_day" value="Yes" id="wait_a_day" />
            <span class="heads-up__text">Wait a day before sending their invitations so I can give them a&nbsp;heads&#8209;up.</span>
          </label>

          <details class="tailor" id="tailor">
            <summary class="tailor__summary">
              <span class="tailor__title">Help us tailor the practice</span>
              <span class="tailor__opt">Optional</span>
              <svg class="chev" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M6 9l6 6 6-6" /></svg>
            </summary>
            <div class="tailor__body">
              <div class="field">
                <label for="worries">Which kinds of scams worry you most?</label>
                <textarea id="worries" name="worries" rows="3" placeholder="For example, fake delivery texts or calls that claim to be from the bank"></textarea>
              </div>
              <div class="field">
                <label for="recent">Has anything happened recently that we should know about?</label>
                <textarea id="recent" name="recent" rows="3" placeholder="Please leave out bank names, account details, and health information"></textarea>
              </div>
            </div>
          </details>

          <button class="btn btn--primary welcome__submit" type="submit" id="submit">Finish setup</button>
          <p class="form-error" id="form-error" role="alert" hidden></p>
        </form>
        <p class="footnote welcome__privacy">
          We use these details strictly to run ScamPrep for the people you list.
          Read our <a href="/privacy">privacy policy</a> and <a href="/promise">promise</a>.
        </p>
      </div>

      <div id="done" hidden>
        <div class="card talking-points" id="talking-points">
          <h2 class="welcome__h2">Optional: give them a heads-up</h2>
          <p>ScamPrep lands best when you introduce it first. Here's a starting point:</p>
          <label class="sr-only" for="message">Message to send</label>
          <textarea id="message" rows="6"></textarea>
          <p class="field-note field-note--quiet">You can edit the message before you copy or send it.</p>
          <div class="btn-row">
            <button type="button" class="btn btn--primary" id="copy-message">Copy message</button>
            <a class="btn btn--ghost" id="text-message" href="sms:">Send as a text</a>
          </div>
          <p class="field-note" id="copy-status" role="status"></p>
        </div>

        <div class="card next-steps">
          <h2 class="welcome__h2">What happens next</h2>
          <ol class="next-list">
            <li id="next-invite"><strong>Each person gets an invite</strong> from hello@getscamprep.com. Nothing starts until they say yes, and we'll email you when they do.</li>
            <li id="next-noyes"><strong>If someone hasn't said yes within a week,</strong> we'll let you know. After 21 days, we'll refund you for anyone who hasn't accepted.</li>
            <li id="next-practice"><strong>Practice begins</strong> with a short scam briefing a few days after they say yes, followed by 4 to 6 drills a month through their chosen channels: email, text, or phone. Drills arrive on no set schedule.</li>
            <li id="next-report"><strong>Every three months,</strong> each person gets a Resilience Report showing what they've caught, and you get a copy if they choose to share it.</li>
          </ol>
          <p class="field-note field-note--quiet next-billing">
            Your receipt email has your billing details and a link to manage your plan. Charges
            show on your statement as SCAMPREP. Cancel within 60 days for a full refund.
          </p>
        </div>

        <p class="welcome__contact">
          Questions or feedback? <a href="mailto:hello@getscamprep.com">hello@getscamprep.com</a>
        </p>
      </div>
    </div>
  </section>

  <template id="person-template">
    <fieldset class="person is-open">
      <legend class="person__legend">
        <button type="button" class="person__toggle" aria-expanded="true">
          <span class="person__title">Recipient 1</span>
          <span class="person__summary"></span>
          <svg class="chev" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M6 9l6 6 6-6" /></svg>
        </button>
      </legend>
      <div class="person__body">
        <div class="name-row">
          <div class="field">
            <label data-for="first">First name</label>
            <input type="text" data-name="first" autocomplete="off" required />
          </div>
          <div class="field">
            <label data-for="last">Last name</label>
            <input type="text" data-name="last" autocomplete="off" required />
          </div>
        </div>
        <div class="field">
          <div class="label-row">
            <label data-for="email">Email</label>
            <span class="info">
              <button type="button" class="info__btn" aria-expanded="false" aria-label="Why we ask for an email"><svg viewBox="0 0 20 20" width="20" height="20" aria-hidden="true"><circle cx="10" cy="10" r="8.5" /><path d="M10 9v5" /><circle class="dot" cx="10" cy="6" r="1.1" /></svg></button>
              <span class="info__tip" role="tooltip" data-tip="email">We'll send the invite here, so use an address they check.</span>
            </span>
          </div>
          <input type="email" data-name="email" autocomplete="off" required />
        </div>
        <div class="field">
          <div class="label-row">
            <label data-for="cell">Cell phone <span class="hint">(recommended)</span></label>
            <span class="info">
              <button type="button" class="info__btn" aria-expanded="false" aria-label="Why we recommend a cell phone"><svg viewBox="0 0 20 20" width="20" height="20" aria-hidden="true"><circle cx="10" cy="10" r="8.5" /><path d="M10 9v5" /><circle class="dot" cx="10" cy="6" r="1.1" /></svg></button>
              <span class="info__tip" role="tooltip" data-tip="cell">Half of each month's practice comes by text and phone call. Without a cell number, practice is email only.</span>
            </span>
          </div>
          <input type="tel" data-name="cell" autocomplete="off" />
        </div>
        <div class="field">
          <label data-for="relationship">Relationship to you</label>
          <select data-name="relationship" required>
            <option value="">Choose one</option>
            <option value="Myself">Myself</option>
            <option>Parent</option>
            <option>Grandparent</option>
            <option>Spouse or partner</option>
            <option>Other family</option>
            <option>Friend</option>
          </select>
        </div>
        <button type="button" class="person__remove">
          <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true"><path d="M3.5 5.5h13M8 5.5V4a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1v1.5M5.5 5.5l.8 10.6a1 1 0 0 0 1 .9h5.4a1 1 0 0 0 1-.9l.8-10.6M8.5 8.5v5.5M11.5 8.5v5.5" /></svg>
          Remove recipient
        </button>
      </div>
    </fieldset>
  </template>
</Base>

<script>
  const PLANS: Record<string, { name: string; max: number; covers: string }> = {
    individual: { name: 'Individual', max: 1, covers: 'one person' },
    pairs: { name: 'Pairs', max: 2, covers: 'up to two people' },
    family: { name: 'Family', max: 4, covers: 'up to four people' },
  };
  const query = new URLSearchParams(location.search);
  let planKey = (query.get('plan') || '').toLowerCase();
  if (planKey === 'couples') planKey = 'pairs';
  const plan = PLANS[planKey];
  const max = plan ? plan.max : 4;
  const sessionId = query.get('session_id') || '';

  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
  const form = $<HTMLFormElement>('welcome-form');
  const people = $('people');
  const template = $<HTMLTemplateElement>('person-template');
  const addBtn = $<HTMLButtonElement>('add-person');
  const addRow = $('add-row');
  const laterNote = $('later-note');
  const headsUp = $('heads-up');
  const waitBox = $<HTMLInputElement>('wait_a_day');
  const errorEl = $('form-error');

  $<HTMLInputElement>('plan').value = plan ? planKey : (query.get('plan') || '');
  $<HTMLInputElement>('session_id').value = sessionId;
  $<HTMLInputElement>('subject').value = plan ? `New ScamPrep enrollment (${plan.name})` : 'New ScamPrep enrollment';

  if (plan) {
    $('intro').textContent = plan.max > 1
      ? `Your ${plan.name} plan covers ${plan.covers}. Tell us who's enrolling, and we'll email each person an invite. Nothing starts until they say yes.`
      : `Your ${plan.name} plan covers ${plan.covers}. Tell us who's enrolling, and we'll email them an invite. Nothing starts until they say yes.`;
  }
  // Stripe only sends buyers here after a successful payment, so a session ID
  // means the payment went through. Without one, there's nothing to confirm.
  if (sessionId) {
    $<HTMLInputElement>('buyer_email').required = false;
    $('paid').hidden = false;
    $('kicker').textContent = 'Payment received';
  } else {
    $('buyer-email-field').hidden = false;
  }

  const cards = () => Array.from(people.querySelectorAll<HTMLFieldSetElement>('fieldset.person'));
  const relationships = () => cards().map((c) => (c.querySelector('select') as HTMLSelectElement).value);
  const allMyself = () => relationships().every((r) => r === 'Myself');
  const valueOf = (card: HTMLElement, name: string) =>
    ((card.querySelector(`[data-name="${name}"]`) as HTMLInputElement | HTMLSelectElement).value || '').trim();

  // Collapsed cards show a one-line summary, like a checkout's finished steps.
  const summarize = (card: HTMLElement) => {
    const name = [valueOf(card, 'first'), valueOf(card, 'last')].filter(Boolean).join(' ');
    const rel = valueOf(card, 'relationship');
    const parts = [name, rel].filter(Boolean);
    (card.querySelector('.person__summary') as HTMLElement).textContent = parts.length ? parts.join(' · ') : 'Not filled in yet';
  };
  const setOpen = (card: HTMLElement, open: boolean) => {
    card.classList.toggle('is-open', open);
    (card.querySelector('.person__toggle') as HTMLElement).setAttribute('aria-expanded', String(open));
    summarize(card);
  };
  const openOnly = (card: HTMLElement) => cards().forEach((c) => setOpen(c, c === card));

  // Name and number every card in order, so the email reads person_1_name, person_2_name...
  const renumber = () => {
    const list = cards();
    list.forEach((card, i) => {
      const n = i + 1;
      (card.querySelector('.person__title') as HTMLElement).textContent = list.length > 1 ? `Recipient ${n}` : 'Recipient';
      (card.querySelector('.person__remove') as HTMLElement).hidden = list.length === 1;
      card.classList.toggle('is-single', list.length === 1);
      const body = card.querySelector('.person__body') as HTMLElement;
      body.id = `person_${n}_body`;
      (card.querySelector('.person__toggle') as HTMLElement).setAttribute('aria-controls', body.id);
      card.querySelectorAll<HTMLInputElement | HTMLSelectElement>('[data-name]').forEach((el) => {
        const id = `person_${n}_${el.dataset.name}`;
        el.id = id;
        el.name = id;
      });
      card.querySelectorAll<HTMLLabelElement>('label[data-for]').forEach((l) => {
        l.htmlFor = `person_${n}_${l.dataset.for}`;
      });
      card.querySelectorAll<HTMLElement>('[data-tip]').forEach((t) => {
        t.id = `person_${n}_${t.dataset.tip}_tip`;
        card.querySelector(`[data-name="${t.dataset.tip}"]`)?.setAttribute('aria-describedby', t.id);
      });
    });
    if (list.length === 1) setOpen(list[0], true);
    addRow.hidden = list.length >= max;
    // Once every slot on the plan is filled, the "add someone later" note has nothing to offer.
    laterNote.hidden = max === 1 || list.length >= max;
    update();
  };

  // The heads-up box only makes sense when someone other than the buyer is enrolling.
  const update = () => {
    const self = allMyself() && relationships().every((r) => r !== '');
    headsUp.hidden = self;
    if (self) waitBox.checked = false;
  };

  const addPerson = (focus: boolean) => {
    if (cards().length >= max) return;
    const card = (template.content.firstElementChild as HTMLElement).cloneNode(true) as HTMLFieldSetElement;
    card.querySelector('.person__remove')!.addEventListener('click', () => {
      const list = cards();
      const i = list.indexOf(card);
      card.remove();
      renumber();
      const rest = cards();
      if (rest.length) openOnly(rest[Math.max(0, i - 1)]);
    });
    card.querySelector('.person__toggle')!.addEventListener('click', () => {
      if (cards().length === 1) return;
      if (card.classList.contains('is-open')) setOpen(card, false);
      else openOnly(card);
    });
    card.querySelector('select')!.addEventListener('change', update);
    people.appendChild(card);
    renumber();
    openOnly(card);
    if (focus) (card.querySelector('input') as HTMLInputElement).focus();
  };
  addPerson(false);
  // On arrival, the first recipient card's warm light fades up once and holds,
  // drawing the eye to the form. The class comes off when it finishes, so the
  // card's normal open and closed styles take over from there.
  const firstCard = cards()[0];
  firstCard.classList.add('intro-glow');
  firstCard.addEventListener('animationend', () => firstCard.classList.remove('intro-glow'), { once: true });
  addBtn.addEventListener('click', () => addPerson(true));

  // Info icons: hover shows the tip on a mouse; a tap or click toggles it, so it
  // works on phones too. Tapping elsewhere or pressing Escape closes it.
  const closeTips = (except?: Element) =>
    document.querySelectorAll('.info__btn[aria-expanded="true"]').forEach((b) => {
      if (b !== except) b.setAttribute('aria-expanded', 'false');
    });
  document.addEventListener('click', (e) => {
    const btn = (e.target as Element).closest('.info__btn');
    closeTips(btn || undefined);
    if (btn) btn.setAttribute('aria-expanded', String(btn.getAttribute('aria-expanded') !== 'true'));
  });
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeTips(); });

  // Plain-language checks, shown in one place, instead of the browser's own bubbles.
  // A problem inside a collapsed recipient opens that recipient.
  const validate = (): string | null => {
    form.querySelectorAll('.field-error').forEach((el) => el.classList.remove('field-error'));
    const required = Array.from(form.querySelectorAll<HTMLInputElement | HTMLSelectElement>('[required]'))
      .filter((el) => !(el.closest('[hidden]')));
    let first: HTMLElement | null = null;
    let message = '';
    for (const el of required) {
      const v = el.value.trim();
      const badEmail = el.type === 'email' && v && !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(v);
      if (!v || badEmail) {
        el.classList.add('field-error');
        if (!first) {
          first = el;
          message = badEmail ? 'One of the email addresses doesn\'t look right. Please check it.' : 'A few required details are missing. They\'re outlined above.';
        }
      }
    }
    const myselfCount = relationships().filter((r) => r === 'Myself').length;
    if (!first && myselfCount > 1) message = 'Only one recipient can be "Myself." Please check the relationships.';
    if (first) {
      const card = first.closest('fieldset.person') as HTMLElement | null;
      if (card) openOnly(card);
      first.focus();
    }
    return message || null;
  };

  const showError = (message: string, contact = true) => {
    errorEl.innerHTML = message + (contact ? ' If it keeps happening, email <a href="mailto:hello@getscamprep.com">hello@getscamprep.com</a> and we\'ll set things up for you.' : '');
    errorEl.hidden = false;
    errorEl.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
  };

  const send = async (data: FormData) => {
    const ctl = new AbortController();
    const timer = setTimeout(() => ctl.abort(), 15000);
    try {
      return await fetch(form.action, { method: 'POST', body: data, headers: { Accept: 'application/json' }, signal: ctl.signal });
    } finally {
      clearTimeout(timer);
    }
  };

  // "John", "John and Jane", "John, Jane, and Mary" (serial comma from three names on).
  const joinNames = (names: string[]) =>
    names.length <= 2 ? names.join(' and ') : names.slice(0, -1).join(', ') + ', and ' + names[names.length - 1];

  const showDone = () => {
    const list = cards().map((c) => ({ name: valueOf(c, 'first'), self: valueOf(c, 'relationship') === 'Myself' }));
    const others = list.filter((p) => !p.self).map((p) => p.name);
    const hasSelf = list.some((p) => p.self);
    const who = joinNames([...(hasSelf ? ['you'] : []), ...others]);
    const invites = list.length > 1 ? 'invites' : 'an invite';
    const from = 'from hello@getscamprep.com';
    let text: string;
    if (!others.length) {
      text = `We'll email you an invite shortly ${from}.`;
    } else if (waitBox.checked && hasSelf) {
      text = `We'll email you an invite shortly, then wait a day before emailing ${joinNames(others)}. Invites come ${from}.`;
    } else if (waitBox.checked) {
      text = `We'll wait a day, then email ${who} ${invites} ${from}.`;
    } else {
      text = `We'll email ${who} ${invites} shortly ${from}.`;
    }
    // Heads-up message, addressed to everyone else on the form by first name.
    if (others.length) {
      $<HTMLTextAreaElement>('message').value = headsUpMessage(joinNames(others));
      syncText();
    }
    // Someone enrolling only themselves gets next steps written to them.
    if (!others.length) {
      $('next-invite').innerHTML = '<strong>Your invite comes</strong> from hello@getscamprep.com. Nothing starts until you say yes.';
      $('next-noyes').hidden = true;
      $('next-practice').innerHTML = '<strong>Practice begins</strong> with a short scam briefing a few days after you say yes, followed by 4 to 6 drills a month through your chosen channels: email, text, or phone. Drills arrive on no set schedule.';
      $('next-report').innerHTML = '<strong>Every three months,</strong> you get a Resilience Report showing what you\'ve caught.';
    }
    // One other person: singular wording, so the steps don't read as if there were a crowd.
    if (others.length === 1 && !hasSelf) {
      $('next-invite').innerHTML = '<strong>They get an invite</strong> from hello@getscamprep.com. Nothing starts until they say yes, and we\'ll email you when they do.';
      $('next-noyes').innerHTML = '<strong>If they haven\'t said yes within a week,</strong> we\'ll let you know. If they haven\'t accepted after 21 days, we\'ll refund you in full.';
      $('next-practice').innerHTML = '<strong>Practice begins</strong> with a short scam briefing a few days after they say yes, followed by 4 to 6 drills a month through their chosen channels: email, text, or phone. Drills arrive on no set schedule.';
      $('next-report').innerHTML = '<strong>Every three months,</strong> they get a Resilience Report showing what they\'ve caught, and you get a copy if they choose to share it.';
    }
    $('kicker').textContent = "You're all set";
    $('heading').textContent = "Thanks, that's everything we need";
    $('intro').textContent = text;
    $('talking-points').hidden = !others.length;
    $('paid').hidden = true;
    $('setup').hidden = true;
    $('done').hidden = false;
    window.scrollTo({ top: 0 });
    $('heading').focus({ preventScroll: true });
  };

  // Heads-up message: editable, then copy it or open the phone's messages app with it filled in.
  const headsUpMessage = (names: string) =>
    `Hi ${names}, I thought you might like ScamPrep. It sends practice scam messages and short alerts to help you spot scams. ` +
    `You'll get an invitation from hello@getscamprep.com. It's your choice to accept your invite, and nothing starts unless you say yes. ` +
    `Here's how it works: getscamprep.com/what-to-expect`;
  const messageBox = $<HTMLTextAreaElement>('message');
  const syncText = () => {
    $<HTMLAnchorElement>('text-message').href = 'sms:?&body=' + encodeURIComponent(messageBox.value.trim());
  };
  messageBox.addEventListener('input', syncText);
  $('copy-message').addEventListener('click', async () => {
    const status = $('copy-status');
    try {
      await navigator.clipboard.writeText(messageBox.value.trim());
      status.textContent = 'Copied. Paste it into a text or email.';
    } catch {
      messageBox.select();
      status.textContent = 'Selected. Copy it with your keyboard or a long press.';
    }
  });

  let sending = false;
  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (sending) return;
    errorEl.hidden = true;
    const problem = validate();
    if (problem) { showError(problem, false); return; }
    sending = true;
    const btn = $<HTMLButtonElement>('submit');
    btn.disabled = true;
    btn.textContent = 'Sending…';
    const data = new FormData(form);
    for (const [k, v] of Array.from(data.entries())) {
      if (typeof v === 'string' && !v.trim()) data.delete(k);
    }
    data.set('wait_a_day', waitBox.checked && !headsUp.hidden ? 'Yes' : 'No');
    data.set('people_count', String(cards().length));
    let res: Response | null = null;
    try {
      res = await send(data);
      if (res.status >= 500) throw new Error(String(res.status));
    } catch {
      await new Promise((r) => setTimeout(r, 1500));
      try { res = await send(data); } catch { res = null; }
    }
    if (res && res.ok) { showDone(); return; }
    sending = false;
    btn.disabled = false;
    btn.textContent = 'Finish setup';
    if (res && res.status >= 400 && res.status < 500) {
      showError('That didn\'t go through. Please check the email addresses and try again.');
    } else {
