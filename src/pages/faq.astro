---
import Base from '../layouts/Base.astro';
import CtaBand from '../components/CtaBand.astro';
import Faq from '../components/Faq.astro';
import { faqs } from '../data/faqs.js';
---

<Base
  title="Questions and Answers | ScamPrep"
  shareTitle="Questions about consent, safety and cost"
  description="How consent works, how often practice scams arrive, what the quarterly Resilience Report shows, and what it costs."
>
  <section class="section">
    <div class="wrap prose">
      <p class="kicker">Fair questions, honest answers</p>
      <h1>Frequently asked questions</h1>
    </div>
  </section>

  <section class="section--tight section" style="padding-bottom: 96px;">
    <div class="wrap" style="max-width: 800px;">
      <Faq items={faqs} />
    </div>
  </section>

  <CtaBand />
</Base>
