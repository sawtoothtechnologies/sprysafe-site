---
import Base from '../layouts/Base.astro';
import ReportCard from '../components/ReportCard.astro';
import PhoneDemo from '../components/PhoneDemo.astro';
import CtaBand from '../components/CtaBand.astro';
import Faq from '../components/Faq.astro';
import { homeFaqs } from '../data/faqs.js';
---

<Base
  title="ScamPrep — Simulated Scam Drills & Coaching, with a Quarterly Resilience Report"
  description="A pamphlet won't stop the next scam. Practice will. ScamPrep trains the person you care about with safe, simulated scam drills, coaching the moment they slip, and a drip of up-to-date scam briefings — plus a quarterly Resilience Report. Consent-first."
>
  <!-- ============ HERO — radar (state) ============ -->
  <section class="hero section--ink">
    <!-- Radar: rings, a sweeping line, three contacts that light up as the line
         passes over them, and a solid center dot (the logo's pupil). Blip timing
         is tied to the sweep's 8s rotation; see .hero__blip in the styles below. -->
    <div class="hero__radar" aria-hidden="true">
      <div class="radar-rings"></div>
      <div class="radar-sweep"></div>
      <span class="hero__blip hero__blip--1"></span>
      <span class="hero__blip hero__blip--2"></span>
      <span class="hero__blip hero__blip--3"></span>
      <span class="hero__center"></span>
    </div>

    <div class="wrap hero__grid">
      <div>
        <h1>Simulated scam drills for those most targeted.</h1>
        <p class="hero__metaphor">A pamphlet won't stop the next scam. Practice will.</p>
        <p class="lede">
          Strengthen resistance to scams with real-world practice, timely alerts and education,
          and a quarterly Resilience Report.
        </p>
        <div class="btn-row" style="margin-top: 30px;">
          <span class="ping-wrap">
            <span class="ping-ring" aria-hidden="true"></span>
            <a class="btn btn--primary" href="/early-access">Get early access</a>
          </span>
          <a class="btn btn--ghost" href="#how">See how it works</a>
        </div>
        <p class="trust-line">
          Consent-first. No bank access. Nothing to install. Cancel anytime.
          60-day money-back guarantee.
        </p>
      </div>
      <div class="hero__card">
        <ReportCard variant="trimmed" tone="dark" />
      </div>
    </div>
  </section>

  <!-- ============ THE PROBLEM — trace + ping micro-graphics ============ -->
  <section class="section section--paper section--stats">
    <div class="wrap">
      <p class="kicker">Why now</p>
      <h2 style="max-width: 34rem;">Scams are getting smarter, and losses are exploding</h2>
      <p class="lede">
        AI voice clones and deepfakes have made fraud dramatically more convincing.
      </p>

      <div class="stat-row" id="stats-band">
        <!-- 71% — ten dots, seven lit -->
        <div class="stat-col">
          <div class="stat-line">
            <span class="stat__num" data-countup data-target="71" data-suffix="%">71%</span>
            <p class="stat__label">of adults 60+ contacted daily by scammers</p>
          </div>
          <div class="stat__graphic dots" aria-hidden="true">
            <span class="dot dot--on"></span><span class="dot dot--on"></span><span class="dot dot--on"></span>
            <span class="dot dot--on"></span><span class="dot dot--on"></span><span class="dot dot--on"></span>
            <span class="dot dot--on"></span>
            <span class="dot"></span><span class="dot"></span><span class="dot"></span>
          </div>
        </div>

        <!-- $38k — ping rings behind the number -->
        <div class="stat-col">
          <div class="stat-line stat-line--ping">
            <span class="loss-ping" aria-hidden="true"></span>
            <span class="loss-ping loss-ping--2" aria-hidden="true"></span>
            <span class="stat__num" data-countup data-target="38" data-prefix="$" data-suffix="k">$38k</span>
            <p class="stat__label">average reported loss</p>
          </div>
        </div>

        <!-- +59% — rising trace -->
        <div class="stat-col">
          <div class="stat-line">
            <span class="stat__num" data-countup data-target="59" data-prefix="+" data-suffix="%">+59%</span>
            <p class="stat__label">reported losses, last year</p>
          </div>
          <div class="stat__graphic" aria-hidden="true">
            <svg class="trace" viewBox="0 0 220 32" preserveAspectRatio="none">
              <path class="trace__line" d="M4 27 C 60 24, 120 18, 160 11 S 204 4, 212 4" fill="none" pathLength="600" />
              <circle cx="212" cy="4" r="3.5" fill="#f0a11c" />
            </svg>
          </div>
        </div>
      </div>

      <p class="lede" style="margin-top: 32px; max-width: 44rem;">
        The good news: spotting a scam is a trainable skill. Pamphlets fade; practice sticks.
        So we built the practice.
      </p>
    </div>
  </section>

  <!-- ============ HOW IT WORKS ============ -->
  <section class="section" id="how">
    <div class="wrap">
      <p class="kicker">How it works</p>
      <h2>Education, simulation, peace of mind</h2>
      <p class="lede">Four simple parts to build the instinct that spots a scam before it costs anything.</p>

      <div class="hiw" id="hiw">
        <div class="hiw__cards">
          <button class="hiw__card is-active" aria-expanded="true">
            <span class="hiw__card-num">1</span>
            <span class="hiw__card-body">
              <span class="hiw__card-title">Enroll in 2 minutes</span>
              <span class="hiw__card-teaser"><span>Tell us about the person you're signing up. They opt in personally, and there's nothing for them to install or manage.</span></span>
            </span>
            <span class="hiw__progress" aria-hidden="true"><span></span></span>
          </button>
          <button class="hiw__card" aria-expanded="false">
            <span class="hiw__card-num">2</span>
            <span class="hiw__card-body">
              <span class="hiw__card-title">Safe, simulated drills</span>
              <span class="hiw__card-teaser"><span>Realistic practice scams arrive by email, text, or phone — never dangerous, always debriefed on the spot.</span></span>
            </span>
            <span class="hiw__progress" aria-hidden="true"><span></span></span>
          </button>
          <button class="hiw__card" aria-expanded="false">
            <span class="hiw__card-num">3</span>
            <span class="hiw__card-body">
              <span class="hiw__card-title">Briefings on the newest scams</span>
              <span class="hiw__card-teaser"><span>Short heads-ups on what's newly circulating, sent through the channels they already use.</span></span>
            </span>
            <span class="hiw__progress" aria-hidden="true"><span></span></span>
          </button>
          <button class="hiw__card" aria-expanded="false">
            <span class="hiw__card-num">4</span>
            <span class="hiw__card-body">
              <span class="hiw__card-title">Quarterly Resilience Report</span>
              <span class="hiw__card-teaser"><span>One page to the family: what was practiced, what was caught, and what's being reinforced next.</span></span>
            </span>
            <span class="hiw__progress" aria-hidden="true"><span></span></span>
          </button>
        </div>

        <div class="hiw__phone">
          <PhoneDemo />
        </div>
      </div>

      <p style="margin-top: 40px;"><a class="btn btn--ghost" href="/how-it-works">See a drill up close →</a></p>
    </div>
  </section>

  <!-- ============ RESILIENCE REPORT — trace (data) ============ -->
  <section class="section section--air section--ink" id="report">
    <div class="radar-rings report__radar" aria-hidden="true"></div>
    <div class="wrap hero__grid">
      <div>
        <p class="kicker">The Resilience Report</p>
        <h2>Peace of mind they won't fall victim</h2>
        <p class="lede">
          Monitoring apps message you when something bad might have happened. ScamPrep sends you
          proof of something good: the person you care about is getting harder to fool, quarter
          after quarter.
        </p>

        <figure class="trace-card">
          <figcaption>Drills caught, last six months</figcaption>
          <svg class="trace" width="100%" height="60" viewBox="0 0 460 60" preserveAspectRatio="none" role="img" aria-label="Drills caught per month, January through June: 2, 3, 2, 3, 3, 4 — trending up">
            <line x1="0" y1="52" x2="460" y2="52" stroke="#33302b" stroke-width="1" />
            <path class="trace__line" d="M20 42 L104 30 L188 42 L272 30 L356 30 L440 12" fill="none" pathLength="600" />
            <circle cx="20" cy="42" r="2.5" fill="#4d4841" />
            <circle cx="104" cy="30" r="2.5" fill="#4d4841" />
            <circle cx="188" cy="42" r="2.5" fill="#4d4841" />
            <circle cx="272" cy="30" r="2.5" fill="#4d4841" />
            <circle cx="356" cy="30" r="2.5" fill="#4d4841" />
            <circle cx="440" cy="12" r="4" fill="#f0a11c" />
            <circle cx="440" cy="12" r="8" fill="none" stroke="rgba(240,161,28,0.4)" stroke-width="1.5" />
          </svg>
          <div class="trace-card__axis" aria-hidden="true">
            <span>JAN</span><span>FEB</span><span>MAR</span><span>APR</span><span>MAY</span><span>JUN</span>
          </div>
        </figure>
      </div>
      <div class="hero__card">
        <ReportCard variant="full" tone="dark" />
      </div>
    </div>
  </section>

  <!-- ============ COMPARISON ============ -->
  <section class="section">
    <div class="wrap">
      <h2 style="max-width: 36rem;">Everything else waits for the scam. We get there first.</h2>
      <div class="table-scroll" style="margin-top: 36px;">
        <table class="compare">
          <thead>
            <tr>
              <th scope="col">Approach</th>
              <th scope="col">What it does</th>
              <th scope="col">The gap</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td class="compare__who">Account monitoring</td>
              <td>Watches the bank account, alerts family to suspicious transactions</td>
              <td>Alerts arrive <em>after</em> the money moves, and signal “we're watching you”</td>
            </tr>
            <tr>
              <td class="compare__who">Call &amp; text blockers</td>
              <td>Filter known scam numbers</td>
              <td>The day one slips through — and one always does — the person is untrained</td>
            </tr>
            <tr>
              <td class="compare__who">Free classes &amp; pamphlets</td>
              <td>Teach scam awareness once</td>
              <td>The benefit fades within about a month, and the content goes stale as new scams appear</td>
            </tr>
            <tr class="compare__hero">
              <td class="compare__who"><span class="who-inline"><span class="blip" aria-hidden="true"></span>ScamPrep</span></td>
              <td>Trains the person with safe practice and coaching, keeps their knowledge current with drip briefings, and measures progress quarterly</td>
              <td>The person becomes the defense, without giving up an ounce of independence</td>
            </tr>
          </tbody>
        </table>
      </div>
      <p class="lede" style="margin-top: 28px;">Blockers and monitors are fine seatbelts. ScamPrep is the driving lesson.</p>
    </div>
  </section>

  <!-- ============ RESEARCH STRIP ============ -->
  <section class="section--tight section section--paper">
    <div class="wrap center">
      <p class="kicker">The evidence</p>
      <h2 style="max-width: 40rem; margin-inline: auto;">Built on what actually works</h2>
      <p class="lede" style="max-width: 48rem; margin-inline: auto;">
        A 2024 federal review of scam-prevention research found one-time education fades within
        weeks, and called messaging that <em>simulates</em> being scammed “promising.” A
        University of Florida study found performance on safe practice tests predicts real-world
        risk. It's the same simulate-coach-measure loop Fortune 500 companies have trusted for
        years. No one had pointed it at the people who need it most.
      </p>
      <p class="center" style="margin-top: 22px;"><a href="/why-it-works">Read why it works →</a></p>
    </div>
  </section>

  <!-- ============ FOR ORGANIZATIONS ============ -->
  <section class="section">
    <div class="wrap">
      <p class="kicker">For organizations</p>
      <h2>Also built for the people families trust</h2>
      <div class="grid grid--2" style="margin-top: 36px;">
        <div class="card">
          <h3>Financial &amp; wealth advisors</h3>
          <p>One scammed client can erase years of trust and six figures of AUM. Protect the person, not just the portfolio.</p>
          <p><a class="cta-link" href="/solutions#financial-advisors">Learn more →</a></p>
        </div>
        <div class="card">
          <h3>Credit unions</h3>
          <p>A member benefit that keeps savings where they belong, and turns fraud prevention into loyalty across generations.</p>
          <p><a class="cta-link" href="/solutions#credit-unions">Learn more →</a></p>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ PROMISE STRIP ============ -->
  <section class="section--tight section">
    <div class="wrap">
      <div class="card promise">
        <span class="blip promise__blip" aria-hidden="true"></span>
        <p style="margin: 0; font-size: 1.08rem;">
          <strong>Consent-first, always.</strong> Every participant opts in personally. Drills are
          gentle, immediately debriefed, and designed with published research on older-adult
          learning. No shame, no tricks for tricks' sake, no surprises the family didn't sign up
          for. <a href="/promise">Read our full promise →</a>
        </p>
      </div>
    </div>
  </section>

  <!-- ============ FAQ TEASER ============ -->
  <section class="section">
    <div class="wrap" style="max-width: 800px;">
      <h2 class="center">Fair questions, honest answers</h2>
      <div style="margin-top: 32px;">
        <Faq items={homeFaqs} />
      </div>
      <p class="center" style="margin-top: 26px;"><a href="/faq">Read the full FAQ →</a></p>
    </div>
  </section>

  <!-- ============ FINAL CTA ============ -->
  <CtaBand />

  <!-- ============ SOURCES ============ -->
  <div class="wrap">
    <p class="footnote center" style="padding: 26px 0 34px; margin: 0;">
      Sources: <a href="https://apnorc.org/projects/fifty-eight-percent-of-adults-report-receiving-scam-attempts-daily/">AP-NORC Center poll (2026)</a> ·
      <a href="https://www.fbi.gov/news/stories/scammers-target-older-adult-victims">FBI, on the IC3 2025 Internet Crime Report</a>
    </p>
  </div>
</Base>

<script>
  // Count-up animation for the "Why now" stats.
  // Progressive enhancement: markup ships the final numbers, so no-JS visitors
  // (and search engines) always see real values.
  const els = document.querySelectorAll('[data-countup]');
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  const render = (el, value) => {
    const decimals = parseInt(el.dataset.decimals || '0', 10);
    const num = decimals
      ? value.toFixed(decimals)
      : Math.round(value).toLocaleString('en-US');
    el.textContent = (el.dataset.prefix || '') + num + (el.dataset.suffix || '');
  };

  const animate = (el) => {
    const target = parseFloat(el.dataset.target || '0');
    if (reduceMotion) { render(el, target); return; }
    const duration = 1400;
    let startTime;
    const tick = (now) => {
      if (startTime === undefined) startTime = now;
      const progress = Math.min((now - startTime) / duration, 1);
      const eased = 1 - Math.pow(1 - progress, 3); // ease-out cubic
      render(el, target * eased);
      if (progress < 1) requestAnimationFrame(tick);
    };
    requestAnimationFrame(tick);
  };

  if (els.length && 'IntersectionObserver' in window && !reduceMotion) {
    els.forEach((el) => render(el, 0)); // zero out only once JS is confirmed running
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            animate(entry.target);
            io.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.35 }
    );
    els.forEach((el) => io.observe(el));
  }

  // Stats band — arm the dot pictograph and ping rings, then play once the
  // band scrolls into view. Markup ships the final state, so no-JS and
  // reduced-motion visitors see everything without animation.
  const band = document.getElementById('stats-band');
  if (band && 'IntersectionObserver' in window && !reduceMotion) {
    band.classList.add('stats--anim');
    const bandIo = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            band.classList.add('stats--play');
            bandIo.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.25 }
    );
    bandIo.observe(band);
  }

  // Trace motif — the line draws itself once, on scroll into view (the
  // reference loops it forever; play-once is the production behavior).
  const traces = Array.from(document.querySelectorAll('.trace'));
  if (traces.length && 'IntersectionObserver' in window && !reduceMotion) {
    traces.forEach((t) => t.classList.add('trace--anim'));
    const traceIo = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('trace--play');
            traceIo.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.4 }
    );
    traces.forEach((t) => traceIo.observe(t));
  }

  // "How it works" — an expanding step carousel synced with the phone demo.
  // The active card expands to show its teaser; autoplay lingers on each step,
  // then moves on (the drill step gets extra time so the phone sequence can
  // finish). Autoplay only starts once the section scrolls into view, so
  // visitors always see it from step 1. Hovering pauses; clicking a card takes
  // over. Without JS, all four cards render expanded.
  const hiw = document.getElementById('hiw');
  if (hiw) {
    hiw.classList.add('hiw--js');
    const cards = Array.from(hiw.querySelectorAll('.hiw__card'));
    const bars = Array.from(hiw.querySelectorAll('.hiw__progress > span'));
    const n = cards.length;
    const DURATIONS = [3500, 6000, 4000, 4000];
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let current = 0, elapsed = 0, last = null, hovering = false, stopped = false, raf = 0;

    const setProgress = (frac) =>
      bars.forEach((b, j) => { b.style.transform = 'scaleX(' + (j === current ? frac : 0) + ')'; });

    const show = (i) => {
      current = (i + n) % n;
      cards.forEach((card, j) => {
        const active = j === current;
        card.classList.toggle('is-active', active);
        card.setAttribute('aria-expanded', active ? 'true' : 'false');
      });
      elapsed = 0;
      setProgress(0);
      // Tell the phone demo which scene to play.
      document.dispatchEvent(new CustomEvent('scamprep:hiwchange', { detail: { index: current } }));
    };

    const stop = () => {
      stopped = true;
      if (raf) cancelAnimationFrame(raf);
      setProgress(0);
    };

    cards.forEach((card, j) => {
      card.addEventListener('click', () => { show(j); stop(); });
    });
    hiw.addEventListener('mouseenter', () => { hovering = true; });
    hiw.addEventListener('mouseleave', () => { hovering = false; });

    show(0);

    if (!reduce && 'IntersectionObserver' in window) {
      const frame = (now) => {
        if (last === null) last = now;
        const dt = now - last;
        last = now;
        if (!hovering && !stopped) {
          elapsed += dt;
          const duration = DURATIONS[current] || 4000;
          setProgress(Math.min(elapsed / duration, 1));
          if (elapsed >= duration) show((current + 1) % n);
        }
        raf = requestAnimationFrame(frame);
      };
      const hiwIo = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              raf = requestAnimationFrame(frame);
              hiwIo.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.3 }
      );
      hiwIo.observe(hiw);
    }
  }
</script>

<style>
  /* ---------- Hero: the radar surface ---------- */
  .hero { padding: 0; }
  .hero__grid {
    position: relative;
    display: grid;
    gap: 56px;
    align-items: center;
  }
  .hero > .hero__grid { padding-top: 84px; padding-bottom: 96px; }
  @media (min-width: 920px) {
    .hero__grid { grid-template-columns: 1.15fr 1fr; }
  }
  .hero__card { display: flex; justify-content: center; }

  /* Trust line: single line at full desktop width (it fits once it can borrow
     the grid gap); balanced two-line wrap below that. */
  .hero .trust-line { text-wrap: balance; }
  @media (min-width: 1120px) {
    .hero .trust-line { white-space: nowrap; }
  }

  /* Radar: a 560px dial anchored in the top-right corner. Its center sits at
     (right 64px, top 120px) so it stays clear of the report card down to
     1280px wide, and clear of the headline on phones. */
  .hero__radar {
    position: absolute;
    right: -216px;
    top: -160px;
    width: 560px;
    height: 560px;
    pointer-events: none;
  }
  .hero__radar > .radar-rings,
  .hero__radar > .radar-sweep { inset: 0; }

  /* Center dot: the logo's solid amber pupil, with a soft halo. */
  .hero__center {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 18px;
    height: 18px;
    margin: -9px 0 0 -9px;
    border-radius: 50%;
    background: var(--amber);
    box-shadow: 0 0 0 5px rgba(240, 161, 28, 0.16), 0 0 22px rgba(240, 161, 28, 0.45);
  }

  /* Contacts. Each sits at (--dx, --dy) from the center. The sweep line turns
     once every 8s (spryRot on .radar-sweep), clockwise from 12 o'clock, so a
     contact at angle A is reached at A/360 * 8s. A negative delay of
     (A/360 * 8 - 8)s lands the flash exactly as the line passes, first pass
     included. Placed in the regions that stay visible: the band above the
     report card and the strip to its right. */
  .hero__blip {
    position: absolute;
    left: calc(50% + var(--dx));
    top: calc(50% + var(--dy));
    width: 9px;
    height: 9px;
    margin: -4.5px 0 0 -4.5px;
    border-radius: 50%;
    background: var(--amber);
    opacity: 0.22;
    animation: spryRadarBlip 8s linear infinite;
    animation-delay: var(--delay);
  }
  .hero__blip::after {
    content: '';
    position: absolute;
    inset: -1px;
    border-radius: 50%;
    border: 1.5px solid rgba(240, 161, 28, 0.85);
    opacity: 0;
    animation: spryRadarPing 8s linear infinite;
    animation-delay: var(--delay);
  }
  .hero__blip--1 { --dx: -150px; --dy: -70px; --delay: -1.444s; }  /* 295.0deg */
  .hero__blip--2 { --dx: 44px; --dy: -92px; --delay: -7.432s; width: 7px; height: 7px; margin: -3.5px 0 0 -3.5px; }  /* 25.6deg */
  .hero__blip--3 { --dx: 40px; --dy: 120px; --delay: -4.410s; }  /* 161.6deg */
  @media (max-width: 919px) {
    .hero__radar { opacity: 0.55; }
  }

  .hero h1 { color: var(--paper-bg); }
  .hero__metaphor {
    font-size: 1.3rem;
    font-weight: 700;
    color: var(--amber);
    line-height: 1.3;
    letter-spacing: -0.01em;
    margin: 0 0 18px;
  }

  /* ---------- Stats: dots, ping, trace ---------- */
  .section--stats { padding: 64px 0 56px; }
  .dots { display: flex; gap: 9px; align-items: center; }
  .dot { width: 12px; height: 12px; border-radius: 50%; border: 1.5px solid #b5b0a6; }
  .dot--on { background: var(--amber); border-color: var(--amber); }
  .stats--anim .dot--on { opacity: 0.25; }
  .stats--play .dot--on { animation: spryBlip 2.8s linear infinite; }
  .stats--play .dot--on:nth-child(2) { animation-delay: 0.25s; }
  .stats--play .dot--on:nth-child(3) { animation-delay: 0.5s; }
  .stats--play .dot--on:nth-child(4) { animation-delay: 0.75s; }
  .stats--play .dot--on:nth-child(5) { animation-delay: 1s; }
  .stats--play .dot--on:nth-child(6) { animation-delay: 1.25s; }
  .stats--play .dot--on:nth-child(7) { animation-delay: 1.5s; }

  .stat-line--ping { position: relative; }
  .loss-ping {
    position: absolute;
    left: 44px;
