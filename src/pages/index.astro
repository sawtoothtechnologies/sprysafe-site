---
import Base from '../layouts/Base.astro';
import ReportCard from '../components/ReportCard.astro';
import PhoneDemo from '../components/PhoneDemo.astro';
import CtaBand from '../components/CtaBand.astro';
import Faq from '../components/Faq.astro';
import { homeFaqs } from '../data/faqs.js';
---

<Base
  title="ScamPrep: Simulated scam drills and online threat training"
  description="Simulated scam drills, coaching and a quarterly Resilience Report for older adults and the family members who look out for them."
>
  <!-- ============ HERO ============ -->
  <!-- TRIAL (October 5 preview, not adopted): data-hero="glow" swaps the ripple
       for a warm light that fades up once, and drops the card behind the
       example drill. Add ?hero=classic to the address to see the ripple and
       the card again. Before publishing, keep one version and remove the
       other, along with this script. -->
  <section class="hero section--ink" data-hero="glow">
    <script is:inline>
      if (new URLSearchParams(location.search).get('hero') === 'classic') {
        document.currentScript.parentElement.dataset.hero = 'classic';
      }
    </script>
    <!-- The ripple: rings spreading from one steady amber point (the logo's
         centre). They sit farther apart and fainter as they travel out. They
         spread once on load, then hold still. Nothing loops. Decorative. -->
    <div class="hero__radar" aria-hidden="true">
      <svg class="hero__ripple" viewBox="-500 -500 1000 1000" width="1000" height="1000" fill="none">
        <circle r="36" stroke="#f0a11c" stroke-width="2.2" style="--i: 0; --o: 0.62; --peak: 0.9;" />
        <circle r="82" stroke="#f0a11c" stroke-width="1.9" style="--i: 1; --o: 0.46; --peak: 0.68;" />
        <circle r="140" stroke="#f0a11c" stroke-width="1.6" style="--i: 2; --o: 0.33; --peak: 0.51;" />
        <circle r="210" stroke="#f0a11c" stroke-width="1.4" style="--i: 3; --o: 0.23; --peak: 0.37;" />
        <circle r="292" stroke="#f0a11c" stroke-width="1.2" style="--i: 4; --o: 0.15; --peak: 0.26;" />
        <circle r="386" stroke="#f0a11c" stroke-width="1" style="--i: 5; --o: 0.09; --peak: 0.18;" />
        <circle r="492" stroke="#f0a11c" stroke-width="1" style="--i: 6; --o: 0.05; --peak: 0.13;" />
      </svg>
      <span class="hero__center"></span>
    </div>

    <div class="wrap hero__grid">
      <div class="hero__copy">
        <h1>Help your loved&nbsp;ones spot scams.</h1>
        <p class="lede">
          ScamPrep delivers research-backed simulations and coaching to keep older adults ahead of the latest, most cunning scams.
        </p>
        <p class="hero__metaphor">Pamphlets fade. Practice sticks.</p>
        <div class="btn-row" style="margin-top: 30px;">
          <a class="btn btn--primary" href="/early-access">Get early access</a>
        </div>
        <p class="trust-line">You invite, they opt in. Nothing to install. No bank access.</p>
      </div>
      <div class="hero__card">
        <!-- Trial: one warm light behind the coaching panel. It fades up once,
             as the coaching arrives, and holds still. Decorative. -->
        <span class="hero__light" aria-hidden="true"></span>
        <!-- Example drill: one static card, message then coaching, both visible at
             once. No phone frame, no sequence. The "link" is inert text. -->
        <div class="drill-card" aria-label="Example practice simulation">
          <p class="drill-card__label">Example practice simulation</p>

          <div class="drill-card__msg">
            <svg class="drill-card__tail" width="36" height="24" viewBox="0 0 36 24" aria-hidden="true"><path d="M36 0H16v4c0 10-4 16-16 20h36z" fill="#ebe8df" /></svg>
            <p class="drill-card__msg-head">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 6.5A2.5 2.5 0 0 1 6.5 4h11A2.5 2.5 0 0 1 20 6.5v7a2.5 2.5 0 0 1-2.5 2.5H10l-4.5 3.5V16A2.5 2.5 0 0 1 4 13.5z"/><path d="M8.5 9h7M8.5 12h4.5"/></svg>
              Text from an unfamiliar number
            </p>
            <p class="drill-card__body">USPS: Your parcel couldn’t be delivered. Pay a $1.95 redelivery fee to schedule another attempt.</p>
            <p class="drill-card__body"><span class="drill-card__fakelink">Schedule redelivery</span></p>
          </div>

          <div class="drill-card__then" aria-hidden="true"><span>If they tap the link</span></div>
          <p class="sr-only">If they tap the link:</p>

          <div class="drill-card__coach">
            <p class="drill-card__coach-title">
              <svg width="18" height="18" viewBox="10 10 76 76" fill="none" aria-hidden="true">
                <path d="M 57.02 19.39 A 30 30 0 1 0 76.61 38.98" stroke="currentColor" stroke-width="8.5" stroke-linecap="round" />
                <circle cx="48" cy="48" r="11" fill="#f0a11c" />
              </svg>
              This was a ScamPrep drill.
            </p>
            <p class="drill-card__body">Don’t worry, no payment was taken. Remember: Unexpected fees and urgent requests are reasons to pause. Next time, you’ll be ready!</p>
            <p class="drill-card__action">Expecting a package? Open the delivery company’s official app or website yourself to check.</p>
          </div>

        </div>
      </div>
    </div>
  </section>

  <!-- ============ THE PROBLEM — stats ============ -->
  <section class="section section--paper section--stats">
    <div class="wrap">
      <p class="kicker">Why now</p>
      <h2 style="max-width: 34rem;">AI strengthens scammers and multiplies losses</h2>
      

      <div class="stat-row" id="stats-band">
        <!-- 71% — ten dots, seven lit -->
        <div class="stat-col">
          <div class="stat-line">
            <span class="stat__num">71%</span>
            <p class="stat__label">of adults 60+ contacted daily by scammers</p>
          </div>
          <div class="stat__graphic dots" aria-hidden="true">
            <span class="dot dot--on"></span><span class="dot dot--on"></span><span class="dot dot--on"></span>
            <span class="dot dot--on"></span><span class="dot dot--on"></span><span class="dot dot--on"></span>
            <span class="dot dot--on"></span>
            <span class="dot"></span><span class="dot"></span><span class="dot"></span>
          </div>
        </div>

        <!-- $38k -->
        <div class="stat-col">
          <div class="stat-line">
            <span class="stat__num">$38k</span>
            <p class="stat__label">average reported loss to scams</p>
          </div>
        </div>

        <!-- +59% -->
        <div class="stat-col">
          <div class="stat-line">
            <span class="stat__num">+59%</span>
            <p class="stat__label">reported losses, 2025</p>
          </div>
        </div>
      </div>

      <p class="lede" style="margin-top: 32px; max-width: 44rem;">
        From voice clones to deepfakes, it's easier than ever for fraudsters to create convincing ploys. But detecting scams, even the trickiest ones surfacing today, is a skill that can be practiced.
      </p>
    </div>
  </section>

  <!-- ============ HOW IT WORKS ============ -->
  <section class="section" id="how">
    <div class="wrap">
      <p class="kicker">How it works</p>
      <h2>Set up in minutes. Nothing to manage.</h2>
      <p class="lede">Get your loved ones to fine-tune their scam-spotting instincts in four simple steps.</p>

      <div class="hiw" id="hiw">
        <div class="hiw__cards">
          <button class="hiw__card is-active" type="button" aria-pressed="true" aria-controls="phone-demo">
            <span class="hiw__card-num">1</span>
            <span class="hiw__card-body">
              <span class="hiw__card-title">Enroll in 2 minutes</span>
              <span class="hiw__card-teaser"><span>Tell us about the person you'd like us to contact for signup. They opt in, and there's nothing for them to install or manage.</span></span>
              <span class="hiw__card-hint" aria-hidden="true"><span class="hiw__hint-show">Show details</span><span class="hiw__hint-hide">Hide details</span></span>
            </span>
          </button>
          <div class="hiw__example" id="hiw-example-0">
            <PhoneDemo scene={0} />
          </div>
          <button class="hiw__card" type="button" aria-pressed="false" aria-controls="phone-demo">
            <span class="hiw__card-num">2</span>
            <span class="hiw__card-body">
              <span class="hiw__card-title">Practice on safe, simulated scams</span>
              <span class="hiw__card-teaser"><span>Realistic practice arrives by email, text, and phone on no set schedule, 4–6 times per month. Never dangerous, always debriefed for the recipient immediately.</span></span>
              <span class="hiw__card-hint" aria-hidden="true"><span class="hiw__hint-show">Show details</span><span class="hiw__hint-hide">Hide details</span></span>
            </span>
          </button>
          <div class="hiw__example" id="hiw-example-1">
            <PhoneDemo scene={1} />
          </div>
          <button class="hiw__card" type="button" aria-pressed="false" aria-controls="phone-demo">
            <span class="hiw__card-num">3</span>
            <span class="hiw__card-body">
              <span class="hiw__card-title">Hear about new scams first</span>
              <span class="hiw__card-teaser"><span>Quick snippets on what's newly circulating, sent through the channels they already use.</span></span>
              <span class="hiw__card-hint" aria-hidden="true"><span class="hiw__hint-show">Show details</span><span class="hiw__hint-hide">Hide details</span></span>
            </span>
          </button>
          <div class="hiw__example" id="hiw-example-2">
            <PhoneDemo scene={2} />
          </div>
          <button class="hiw__card" type="button" aria-pressed="false" aria-controls="phone-demo">
            <span class="hiw__card-num">4</span>
            <span class="hiw__card-body">
              <span class="hiw__card-title">Get the quarterly Resilience Report</span>
              <span class="hiw__card-teaser"><span>One page to you and the learner: what was practiced, what was caught, and what's being reinforced next.</span></span>
              <span class="hiw__card-hint" aria-hidden="true"><span class="hiw__hint-show">Show details</span><span class="hiw__hint-hide">Hide details</span></span>
            </span>
          </button>
          <div class="hiw__example" id="hiw-example-3">
            <PhoneDemo scene={3} />
          </div>
        </div>

        <div class="hiw__phone">
          <PhoneDemo />
        </div>
      </div>

      <p style="margin-top: 40px;"><a class="btn btn--ghost" href="/how-it-works">See a drill up close</a></p>
    </div>
  </section>

  <!-- ============ RESILIENCE REPORT ============ -->
  <section class="section section--band" id="report">
    <div class="wrap hero__grid report-panel">
      <div>
        <p class="kicker">The quarterly Resilience Report</p>
        <h2>Reassurance they’re stronger against scams</h2>
        <p class="lede">
          Standard monitoring tools feel like surveillance, but the Resilience Report feels like something to be proud of.
        </p>

      </div>
      <div class="hero__card">
        <ReportCard variant="full" tone="dark" />
      </div>
    </div>
  </section>

  <!-- ============ COMPARISON ============ -->
  <section class="section">
    <div class="wrap">
      <h2 style="max-width: 36rem;">How ScamPrep compares.</h2>
      <p class="lede">Blockers and monitors can never catch all scams. Practice helps with those that get through.</p>
      <div class="table-scroll" style="margin-top: 36px;">
        <table class="compare">
          <thead>
            <tr>
              <th scope="col">Approach</th>
              <th scope="col">What it does</th>
              <th scope="col">The gap</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td class="compare__who">Account monitoring</td>
              <td data-label="What it does">Watches the bank account, alerts family to suspicious transactions</td>
              <td data-label="The gap">Alerts arrive after money moves, and feel like surveillance</td>
            </tr>
            <tr>
              <td class="compare__who">Scam blockers</td>
              <td data-label="What it does">Filters known scam numbers or emails</td>
              <td data-label="The gap">Scams always slip through. When they do, their recipient is untrained and vulnerable</td>
            </tr>
            <tr>
              <td class="compare__who">Free classes &amp; pamphlets</td>
              <td data-label="What it does">Teach scam awareness once</td>
              <td data-label="The gap">Retention fades within about a month, and the content goes stale as new scams appear</td>
            </tr>
            <tr class="compare__hero">
              <td class="compare__who"><span class="who-inline"><span class="blip" aria-hidden="true"></span>ScamPrep</span></td>
              <td data-label="What it does">Trains with safe practice and coaching, keeps knowledge current with quick briefings, and measures progress quarterly</td>
              <td data-label="The gap">The recipient becomes their best defense, without giving up an ounce of independence</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- ============ RESEARCH STRIP ============ -->
  <section class="section--tight section section--paper">
    <div class="wrap center">
      <p class="kicker">The evidence</p>
      <h2 style="max-width: 40rem; margin-inline: auto;">Built on what actually works for older adults</h2>
      <p class="lede" style="max-width: 48rem; margin-inline: auto;">
        Federal reports and academic research have repeatedly found one-time scam education fades within weeks, but studies show performance on safe practice tests predicts real-world risk.
      </p>
      <p class="lede" style="max-width: 48rem; margin-inline: auto;">
        That's why Fortune 500 companies have used and trusted simulated phishing training for years. Now, ScamPrep is providing it to the people who need it most.
      </p>
      <p class="center" style="margin-top: 22px;"><a href="/why-it-works">Read why it works</a></p>
    </div>
  </section>

  <!-- ============ PROMISE STRIP ============ -->
  <section class="section--tight section">
    <div class="wrap">
      <div class="card promise">
        <!-- Same icon family as the drill examples on How it works: a 1.8px
             outline glyph in a soft amber circle. A signed form with a check. -->
        <span class="promise__icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="3.5" width="14" height="17" rx="2.5"/><path d="M9 10.5l2.2 2.2 4-4.4"/><path d="M9 16.5h6"/></svg></span>
        <p style="margin: 0; font-size: 1.08rem;">
          <strong>Consent-first, always.</strong> Every participant opts in personally. Drills are
          gentle, immediately debriefed, and designed based on best practices for older-adult learning. No shame or fear tactics. <a href="/promise">Read our full promise</a>
        </p>
      </div>
    </div>
  </section>

  <!-- ============ FAQ TEASER ============ -->
  <section class="section">
    <div class="wrap" style="max-width: 800px;">
      <h2 class="center">Frequently asked questions</h2>
      <div style="margin-top: 32px;">
        <Faq items={homeFaqs} />
      </div>
      <p class="center" style="margin-top: 26px;"><a href="/faq">Read the full FAQ</a></p>
    </div>
  </section>

  <!-- ============ FINAL CTA ============ -->
  <CtaBand />

  <!-- ============ SOURCES ============ -->
  <!-- Part of the amber closing band, so the page runs amber straight into
       the footer with no paper strip between. -->
  <div class="cta-sources">
    <div class="wrap">
      <p class="footnote center">
        Sources: <a href="https://apnorc.org/projects/fifty-eight-percent-of-adults-report-receiving-scam-attempts-daily/">AP-NORC Center poll (2026)</a> ·
        <a href="https://www.fbi.gov/news/stories/scammers-target-older-adult-victims">FBI, on the IC3 2025 Internet Crime Report</a>
      </p>
    </div>
  </div>
</Base>

<script>
  // Stats band — arm the dot pictograph, then play once the band scrolls into
  // view. Markup ships the final state, so no-JS and reduced-motion visitors
  // see everything without animation.
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const band = document.getElementById('stats-band');
  if (band && 'IntersectionObserver' in window && !reduceMotion) {
    band.classList.add('stats--anim');
    const bandIo = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            band.classList.add('stats--play');
            bandIo.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.25 }
    );
    bandIo.observe(band);
  }

  // A manual walkthrough: content stays readable until the visitor chooses
  // another step. Native buttons support Tab, Enter and Space without a timer.
  //
  // Step titles show first. A step's description appears once it is chosen.
  // Wide screens: one step is selected and the phone beside the list shows it.
  // Smaller screens: each step opens its own example right beneath it, and a
  // second tap closes it. Steps open and close independently, so nothing above
  // the tapped step ever changes height and the page never jumps.
  // Without JS every example is simply shown.
  const hiw = document.getElementById('hiw');
  if (hiw) {
    hiw.classList.add('hiw--js');
    const cards = Array.from(hiw.querySelectorAll<HTMLButtonElement>('.hiw__card'));
    const examples = cards.map((_, i) => document.getElementById('hiw-example-' + i));
    const compact = window.matchMedia('(max-width: 1039px)');
    let selected = 0;
    const open = new Set<number>([0]);

    const render = () => {
      cards.forEach((card, i) => {
        const example = examples[i];
        if (compact.matches) {
          const isOpen = open.has(i);
          card.classList.toggle('is-active', isOpen);
          card.removeAttribute('aria-pressed');
          card.setAttribute('aria-expanded', String(isOpen));
          if (example) {
            card.setAttribute('aria-controls', example.id);
            example.hidden = !isOpen;
          }
        } else {
          card.classList.toggle('is-active', i === selected);
          card.removeAttribute('aria-expanded');
          card.setAttribute('aria-pressed', String(i === selected));
          card.setAttribute('aria-controls', 'phone-demo');
          if (example) example.hidden = true;
        }
      });
    };
    const showOnPhone = () =>
      document.dispatchEvent(new CustomEvent('scamprep:hiwchange', { detail: { index: selected } }));

    cards.forEach((card, i) => card.addEventListener('click', () => {
      if (compact.matches) {
        if (open.has(i)) open.delete(i);
        else open.add(i);
      } else {
        if (i === selected) return;
        selected = i;
        showOnPhone();
      }
      render();
    }));
    compact.addEventListener('change', render);
    render();
    showOnPhone();
  }
</script>

<style>
  /* ---------- Hero: the ripple surface ---------- */
  .hero { padding: 0; }
  .hero__grid {
    position: relative;
    display: grid;
    gap: 56px;
    align-items: center;
  }
  .hero > .hero__grid { padding-top: 84px; padding-bottom: 96px; }
  @media (max-width: 700px) {
    .hero > .hero__grid { padding-top: 64px; padding-bottom: 64px; gap: 40px; }
  }
  @media (min-width: 920px) {
    .hero__grid { grid-template-columns: 1.15fr 1fr; }
  }
  .hero__card { display: flex; justify-content: center; }
  .hero .lede { color: #d5d3ca; }
  /* A quiet note under the button: it recedes into the ink (about 6.5:1). */
  .hero .trust-line { font-size: 0.95rem; font-weight: 500; color: #9a978f; margin-top: 16px; }

  /* ---------- Example drill card ---------- */
  .drill-card {
    position: relative;
    width: 100%;
    max-width: 520px;
    background: #f7f5ee;
    color: #23231f;
    border: 1px solid rgba(35, 35, 31, 0.08);
    border-radius: 20px;
    padding: 28px;
    box-shadow: 0 18px 40px rgba(0, 0, 0, 0.28);
  }
  .drill-card p { margin: 0; }
  .drill-card__label {
    font-size: 0.9375rem;
    font-weight: 700;
    line-height: 1.3;
    color: var(--amber-deep);
    margin-bottom: 20px !important;
  }
  /* Captions above each box, the way messaging apps label a thread. */
  .drill-card__caption { font-size: 0.85rem; color: var(--gray-500); margin: 0 0 8px 2px !important; }
  .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  /* Connector: a dotted line from the bubble down to the coaching panel, with
     the transition label sitting on it. */
  .drill-card__then {
    position: relative;
    margin: 4px 0 4px 32px;
    padding: 16px 0 16px 18px;
    font-size: 0.9375rem;
    font-weight: 700;
    line-height: 1.3;
    color: var(--gray-500);
  }
  .drill-card__then::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    border-left: 2px dotted #c9c6bb;
  }
  /* Sender line inside the bubble, mirroring the mark + title in the coaching panel. */
  .drill-card__msg-head {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--gray-500);
    margin-bottom: 8px !important;
  }
  /* Incoming text: soft gray bubble with an explicit tail at the bottom left.
     Gray, not blue: blue is the sender's own message in most apps. */
  .drill-card__msg {
    position: relative; margin: 0 18px 0 16px;
    background: #ebe8df;
    border-radius: 20px;
    padding: 16px 18px;
  }
  .drill-card__tail { position: absolute; left: -16px; bottom: 0; }
  .drill-card__body { font-size: 1rem; line-height: 1.55; }
  .drill-card__body + .drill-card__body { margin-top: 8px !important; }
  /* Inert: a span, not an anchor. Nothing to focus, nowhere to go. */
  .drill-card__fakelink { color: #4a5c85; text-decoration: underline; text-underline-offset: 3px; pointer-events: none; }
  .drill-card__coach {
    background: #fff0cf;
    border-radius: 18px;
    padding: 18px 20px;
  }
  .drill-card__coach-title {
    display: flex;
    align-items: center;
    gap: 8px;
    font-weight: 800;
    font-size: 1.05rem;
    margin-bottom: 8px !important;
  }
  .drill-card__action { font-weight: 700; font-size: 1rem; line-height: 1.5; margin-top: 10px !important; }
  @media (max-width: 700px) {
    .drill-card { padding: 20px; border-radius: 16px; }
    .drill-card__msg, .drill-card__coach { padding: 16px; }
  }

  /* Trust line: single line at full desktop width (it fits once it can borrow
     the grid gap); balanced two-line wrap below that. */
  .hero .trust-line { text-wrap: balance; }

  /* Ripple: centred on a point in the top-right corner, at (right 64px,
     top 120px), so the bright inner rings stay clear of the report card down
     to 1280px wide, and clear of the headline on phones. */
  .hero__radar {
    position: absolute;
    right: -216px;
    top: -160px;
    width: 560px;
    height: 560px;
    pointer-events: none;
  }
  .hero__ripple { position: absolute; left: -220px; top: -220px; overflow: visible; }
  /* Each ring rests at its own faintness (--o): the farther out, the fainter. */
  .hero__ripple circle { opacity: var(--o); vector-effect: non-scaling-stroke; }
  /* One ripple on load, paced like a drop landing in still water. The amber
     point swells first. Then the rings leave the centre one at a time, about
     half a second apart, the outermost first. Each travels at an unhurried,
     nearly even speed and eases to a stop at its resting place, fading from
     a soft glow to its resting faintness as it goes. About five and a half
     seconds, then it is still. Nothing loops. */
  @media (prefers-reduced-motion: no-preference) {
    .hero__ripple circle {
      transform-box: fill-box;
      transform-origin: center;
      animation: rippleOut calc(1.7s + var(--i) * 0.56s) cubic-bezier(0.33, 0.6, 0.5, 1) both;
      animation-delay: calc(0.5s + (6 - var(--i)) * 0.55s);
    }
    .hero__center { animation: rippleDrop 1.6s cubic-bezier(0.4, 0, 0.3, 1) both; }
  }
  @keyframes rippleOut {
