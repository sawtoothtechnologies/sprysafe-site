---
import Base from '../layouts/Base.astro';
import ReportCard from '../components/ReportCard.astro';
import PhoneDemo from '../components/PhoneDemo.astro';
import CtaBand from '../components/CtaBand.astro';
import Faq from '../components/Faq.astro';
import { homeFaqs } from '../data/faqs.js';
---

<Base
  title="ScamPrep: Simulated scam drills and online threat training"
  description="Simulated scam drills, coaching and a quarterly Resilience Report for older adults and the family members who look out for them."
>
  <!-- ============ HERO ============ -->
  <section class="hero">
    <div class="wrap hero__grid">
      <div>
        <h1>Help your loved&nbsp;ones spot scams.</h1>
        <p class="lede">
          ScamPrep delivers research-backed simulations and coaching to keep older adults ahead of the latest, most cunning scams.
        </p>
        <p class="hero__metaphor">A pamphlet won't help. Practice will.</p>
        <div class="btn-row" style="margin-top: 30px;">
          <a class="btn btn--primary" href="/early-access">Get early access</a>
          <a class="btn btn--ghost" href="#how">How practice works</a>
        </div>
        <p class="trust-line">You invite, they opt in. Nothing to install. No bank access.</p>
      </div>
      <div class="hero__card">
        <!-- The stage: the drill card, sitting in a pool of warm light. The
             light is decorative and fades up once when the page opens. -->
        <div class="hero__stage">
          <div class="hero__light" aria-hidden="true"></div>
        <!-- Example drill: one static card, message then coaching, both visible at
             once. No phone frame, no sequence. The "link" is inert text. -->
        <div class="drill-card" aria-label="Example practice simulation">
          <p class="drill-card__label">Example practice simulation</p>

          <div class="drill-card__msg">
            <svg class="drill-card__tail" width="36" height="24" viewBox="0 0 36 24" aria-hidden="true"><path d="M36 0H16v4c0 10-4 16-16 20h36z" fill="#f4ecd9" /></svg>
            <p class="drill-card__msg-head">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 6.5A2.5 2.5 0 0 1 6.5 4h11A2.5 2.5 0 0 1 20 6.5v7a2.5 2.5 0 0 1-2.5 2.5H10l-4.5 3.5V16A2.5 2.5 0 0 1 4 13.5z"/><path d="M8.5 9h7M8.5 12h4.5"/></svg>
              Text from an unfamiliar number
            </p>
            <p class="drill-card__body">USPS: Your parcel couldn’t be delivered. Pay a $1.95 redelivery fee to schedule another attempt.</p>
            <p class="drill-card__body"><span class="drill-card__fakelink">Schedule redelivery</span></p>
          </div>

          <div class="drill-card__then" aria-hidden="true"><span>If they tap the link</span></div>
          <p class="sr-only">If they tap the link:</p>

          <div class="drill-card__coach">
            <p class="drill-card__coach-title">
              <svg width="20" height="20" viewBox="0 0 32 32" aria-hidden="true">
                <path d="M16 4 30 18h-6.6L16 10.6 8.6 18H2z" fill="#332b23" />
                <circle cx="16" cy="21.2" r="5.3" fill="#f0a11c" />
              </svg>
              This was a ScamPrep drill.
            </p>
            <p class="drill-card__body">Don’t worry, no payment was taken. Remember: Unexpected fees and urgent requests are reasons to pause. Next time, you’ll be ready!</p>
            <p class="drill-card__action">Expecting a package? Open the delivery company’s official app or website yourself to check.</p>
          </div>

        </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ THE PROBLEM — stats ============ -->
  <section class="section section--stats">
    <div class="wrap">
      <p class="kicker">Why now</p>
      <h2 style="max-width: 34rem;">AI strengthens scammers and multiplies losses</h2>
      

      <div class="stat-row" id="stats-band">
        <!-- 71% — ten dots, seven lit -->
        <div class="stat-col">
          <div class="stat-line">
            <span class="stat__num">71%</span>
            <p class="stat__label">of adults 60+ contacted daily by scammers</p>
          </div>
          <div class="stat__graphic dots" aria-hidden="true">
            <span class="dot dot--on"></span><span class="dot dot--on"></span><span class="dot dot--on"></span>
            <span class="dot dot--on"></span><span class="dot dot--on"></span><span class="dot dot--on"></span>
            <span class="dot dot--on"></span>
            <span class="dot"></span><span class="dot"></span><span class="dot"></span>
          </div>
        </div>

        <!-- $38k -->
        <div class="stat-col">
          <div class="stat-line">
            <span class="stat__num">$38k</span>
            <p class="stat__label">average reported loss to scams</p>
          </div>
        </div>

        <!-- +59% -->
        <div class="stat-col">
          <div class="stat-line">
            <span class="stat__num">+59%</span>
            <p class="stat__label">reported losses, 2025</p>
          </div>
        </div>
      </div>

      <p class="lede" style="margin-top: 32px; max-width: 44rem;">
        From voice clones to deepfakes, it's easier than ever for fraudsters to create convincing pitches and ploys. But detecting scams, even the trickiest ones surfacing today, is a skill that can be practiced.
      </p>
    </div>
  </section>

  <!-- ============ HOW IT WORKS ============ -->
  <section class="section" id="how">
    <div class="wrap">
      <p class="kicker">How it works</p>
      <h2>Set up in minutes. Nothing to manage.</h2>
      <p class="lede">Get your loved ones to fine-tune their scam-spotting instincts in four simple steps.</p>

      <div class="hiw" id="hiw">
        <div class="hiw__cards">
          <button class="hiw__card is-active" aria-expanded="true">
            <span class="hiw__card-num">1</span>
            <span class="hiw__card-body">
              <span class="hiw__card-title">Enroll in 2 minutes</span>
              <span class="hiw__card-teaser"><span>Tell us about the person you'd like us to contact for signup. They opt in, and there's nothing for them to install or manage.</span></span>
            </span>
            <span class="hiw__progress" aria-hidden="true"><span></span></span>
          </button>
          <button class="hiw__card" aria-expanded="false">
            <span class="hiw__card-num">2</span>
            <span class="hiw__card-body">
              <span class="hiw__card-title">Practice on safe, simulated scams</span>
              <span class="hiw__card-teaser"><span>Realistic practice arrives by email, text, and phone on no set schedule, 4–6 times per month. Never dangerous, always debriefed for the recipient immediately.</span></span>
            </span>
            <span class="hiw__progress" aria-hidden="true"><span></span></span>
          </button>
          <button class="hiw__card" aria-expanded="false">
            <span class="hiw__card-num">3</span>
            <span class="hiw__card-body">
              <span class="hiw__card-title">Hear about new scams first</span>
              <span class="hiw__card-teaser"><span>Quick snippets on what's newly circulating, sent through the channels they already use.</span></span>
            </span>
            <span class="hiw__progress" aria-hidden="true"><span></span></span>
          </button>
          <button class="hiw__card" aria-expanded="false">
            <span class="hiw__card-num">4</span>
            <span class="hiw__card-body">
              <span class="hiw__card-title">Get the quarterly Resilience Report</span>
              <span class="hiw__card-teaser"><span>One page to you and the learner: what was practiced, what was caught, and what's being reinforced next.</span></span>
            </span>
            <span class="hiw__progress" aria-hidden="true"><span></span></span>
          </button>
        </div>

        <div class="hiw__phone">
          <PhoneDemo />
        </div>
      </div>

      <p style="margin-top: 40px;"><a class="btn btn--ghost" href="/how-it-works">See a drill up close</a></p>
    </div>
  </section>

  <!-- ============ RESILIENCE REPORT ============ -->
  <section class="section section--air section--ink" id="report">
    <div class="wrap hero__grid">
      <div>
        <p class="kicker">The Resilience Report</p>
        <h2>Every quarter, reassurance they’re stronger against scams</h2>
        <p class="lede">
          Standard monitoring tools feel like surveillance, but the Resilience Report feels like something to be proud of. All while you get reassurance.
        </p>

      </div>
      <div class="hero__card">
        <ReportCard variant="full" tone="dark" />
      </div>
    </div>
  </section>

  <!-- ============ COMPARISON ============ -->
  <section class="section">
    <div class="wrap">
      <h2 style="max-width: 36rem;">How ScamPrep compares.</h2>
      <p class="lede">Blockers and monitors can never catch all scams. Practice helps with those that get through.</p>
      <div class="table-scroll" style="margin-top: 36px;">
        <table class="compare">
          <thead>
            <tr>
              <th scope="col">Approach</th>
              <th scope="col">What it does</th>
              <th scope="col">The gap</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td class="compare__who">Account monitoring</td>
              <td data-label="What it does">Watches the bank account, alerts family to suspicious transactions</td>
              <td data-label="The gap">Alerts arrive after money moves, and feel like surveillance</td>
            </tr>
            <tr>
              <td class="compare__who">Scam blockers</td>
              <td data-label="What it does">Filters known scam numbers or emails</td>
              <td data-label="The gap">Scams always slip through. When they do, their recipient is untrained and vulnerable</td>
            </tr>
            <tr>
              <td class="compare__who">Free classes &amp; pamphlets</td>
              <td data-label="What it does">Teach scam awareness once</td>
              <td data-label="The gap">Retention fades within about a month, and the content goes stale as new scams appear</td>
            </tr>
            <tr class="compare__hero">
              <td class="compare__who"><span class="who-inline"><span class="blip" aria-hidden="true"></span>ScamPrep</span></td>
              <td data-label="What it does">Trains with safe practice and coaching, keeps knowledge current with quick briefings, and measures progress quarterly</td>
              <td data-label="The gap">The recipient becomes their best defense, without giving up an ounce of independence</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- ============ RESEARCH STRIP ============ -->
  <section class="section--tight section section--paper">
    <div class="wrap center">
      <p class="kicker">The evidence</p>
      <h2 style="max-width: 40rem; margin-inline: auto;">Built on what actually works for older adults</h2>
      <p class="lede" style="max-width: 48rem; margin-inline: auto;">
        Federal reports and academic research have repeatedly found one-time scam education fades within weeks, but studies show performance on safe practice tests predicts real-world risk.
      </p>
      <p class="lede" style="max-width: 48rem; margin-inline: auto;">
        That's why Fortune 500 companies have used and trusted simulated phishing training for years. Now, ScamPrep is providing it to the people who need it most.
      </p>
      <p class="center" style="margin-top: 22px;"><a href="/why-it-works">Read why it works</a></p>
    </div>
  </section>

  <!-- ============ PROMISE STRIP ============ -->
  <section class="section--tight section">
    <div class="wrap">
      <div class="card promise">
        <svg class="promise__icon" viewBox="0 0 24 24" width="40" height="40" aria-hidden="true"><rect x="4" y="3" width="16" height="18" rx="2.5" fill="#FBEFD3" stroke="#332B23" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/><path d="m8.5 9.5 2.5 2.5 4.5-5" fill="none" stroke="#332B23" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/><path d="M8 17h8" fill="none" stroke="#332B23" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        <p style="margin: 0; font-size: 1.08rem;">
          <strong>Consent-first, always.</strong> Every participant opts in personally. Drills are
          gentle, immediately debriefed, and designed based on best practices for older-adult learning. No shame or fear tactics. <a href="/promise">Read our full promise</a>
        </p>
      </div>
    </div>
  </section>

  <!-- ============ FAQ TEASER ============ -->
  <section class="section">
    <div class="wrap" style="max-width: 800px;">
      <h2 class="center">Frequently asked questions</h2>
      <div style="margin-top: 32px;">
        <Faq items={homeFaqs} />
      </div>
      <p class="center" style="margin-top: 26px;"><a href="/faq">Read the full FAQ</a></p>
    </div>
  </section>

  <!-- ============ FINAL CTA ============ -->
  <CtaBand />

  <!-- ============ SOURCES ============ -->
  <div class="wrap">
    <p class="footnote center" style="padding: 24px 0 28px; margin: 0;">
      Sources: <a href="https://apnorc.org/projects/fifty-eight-percent-of-adults-report-receiving-scam-attempts-daily/">AP-NORC Center poll (2026)</a> ·
      <a href="https://www.fbi.gov/news/stories/scammers-target-older-adult-victims">FBI, on the IC3 2025 Internet Crime Report</a>
    </p>
  </div>
</Base>

<script>
  // Stats band — arm the dot pictograph, then play once the band scrolls into
  // view. Markup ships the final state, so no-JS and reduced-motion visitors
  // see everything without animation.
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const band = document.getElementById('stats-band');
  if (band && 'IntersectionObserver' in window && !reduceMotion) {
    band.classList.add('stats--anim');
    const bandIo = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            band.classList.add('stats--play');
            bandIo.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.25 }
    );
    bandIo.observe(band);
  }

  // "How it works" — an expanding step carousel synced with the phone demo.
  // The active card expands to show its teaser; autoplay lingers on each step,
  // then moves on (the drill step gets extra time so the phone sequence can
  // finish). Autoplay only starts once the section scrolls into view, so
  // visitors always see it from step 1. Hovering pauses; clicking a card takes
  // over. Without JS, all four cards render expanded.
  const hiw = document.getElementById('hiw');
  if (hiw) {
    hiw.classList.add('hiw--js');
    const cards = Array.from(hiw.querySelectorAll('.hiw__card'));
    const bars = Array.from(hiw.querySelectorAll('.hiw__progress > span'));
    const n = cards.length;
    const DURATIONS = [3500, 6000, 4000, 4000];
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let current = 0, elapsed = 0, last = null, hovering = false, stopped = false, raf = 0;

    const setProgress = (frac) =>
      bars.forEach((b, j) => { b.style.transform = 'scaleX(' + (j === current ? frac : 0) + ')'; });

    const show = (i) => {
      current = (i + n) % n;
      cards.forEach((card, j) => {
        const active = j === current;
        card.classList.toggle('is-active', active);
        card.setAttribute('aria-expanded', active ? 'true' : 'false');
      });
      elapsed = 0;
      setProgress(0);
      // Tell the phone demo which scene to play.
      document.dispatchEvent(new CustomEvent('scamprep:hiwchange', { detail: { index: current } }));
    };

    const stop = () => {
      stopped = true;
      if (raf) cancelAnimationFrame(raf);
      setProgress(0);
    };

    cards.forEach((card, j) => {
      card.addEventListener('click', () => { show(j); stop(); });
    });
    hiw.addEventListener('mouseenter', () => { hovering = true; });
    hiw.addEventListener('mouseleave', () => { hovering = false; });

    show(0);

    if ('IntersectionObserver' in window) {
      const frame = (now) => {
        if (last === null) last = now;
        const dt = now - last;
        last = now;
        if (!hovering && !stopped) {
          elapsed += dt;
          const duration = DURATIONS[current] || 4000;
          if (!reduce) setProgress(Math.min(elapsed / duration, 1));
          if (elapsed >= duration) show((current + 1) % n);
        }
        raf = requestAnimationFrame(frame);
      };
      const hiwIo = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              raf = requestAnimationFrame(frame);
              hiwIo.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.3 }
      );
      hiwIo.observe(hiw);
    }
  }
</script>

<style>
  /* ---------- Hero: paper, with one pool of warm light ---------- */
  .hero { padding: 0; background: var(--color-bg); position: relative; overflow: hidden; }
  .hero__grid {
    position: relative;
    display: grid;
    gap: 56px;
    align-items: center;
  }
  .hero > .hero__grid { padding-top: 72px; padding-bottom: 96px; }
  @media (max-width: 700px) {
    .hero > .hero__grid { padding-top: 48px; padding-bottom: 64px; gap: 40px; }
  }
  @media (min-width: 920px) {
    .hero__grid { grid-template-columns: 1.15fr 1fr; }
  }
  /* Copy sits above the light so the gradient never tints the text. */
  .hero__grid > div:first-child { position: relative; z-index: 1; }
  .hero__card { display: flex; justify-content: center; }
  .hero .trust-line { font-size: 1rem; font-weight: 400; color: var(--color-text-muted); margin-top: 20px; }

  .hero__stage {
    position: relative;
    z-index: 0;
    width: 100%;
    max-width: 520px;
  }
  /* The light: one large, soft ellipse centred behind the drill card, as if
     a lamp were on just behind it. Warm amber at the very centre, honey
     around it, and gone before it reaches the edges of the hero. When the
     page opens it spreads outward and fades up once, then holds still.
     There is no illustration here on purpose: the light is the motif. */
  .hero__light {
    position: absolute;
    left: 50%;
    top: 42%;
    width: 1900px;
    height: 1300px;
    margin: -650px 0 0 -950px;
    border-radius: 50%;
    background: radial-gradient(
      closest-side,
      rgba(240, 161, 28, 0.5) 0%,
      rgba(246, 200, 110, 0.72) 14%,
      rgba(249, 227, 174, 0.92) 30%,
      rgba(249, 227, 174, 0.62) 48%,
      rgba(251, 239, 211, 0.4) 66%,
      rgba(251, 239, 211, 0.14) 84%,
      rgba(248, 247, 244, 0) 100%
    );
    pointer-events: none;
    z-index: -1;
  }
  /* The light is clipped by the hero, so it is feathered back to paper over
     the hero's bottom padding. Without this it ends in a hard line. */
  .hero::after {
    content: '';
    position: absolute;
    left: 0; right: 0; bottom: 0;
    height: 96px;
    background: linear-gradient(to bottom, rgba(248, 247, 244, 0), var(--color-bg));
    pointer-events: none;
  }
  @media (max-width: 700px) { .hero::after { height: 64px; } }
  @keyframes lightUp {
    from { opacity: 0; transform: scale(0.72); }
    to { opacity: 1; transform: none; }
  }
  @media (prefers-reduced-motion: no-preference) {
    .hero__light { animation: lightUp 1.4s cubic-bezier(0.22, 0.61, 0.36, 1) both; }
  }
  /* Stacked layout: the card sits below the copy, so the light moves up to
     the seam between them and the first screen is lit too. */
  @media (max-width: 919px) {
    .hero__light { width: 1200px; height: 1200px; margin: -600px 0 0 -600px; top: -40px; }
  }

  /* ---------- Example drill card ---------- */
  .drill-card {
    position: relative;
    width: 100%;
    max-width: 520px;
    background: var(--color-surface);
    color: var(--color-text);
    /* Drawn like the illustrations: one walnut line. */
    border: 2px solid var(--color-text);
    border-radius: var(--radius);
    padding: 28px;
  }
  .drill-card p { margin: 0; }
  .drill-card__label {
    font-size: 0.9375rem;
    font-weight: 600;
    line-height: 1.3;
    color: var(--color-text-muted);
    margin-bottom: 20px !important;
  }
  /* Captions above each box, the way messaging apps label a thread. */
  .drill-card__caption { font-size: 0.85rem; color: var(--gray-500); margin: 0 0 8px 2px !important; }
  .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  /* Connector: a dotted line from the bubble down to the coaching panel, with
     the transition label sitting on it. */
  .drill-card__then {
    position: relative;
    margin: 4px 0 4px 32px;
    padding: 16px 0 16px 18px;
    font-size: 0.9375rem;
    font-weight: 600;
    line-height: 1.3;
    color: var(--color-text-muted);
  }
  .drill-card__then::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    border-left: 2px dotted var(--color-control-border);
  }
  /* Sender line inside the bubble, mirroring the mark + title in the coaching panel. */
  .drill-card__msg-head {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--gray-500);
    margin-bottom: 8px !important;
  }
  /* Incoming text: soft oat bubble with an explicit tail at the bottom left
     (the tail's fill in the markup must match). Not blue: blue is the
     sender's own message in most apps, and dusk blue means coaching here. */
  .drill-card__msg {
    position: relative; margin: 0 18px 0 16px;
    background: var(--color-band-alt);
    border-radius: var(--radius);
    padding: 16px 18px;
  }
  .drill-card__tail { position: absolute; left: -16px; bottom: 0; }
  .drill-card__body { font-size: 1rem; line-height: 1.55; }
  .drill-card__body + .drill-card__body { margin-top: 8px !important; }
  /* Inert: a span, not an anchor. Nothing to focus, nowhere to go. */
  .drill-card__fakelink { color: var(--color-link); text-decoration: underline; text-underline-offset: 3px; pointer-events: none; }
  /* Coaching is dusk blue, so amber never means "careful". */
  .drill-card__coach {
    background: var(--color-coach-bg);
    border-radius: var(--radius);
    padding: 18px 20px;
  }
  .drill-card__coach-title {
    display: flex;
    align-items: center;
    gap: 8px;
    font-weight: 700;
    font-size: 1.05rem;
    color: var(--color-coach-text);
    margin-bottom: 8px !important;
  }
  .drill-card__action { font-weight: 700; font-size: 1rem; line-height: 1.5; margin-top: 10px !important; }
  @media (max-width: 700px) {
    .drill-card { padding: 20px; }
    .drill-card__msg, .drill-card__coach { padding: 16px; }
  }

  /* Trust line: single line at full desktop width (it fits once it can borrow
     the grid gap); balanced two-line wrap below that. */
  .hero .trust-line { text-wrap: balance; }

  .hero__metaphor {
    font-size: 1.3rem;
    font-weight: 700;
    color: var(--color-link);
    line-height: 1.3;
    letter-spacing: -0.01em;
    margin: 0 0 18px;
  }

  /* ---------- Stats: dots ---------- */
  .section--stats { padding: 24px 0 88px; }
  @media (max-width: 700px) { .section--stats { padding: 16px 0 72px; } }
  /* A string of lights: seven of ten lit. */
  .dots { display: flex; gap: 11px; align-items: center; padding-left: 4px; }
  .dot { width: 16px; height: 16px; border-radius: 50%; border: 2px solid var(--color-control-border); }
  .dot--on { background: var(--amber); border-color: var(--amber); box-shadow: 0 0 0 4px rgba(240, 161, 28, 0.2); }
  .stats--anim .dot--on { opacity: 0.25; }
  /* String of lights: each one comes on once, 80ms apart, then stays on. */
  .stats--play .dot--on { animation: lampOn 0.3s ease-out both; }
  .stats--play .dot--on:nth-child(2) { animation-delay: 0.08s; }
  .stats--play .dot--on:nth-child(3) { animation-delay: 0.16s; }
  .stats--play .dot--on:nth-child(4) { animation-delay: 0.24s; }
