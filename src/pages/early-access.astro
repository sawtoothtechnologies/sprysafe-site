---
import Base from '../layouts/Base.astro';

// FORM BACKEND: Formspree (form "ScamPrep early access", ID moeajjvb).
// Submissions arrive at hello@getscamprep.com. Keep reCAPTCHA OFF in Formspree
// settings — the fetch-based submit below is rejected if it's on.
const FORM_ACTION = 'https://formspree.io/f/moeajjvb';
---

<Base
  title="Get Early Access | ScamPrep"
  description="Family plans open this fall. Join the early-access list — small onboarding cohorts, white-glove setup, and a direct line to the founder."
>
  <section class="section">
    <div class="wrap form-layout">
      <div>
        <p class="kicker">Early access</p>
        <h1>Join the founding families.</h1>
        <p class="lede">
          Family plans open this fall. We onboard in small cohorts so every family gets
          white-glove setup — <strong>join the list and you're at the front</strong>, with a
          direct line to the founder.
        </p>
        <p class="trust-line">
          Consent-first. No bank access. Cancel anytime. 60-day money-back guarantee. We'll never
          sell your information.
        </p>

        <div class="org-callout">
          <p class="org-callout__head">Representing an organization?</p>
          <p class="org-callout__body">
            Financial advisors, credit unions, senior-living communities, home-care agencies —
            this form isn't your door. Founding-partner pilots start with a short call.
          </p>
          <a class="btn btn--ghost" href="/solutions">See partner options →</a>
        </div>
      </div>

      <form class="form-card" method="POST" action={FORM_ACTION}>
        <input type="hidden" id="plan" name="plan" value="" />
        <input type="hidden" id="utm_source" name="utm_source" value="" />
        <input type="hidden" id="utm_medium" name="utm_medium" value="" />
        <input type="hidden" id="utm_campaign" name="utm_campaign" value="" />
        <input type="hidden" id="referrer" name="referrer" value="" />
        <div class="field">
          <label for="name">Your name</label>
          <input type="text" id="name" name="name" autocomplete="name" />
        </div>

        <div class="field">
          <label for="email">Email <span class="hint">(required)</span></label>
          <input type="email" id="email" name="email" required autocomplete="email" />
        </div>

        <div class="field">
          <label for="role">I am…</label>
          <select id="role" name="role">
            <option>A family member protecting someone I love</option>
            <option>An individual protecting myself</option>
            <option>Other</option>
          </select>
        </div>

        <div class="field" id="enroll-field">
          <label for="who">Who would you like to enroll? <span class="hint">(optional)</span></label>
          <input type="text" id="who" name="who" />
        </div>

        <div class="field">
          <label for="worry">What worries you most right now? <span class="hint">(optional)</span></label>
          <textarea id="worry" name="worry" rows="4"></textarea>
        </div>

        <div class="field checkbox">
          <input type="checkbox" id="consent" name="consent" required />
          <label for="consent" style="margin: 0; font-weight: 400;">Email me about ScamPrep early access. (required)</label>
        </div>

        <button class="btn btn--primary" type="submit" style="width: 100%;">Get early access</button>

        <p class="footnote" style="margin: 16px 0 0;">
          You'll hear from us within a few days. If you write about a specific worry, a human
          (probably the founder) will read it personally.
        </p>
      </form>
    </div>
  </section>
</Base>

<script>
  // Carry the plan chosen on /pricing into the submission (?plan=individual|couples|family).
  const query = new URLSearchParams(location.search);
  const planInput = document.getElementById('plan') as HTMLInputElement | null;
  const plan = query.get('plan');
  if (planInput && plan) planInput.value = plan;

  // Attribution: URL params win; otherwise use tags remembered from the landing page
  // (Base.astro stores them in sessionStorage). Referrer fills in for untagged links.
  for (const k of ['utm_source', 'utm_medium', 'utm_campaign']) {
    const el = document.getElementById(k) as HTMLInputElement | null;
    if (!el) continue;
    let v = query.get(k);
    if (!v) { try { v = sessionStorage.getItem(k); } catch {} }
    if (v) el.value = v;
  }
  const refEl = document.getElementById('referrer') as HTMLInputElement | null;
  if (refEl && document.referrer && !document.referrer.includes(location.hostname)) {
    refEl.value = document.referrer;
  }

  // Show "Who would you like to enroll?" only when signing up for someone else.
  const role = document.getElementById('role') as HTMLSelectElement | null;
  const enrollField = document.getElementById('enroll-field');
  const whoInput = document.getElementById('who') as HTMLInputElement | null;
  const syncEnroll = () => {
    if (!role || !enrollField) return;
    const forSomeoneElse = role.value.startsWith('A family member');
    enrollField.hidden = !forSomeoneElse;
    if (!forSomeoneElse && whoInput) whoInput.value = '';
  };
  if (role) { role.addEventListener('change', syncEnroll); syncEnroll(); }

  // Submit via fetch so visitors land on our own /thanks page. (Formspree's hosted
  // redirect is a paid feature; this works on the free plan.) No-JS falls back to a
  // normal POST to Formspree's default confirmation page.
  const form = document.querySelector('form.form-card') as HTMLFormElement | null;
  if (form) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const btn = form.querySelector('button[type="submit"]') as HTMLButtonElement | null;
      if (btn) { btn.disabled = true; btn.textContent = 'Sending…'; }
      try {
        const data = new FormData(form);
        // Drop empty attribution fields so signup emails stay clean.
        for (const k of ['plan', 'utm_source', 'utm_medium', 'utm_campaign', 'referrer']) {
          if (!data.get(k)) data.delete(k);
        }
        const res = await fetch(form.action, {
          method: 'POST',
          body: data,
          headers: { Accept: 'application/json' },
        });
        if (!res.ok) throw new Error(String(res.status));
        window.location.href = '/thanks';
      } catch {
        if (btn) { btn.disabled = false; btn.textContent = 'Get early access'; }
        form.submit(); // plain POST fallback
      }
    });
  }
</script>

<style>
  .form-layout {
    display: grid;
    gap: 48px;
    align-items: start;
  }
  @media (min-width: 920px) {
    .form-layout { grid-template-columns: 1fr 1.1fr; }
  }
  .org-callout {
    margin-top: 34px;
    padding: 22px 24px;
    border: 1px solid var(--line);
    border-radius: 14px;
    background: var(--sand);
  }
  .org-callout__head {
    font-weight: 800;
    margin: 0 0 6px;
  }
  .org-callout__body {
    font-size: 1rem;
    margin: 0 0 14px;
  }
</style>
