---
import Base from '../layouts/Base.astro';

// FORM BACKEND: Formspree (form "ScamPrep early access", ID moeajjvb).
// Submissions arrive at hello@getscamprep.com. Keep reCAPTCHA OFF in Formspree
// settings — the fetch-based submit below is rejected if it's on.
const FORM_ACTION = 'https://formspree.io/f/moeajjvb';
---

<Base
  title="Get Early Access | ScamPrep"
  shareTitle="Join the founding cohort"
  description="Family plans open this fall in small cohorts, with white-glove setup and a direct line to the founder."
>
  <section class="section">
    <div class="wrap form-layout">
      <div>
        <p class="kicker">Early access</p>
        <h1>Join the founding cohort.</h1>
        <p class="lede">
          Family plans open this fall. We onboard in small cohorts so every family gets
          white-glove setup. <strong>Join the list and you're at the front</strong>, with a direct line to the founder.
        </p>
        <p class="trust-line">
          Consent-first. No bank access. Cancel anytime. 60-day money-back guarantee. We'll never
          sell your information.
        </p>

        <div class="org-callout">
          <p class="org-callout__head">Financial advisor or enterprise?</p>
          <p class="org-callout__body">
            Financial advisors, credit unions, and others: pilots start with a short call.
          </p>
          <a class="btn btn--ghost" href="/solutions">See partner options</a>
        </div>
      </div>

      <form class="form-card" method="POST" action={FORM_ACTION}>
        <input type="hidden" id="plan" name="plan" value="" />
        <input type="hidden" id="utm_source" name="utm_source" value="" />
        <input type="hidden" id="utm_medium" name="utm_medium" value="" />
        <input type="hidden" id="utm_campaign" name="utm_campaign" value="" />
        <input type="hidden" id="referrer" name="referrer" value="" />
        <div class="field">
          <label for="name">Your name</label>
          <input type="text" id="name" name="name" autocomplete="name" />
        </div>

        <div class="field">
          <label for="email">Email <span class="hint">(required)</span></label>
          <input type="email" id="email" name="email" required autocomplete="email" />
        </div>

        <div class="field">
          <label for="role">I want to…</label>
          <select id="role" name="role">
            <option>Protect someone I care for</option>
            <option>Protect myself</option>
            <option>Other</option>
          </select>
        </div>

        <div class="field">
          <label for="worry">What worries you most right now? <span class="hint">(optional)</span></label>
          <textarea id="worry" name="worry" rows="4"></textarea>
        </div>

        <button class="btn btn--primary" type="submit" style="width: 100%;">Get early access</button>

        <p class="form-error" id="form-error" role="alert" hidden></p>

        <p class="footnote" style="margin: 16px 0 0;">
                    We'll email you about early access and nothing else. If you write about a specific worry, our founder will reach out personally.
        </p>
      </form>
    </div>
  </section>
</Base>

<script>
  // Carry the plan chosen on /pricing into the submission (?plan=individual|couples|family).
  const query = new URLSearchParams(location.search);
  const planInput = document.getElementById('plan') as HTMLInputElement | null;
  const plan = query.get('plan');
  if (planInput && plan) planInput.value = plan;

  // Attribution: URL params win; otherwise use tags remembered from the landing page
  // (Base.astro stores them in sessionStorage). Referrer fills in for untagged links.
  for (const k of ['utm_source', 'utm_medium', 'utm_campaign']) {
    const el = document.getElementById(k) as HTMLInputElement | null;
    if (!el) continue;
    let v = query.get(k);
    if (!v) { try { v = sessionStorage.getItem(k); } catch {} }
    if (v) el.value = v;
  }
  const refEl = document.getElementById('referrer') as HTMLInputElement | null;
  if (refEl && document.referrer && !document.referrer.includes(location.hostname)) {
    refEl.value = document.referrer;
  }

  // Submit via fetch so visitors land on our own /thanks page. (Formspree's hosted
  // redirect is a paid feature; this works on the free plan.) No-JS visitors get a
  // normal POST to Formspree's default confirmation page.
  //
  // If the send fails, the visitor stays here with everything they typed and a
  // plain message. (The old fallback re-posted the form, which sent people to
  // Formspree's page or to a browser "no connection" page with their details lost.)
  const form = document.querySelector('form.form-card') as HTMLFormElement | null;
  const errorEl = document.getElementById('form-error');
  const CONTACT = 'If it keeps happening, email <a href="mailto:hello@getscamprep.com">hello@getscamprep.com</a> and we\'ll add you.';
  const showError = (message: string) => {
    if (!errorEl) return;
    errorEl.innerHTML = `${message} ${CONTACT}`;
    errorEl.hidden = false;
    errorEl.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
  };
  const send = async (data: FormData) => {
    const ctl = new AbortController();
    const timer = setTimeout(() => ctl.abort(), 15000);
    try {
      return await fetch(form!.action, { method: 'POST', body: data, headers: { Accept: 'application/json' }, signal: ctl.signal });
    } finally {
      clearTimeout(timer);
    }
  };
  if (form) {
    let sending = false;
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (sending) return;
      sending = true;
      if (errorEl) errorEl.hidden = true;
      const btn = form.querySelector('button[type="submit"]') as HTMLButtonElement | null;
      if (btn) { btn.disabled = true; btn.textContent = 'Sending…'; }
      const data = new FormData(form);
      // Drop empty attribution fields so signup emails stay clean.
      for (const k of ['plan', 'utm_source', 'utm_medium', 'utm_campaign', 'referrer']) {
        if (!data.get(k)) data.delete(k);
      }
      let res: Response | null = null;
      try {
        res = await send(data);
        // A dropped connection or a server hiccup gets one quiet retry.
        if (res.status >= 500) throw new Error(String(res.status));
      } catch {
        await new Promise((r) => setTimeout(r, 1500));
        try { res = await send(data); } catch { res = null; }
      }
      if (res && res.ok) {
        window.location.href = '/thanks';
        return;
      }
      sending = false;
      if (btn) { btn.disabled = false; btn.textContent = 'Get early access'; }
      if (res && res.status >= 400 && res.status < 500) {
        showError('That didn\'t go through. Please check your email address and try again.');
      } else {
        showError('We couldn\'t reach our signup service just now. Your details are still here, so please try again in a moment.');
      }
    });
  }
</script>

<style>
  /* On this page only: when the browser jumps to a field (for example an empty
     required field on submit), it lands below the sticky header, not under it. */
  :global(html) { scroll-padding-top: 96px; }
  .form-layout {
    display: grid;
    gap: 48px;
    align-items: start;
  }
  @media (min-width: 920px) {
    .form-layout { grid-template-columns: 1fr 1.1fr; }
  }
  .org-callout {
    margin-top: 34px;
    padding: 22px 24px;
    border: 1px solid var(--line);
    border-radius: 14px;
    background: var(--sand);
  }
  .org-callout__head {
    font-weight: 800;
    margin: 0 0 6px;
  }
  .form-error {
    margin: 16px 0 0;
    padding: 14px 16px;
    border: 1px solid var(--alert-line);
    border-radius: var(--radius-ctrl);
    background: var(--alert-tint);
    color: var(--ink);
    font-size: 1rem;
    line-height: 1.5;
  }
  .form-error a { color: var(--ink); font-weight: 700; }
  .org-callout__body {
    font-size: 1rem;
    margin: 0 0 14px;
  }
</style>
