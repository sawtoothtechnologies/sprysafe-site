---
// The hero artifact — the quarterly Resilience Report. Built in real HTML/CSS so
// it can become the actual product template later. Always labeled illustrative.
//
// variant: "full" (5 drill highlights + briefings + next-quarter focus) — the /report section
//          "trimmed" (3 drills + a teaser link) — the hero
// tone:    legacy prop from the dark-surface system. "dark" now means the card sits
//          on the honey band, "light" on paper; the card itself looks the same.
// cobrand: renders a fictional firm letterhead at the top of the card, so
// co-branding is shown in the artifact itself rather than described beside it.
const { variant = 'full', tone = 'dark', cobrand = false } = Astro.props;
const trimmed = variant === 'trimmed';

const fullDrills = [
  { what: 'Fake sheriff impersonation text', outcome: 'ignored', coached: false },
  { what: 'Prize-sweepstakes email', outcome: 'deleted', coached: false },
  { what: 'Fake family emergency call', outcome: 'hung up', coached: false },
  { what: 'Utility “past-due” email', outcome: 'ignored', coached: false },
  { what: 'Fake tech support email', outcome: 'responded & coached', coached: true },
];

const trimmedDrills = [
  { what: 'Fake sheriff impersonation text', outcome: 'ignored', coached: false },
  { what: 'Fake family emergency call', outcome: 'hung up', coached: false },
  { what: 'Fake tech support email', outcome: 'clicked & coached', coached: true },
];

const drills = trimmed ? trimmedDrills : fullDrills;
---

<div class:list={['report-wrap', `report-wrap--${tone}`]}>
  <p class="report__sample">Illustrative report</p>

  <figure class:list={['report', trimmed && 'report--trimmed']} aria-label="Sample quarterly Resilience Report (illustrative)">
    {cobrand && (
      <div class="report__brand">
        <span class="report__brand-mark" aria-hidden="true">AR</span>
        <div class="report__brand-text">
          <p class="report__brand-firm">Alder Ridge Wealth Partners</p>
          <p class="report__brand-for">Prepared for Mary Johnson</p>
        </div>
      </div>
    )}
    <header class="report__head">
      <div>
        <p class="report__title">Mary’s Resilience Report</p>
        <p class="report__month">Fall</p>
      </div>
      <div class="report__status" role="img" aria-label="Status: mostly strong, improving since summer">
        {!trimmed && <span class="report__status-label" aria-hidden="true">Status</span>}
        <span class="report__status-pill" aria-hidden="true">Mostly strong ↑</span>
        {!trimmed && <span class="report__status-sub" aria-hidden="true">improving since summer</span>}
      </div>
    </header>

    <p class="report__headline">Spotted <strong>12 of 15</strong> practice scams this quarter</p>

    {/* String of lights: one per drill, 12 lit and 3 open rings (coached).
        Decorative; the headline above carries the count for screen readers. */}
    <div class="lights report__lights" aria-hidden="true">
      {Array.from({ length: 15 }).map((_, i) => <i class={i >= 12 ? 'c' : undefined} style={`--i: ${i}`}></i>)}
    </div>

    <ul class="report__list">
      {drills.map((d) => (
        <li class:list={['report__row', d.coached && 'report__row--coached']}>
          <span class:list={['blip', d.coached && 'blip--alert']} aria-hidden="true"></span>
          <span class="report__what">{d.what}</span>
          <span class:list={['report__result', d.coached && 'report__result--alert']}>{d.outcome}</span>
        </li>
      ))}
    </ul>

    {trimmed ? (
      <footer class="report__foot report__foot--teaser">
        + 12 more drills, this quarter's scam briefings, and next quarter's focus.
        <a href="#report">See the full report</a>
      </footer>
    ) : (
      <>
        <p class="report__briefings">Plus: <strong>10 more drills</strong>, and briefings on the newest scams in circulation</p>
        <footer class="report__foot">
          <strong>What we're reinforcing next quarter:</strong> identifying voice cloning in phone calls and spotting look-alike sender numbers.
        </footer>
      </>
    )}
  </figure>
</div>

<script>
  // Bring the report to life when it scrolls into view: drill rows come in
  // one by one, once, then the status settles. Nothing repeats. Progressive enhancement: markup
  // ships the final state, so no-JS and reduced-motion users see everything.
  const reports = Array.from(document.querySelectorAll('.report'));
  const reduceMotionPref = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (reports.length && 'IntersectionObserver' in window && !reduceMotionPref) {
    reports.forEach((r) => r.classList.add('report--anim'));
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('report--play');
            io.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.35 }
    );
    reports.forEach((r) => io.observe(r));
  }
</script>

<style>
  .report-wrap { display: flex; flex-direction: column; max-width: 480px; width: 100%; }
  .report__sample {
    font-size: 0.875rem;
    line-height: 1;
    font-weight: 600;
    margin: 0 0 10px;
  }
  .report__sample { color: var(--color-text-muted); }

  .report {
    margin: 0;
    background: var(--white);
    /* Drawn like the illustrations: one walnut line. */
    border: 2px solid var(--color-text);
    border-radius: var(--radius);
    padding: 28px 28px 24px;
    font-size: 1rem;
    color: var(--ink);
  }
  .report--trimmed { padding: 26px 26px 22px; max-width: 420px; }

  /* Fictional-firm letterhead (cobrand prop). */
  .report__brand {
    display: flex;
    align-items: center;
    gap: 10px;
    padding-bottom: 14px;
    margin-bottom: 16px;
    border-bottom: 1px solid var(--line);
  }
  .report__brand-mark {
    flex: none;
    width: 30px;
    height: 30px;
    border-radius: 7px;
    background: var(--color-surface);
    border: 1.5px solid var(--color-text);
    color: var(--color-text);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.78rem;
    letter-spacing: 0.02em;
    display: grid;
    place-items: center;
  }
  .report__brand-text {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 2px 10px;
    width: 100%;
  }
  .report__brand-firm {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.95rem;
    letter-spacing: -0.01em;
    color: var(--ink);
  }
  .report__brand-for { margin: 0; font-size: 0.8rem; color: var(--gray-500); }

  .report__head {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 16px;
    margin-bottom: 6px;
  }
  .report--trimmed .report__head { align-items: center; }
  @media (max-width: 420px) {
    .report__head, .report--trimmed .report__head { flex-direction: column; align-items: flex-start; gap: 10px; }
    .report__status { text-align: left; justify-items: start; }
  }
  .report__title {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    color: var(--ink);
    margin: 0;
    line-height: 1.2;
  }
  .report--trimmed .report__title { font-size: 1.2rem; }
  .report__month { color: var(--gray-500); margin: 2px 0 0; font-size: 0.95rem; }

  /* Qualitative status block */
  .report__status { text-align: right; flex: none; display: grid; gap: 4px; justify-items: end; }
  .report__status-label {
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--gray-500);
  }
  .report__status-pill {
    background: var(--amber-tint);
    color: var(--amber-deep);
    font-weight: 700;
    font-size: 0.85rem;
    padding: 7px 13px;
    border-radius: var(--radius-chip);
    white-space: nowrap;
  }
  .report--trimmed .report__status-pill { font-size: 0.82rem; }
  .report__status-sub {
    font-size: 0.74rem;
    font-weight: 700;
    white-space: nowrap;
    color: var(--amber-text);
  }

  .report__headline { font-size: 1.05rem; margin: 12px 0 8px; color: var(--ink); }
  .report--trimmed .report__headline { font-size: 1.02rem; }
  .report__lights { margin: 0 0 16px -4px; }

  /* Drill rows are chips: blip dot, label, outcome. */
  .report__list { list-style: none; margin: 0 0 14px; padding: 0; display: grid; gap: 6px; }
  .report__row {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 8px 12px;
    background: var(--paper-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-ctrl);
  }
  /* Coached rows are dusk blue, so neither amber nor red ever says "careful". */
  .report__row--coached { background: var(--color-coach-bg); border-color: var(--color-coach-bg); }
  .report__what { color: var(--ink); line-height: 1.35; flex: 1; font-size: 0.95rem; font-weight: 500; }
  .report--trimmed .report__what { font-size: 0.92rem; }
  .report__result {
    flex: none;
    white-space: nowrap;
    font-size: 0.8125rem;
    font-weight: 700;
    color: var(--amber-deep);
  }
  .report--trimmed .report__result { font-size: 0.76rem; }
  .report__result--alert { color: var(--color-coach-text); }

  .report__briefings {
    font-size: 0.9rem;
    color: var(--gray-700);
    background: var(--sand);
    border-radius: var(--radius-ctrl);
    padding: 10px 14px;
    margin: 0 0 16px;
  }
  .report__briefings strong { color: var(--ink); }

  .report__foot {
    border-top: 1px solid var(--line);
    padding-top: 14px;
    font-size: 0.92rem;
    color: var(--gray-700);
  }
  .report__foot strong { color: var(--ink); }
  .report__foot--teaser { padding-top: 12px; font-size: 0.88rem; line-height: 1.55; color: var(--gray-500); }
  .report__foot--teaser a { font-weight: 700; }

  /* ---------- Scroll-in animation ----------
     .report--anim is added by JS only when motion is allowed, so the armed
     (hidden) states below never apply for no-JS or reduced-motion visitors.
     .report--play triggers the sequence when the card enters the viewport. */

  /* Card-level entrance: the whole artifact rises and settles first, then the
     internal sequence (headline → rows → briefings → status) plays over it. */
  .report--anim { opacity: 0; }
  .report--play {
    animation: reportEnter 0.55s cubic-bezier(0.22, 0.61, 0.36, 1) forwards;
  }
  @keyframes reportEnter {
    from { opacity: 0; transform: translateY(18px) scale(0.97); }
    to { opacity: 1; transform: none; }
  }

  /* The lights come on one at a time, 80ms apart, once. */
  .report--anim .report__lights i { opacity: 0.2; }
  .report--play .report__lights i {
    animation: lampOn 0.3s ease-out forwards;
    animation-delay: calc(0.3s + var(--i) * 0.08s);
  }

  .report--anim .report__headline,
  .report--anim .report__row,
  .report--anim .report__briefings,
  .report--anim .report__status-pill,
  .report--anim .report__status-sub {
    opacity: 0;
  }
  .report--play .report__headline {
    animation: reportRise 0.5s cubic-bezier(0.22, 0.61, 0.36, 1) 0.15s forwards;
  }
  .report--play .report__row {
    animation: reportRise 0.45s cubic-bezier(0.22, 0.61, 0.36, 1) forwards;
  }
  .report--play .report__row:nth-child(1) { animation-delay: 1.5s; }
  .report--play .report__row:nth-child(2) { animation-delay: 1.65s; }
  .report--play .report__row:nth-child(3) { animation-delay: 1.8s; }
  .report--play .report__row:nth-child(4) { animation-delay: 1.95s; }
  .report--play .report__row:nth-child(5) { animation-delay: 2.1s; }
  .report--play .report__row .blip {
    animation: blipIn 0.35s cubic-bezier(0.34, 1.56, 0.64, 1) backwards;
  }
  .report--play .report__row:nth-child(1) .blip { animation-delay: 1.6s; }
  .report--play .report__row:nth-child(2) .blip { animation-delay: 1.75s; }
  .report--play .report__row:nth-child(3) .blip { animation-delay: 1.9s; }
  .report--play .report__row:nth-child(4) .blip { animation-delay: 2.05s; }
  .report--play .report__row:nth-child(5) .blip { animation-delay: 2.2s; }

  .report--play .report__briefings {
    animation: reportRise 0.45s cubic-bezier(0.22, 0.61, 0.36, 1) 2.3s forwards;
  }
  .report--play .report__status-pill {
    animation: statusPop 0.5s cubic-bezier(0.34, 1.4, 0.64, 1) 2.45s forwards;
  }
  .report--play .report__status-sub {
    animation: reportRise 0.4s ease 2.65s forwards;
  }
  @keyframes reportRise {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: none; }
  }
  @keyframes statusPop {
    from { opacity: 0; transform: scale(0.6); }
    to { opacity: 1; transform: scale(1); }
  }
  @keyframes blipIn {
    from { transform: scale(0); }
    to { transform: scale(1); }
  }

  @media (max-width: 420px) {
    .report__row { flex-wrap: wrap; gap: 6px 10px; }
    .report__result { margin-left: auto; }
  }
</style>
