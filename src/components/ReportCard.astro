---
// The hero artifact — the monthly Resilience Report. Built in real HTML/CSS so
// it can become the actual product template later. Always labeled illustrative.
//
// variant: "full" (5 drills + briefings + next-month focus) — the /report section
//          "trimmed" (3 drills + a teaser link) — the hero
// tone:    "dark" (default) when the card sits on an ink surface, "light" on paper.
const { variant = 'full', tone = 'dark' } = Astro.props;
const trimmed = variant === 'trimmed';

const fullDrills = [
  { what: 'Fake bank “account locked” email', outcome: 'reported', coached: false },
  { what: 'Prize-sweepstakes email', outcome: 'deleted', coached: false },
  { what: 'Fake delivery text', outcome: 'ignored', coached: false },
  { what: 'Utility “past-due” email', outcome: 'reported', coached: false },
  { what: 'Fake bank text', outcome: 'responded & coached', coached: true },
];

const trimmedDrills = [
  { what: 'Fake bank “account locked” email', outcome: 'reported', coached: false },
  { what: 'Fake delivery text', outcome: 'ignored', coached: false },
  { what: 'Fake bank text', outcome: 'coached, 30 sec', coached: true },
];

const drills = trimmed ? trimmedDrills : fullDrills;
---

<div class:list={['report-wrap', `report-wrap--${tone}`]}>
  <p class="report__sample">Illustrative report</p>

  <figure class:list={['report', trimmed && 'report--trimmed']} aria-label="Sample monthly Resilience Report (illustrative)">
    <header class="report__head">
      <div>
        <p class="report__title">Margaret's Resilience Report</p>
        <p class="report__month">June</p>
      </div>
      <div class="report__status" role="img" aria-label="Status: mostly strong, improving since March">
        {!trimmed && <span class="report__status-label" aria-hidden="true">Status</span>}
        <span class="report__status-pill" aria-hidden="true">Mostly strong ↑</span>
        {!trimmed && <span class="report__status-sub" aria-hidden="true">improving since March</span>}
      </div>
    </header>

    <p class="report__headline">Spotted <strong>4 of 5</strong> practice scams this month</p>

    <ul class="report__list">
      {drills.map((d) => (
        <li class:list={['report__row', d.coached && 'report__row--coached']}>
          <span class:list={['blip', d.coached && 'blip--alert']} aria-hidden="true"></span>
          <span class="report__what">{d.what}</span>
          <span class:list={['report__result', d.coached && 'report__result--alert']}>{d.outcome}</span>
        </li>
      ))}
    </ul>

    {trimmed ? (
      <footer class="report__foot report__foot--teaser">
        + 2 more drills, this month's scam briefing, and next month's focus.
        <a href="#report">See the full report ↓</a>
      </footer>
    ) : (
      <>
        <p class="report__briefings">Plus: briefed on the <strong>3 newest scams</strong> in circulation this month</p>
        <footer class="report__foot">
          <strong>What we're reinforcing next month:</strong> spotting look-alike sender numbers in texts.
        </footer>
      </>
    )}
  </figure>
</div>

<script>
  // Bring the report to life when it scrolls into view: drill rows tick in
  // one by one, then the status pill pops. Progressive enhancement: markup
  // ships the final state, so no-JS and reduced-motion users see everything.
  const reports = Array.from(document.querySelectorAll('.report'));
  const reduceMotionPref = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (reports.length && 'IntersectionObserver' in window && !reduceMotionPref) {
    reports.forEach((r) => r.classList.add('report--anim'));
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('report--play');
            io.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.35 }
    );
    reports.forEach((r) => io.observe(r));
  }
</script>

<style>
  .report-wrap { display: flex; flex-direction: column; max-width: 480px; width: 100%; }
  .report__sample {
    font-size: 0.75rem;
    line-height: 1;
    font-weight: 700;
    margin: 0 0 10px;
  }
  .report-wrap--dark .report__sample { color: #bfbfbf; }
  .report-wrap--light .report__sample { color: var(--gray-500); }

  .report {
    margin: 0;
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 28px 28px 24px;
    font-size: 1rem;
    color: var(--ink);
  }
  .report-wrap--dark .report { box-shadow: var(--shadow-float); }
  .report--trimmed { padding: 26px 26px 22px; max-width: 420px; }

  .report__head {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 16px;
    margin-bottom: 6px;
  }
  .report--trimmed .report__head { align-items: center; }
  .report__title {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    color: var(--ink);
    margin: 0;
    line-height: 1.2;
  }
  .report--trimmed .report__title { font-size: 1.2rem; }
  .report__month { color: var(--gray-500); margin: 2px 0 0; font-size: 0.95rem; }

  /* Qualitative status block */
  .report__status { text-align: right; flex: none; display: grid; gap: 4px; justify-items: end; }
  .report__status-label {
    font-size: 0.65rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--gray-500);
  }
  .report__status-pill {
    background: var(--amber-tint);
    color: var(--amber-deep);
    font-weight: 800;
    font-size: 0.85rem;
    padding: 7px 13px;
    border-radius: 7px;
    white-space: nowrap;
  }
  .report--trimmed .report__status-pill { font-size: 0.82rem; }
  .report__status-sub {
    font-size: 0.74rem;
    font-weight: 700;
    white-space: nowrap;
    color: var(--amber-text);
  }

  .report__headline { font-size: 1.05rem; margin: 12px 0 14px; color: var(--ink); }
  .report--trimmed .report__headline { font-size: 1.02rem; margin-bottom: 12px; }

  /* Drill rows are chips: blip dot, label, outcome. */
  .report__list { list-style: none; margin: 0 0 14px; padding: 0; display: grid; gap: 6px; }
  .report__row {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 8px 12px;
    background: var(--paper-bg);
    border: 1px solid var(--sand);
    border-radius: var(--radius-ctrl);
  }
  .report__row--coached { background: var(--white); border: 1.5px solid var(--alert); }
  .report__what { color: var(--ink); line-height: 1.35; flex: 1; font-size: 0.95rem; font-weight: 500; }
  .report--trimmed .report__what { font-size: 0.92rem; }
  .report__result {
    flex: none;
    white-space: nowrap;
    font-size: 0.78rem;
    font-weight: 800;
    color: var(--amber-deep);
  }
  .report--trimmed .report__result { font-size: 0.76rem; }
  .report__result--alert { color: var(--alert); }

  .report__briefings {
    font-size: 0.9rem;
    color: var(--gray-700);
    background: var(--sand);
    border-radius: var(--radius-ctrl);
    padding: 10px 14px;
    margin: 0 0 16px;
  }
  .report__briefings strong { color: var(--ink); }

  .report__foot {
    border-top: 1px solid var(--line);
    padding-top: 14px;
    font-size: 0.92rem;
    color: var(--gray-700);
  }
  .report__foot strong { color: var(--ink); }
  .report__foot--teaser { padding-top: 12px; font-size: 0.88rem; line-height: 1.55; color: var(--gray-500); }
  .report__foot--teaser a { font-weight: 700; }

  /* ---------- Scroll-in animation ----------
     .report--anim is added by JS only when motion is allowed, so the armed
     (hidden) states below never apply for no-JS or reduced-motion visitors.
     .report--play triggers the sequence when the card enters the viewport. */
  .report--anim .report__headline,
  .report--anim .report__row,
  .report--anim .report__briefings,
  .report--anim .report__status-pill,
  .report--anim .report__status-sub {
    opacity: 0;
  }
  .report--play .report__headline {
    animation: reportRise 0.5s cubic-bezier(0.22, 0.61, 0.36, 1) 0.15s forwards;
  }
  .report--play .report__row {
    animation: reportRise 0.45s cubic-bezier(0.22, 0.61, 0.36, 1) forwards;
  }
  .report--play .report__row:nth-child(1) { animation-delay: 0.35s; }
  .report--play .report__row:nth-child(2) { animation-delay: 0.55s; }
  .report--play .report__row:nth-child(3) { animation-delay: 0.75s; }
  .report--play .report__row:nth-child(4) { animation-delay: 0.95s; }
  .report--play .report__row:nth-child(5) { animation-delay: 1.15s; }
  .report--play .report__row .blip {
    animation: blipIn 0.35s cubic-bezier(0.34, 1.56, 0.64, 1) backwards;
  }
  .report--play .report__row:nth-child(1) .blip { animation-delay: 0.5s; }
  .report--play .report__row:nth-child(2) .blip { animation-delay: 0.7s; }
  .report--play .report__row:nth-child(3) .blip { animation-delay: 0.9s; }
  .report--play .report__row:nth-child(4) .blip { animation-delay: 1.1s; }
  .report--play .report__row:nth-child(5) .blip { animation-delay: 1.3s; }
  .report--play .report__briefings {
    animation: reportRise 0.45s cubic-bezier(0.22, 0.61, 0.36, 1) 1.45s forwards;
  }
  .report--play .report__status-pill {
    animation: statusPop 0.5s cubic-bezier(0.34, 1.4, 0.64, 1) 1.6s forwards;
  }
  .report--play .report__status-sub {
    animation: reportRise 0.4s ease 1.85s forwards;
  }
  @keyframes reportRise {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: none; }
  }
  @keyframes statusPop {
    from { opacity: 0; transform: scale(0.6); }
    to { opacity: 1; transform: scale(1); }
  }
  @keyframes blipIn {
    from { transform: scale(0); }
    to { transform: scale(1); }
  }

  @media (max-width: 420px) {
    .report__row { flex-wrap: wrap; gap: 6px 10px; }
    .report__result { margin-left: auto; }
  }
</style>
