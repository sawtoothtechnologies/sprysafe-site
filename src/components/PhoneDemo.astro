---
// Manual homepage walkthrough. The chosen scene appears together so the
// visitor can read at their own pace. Reduced motion removes the short fade.
// Without JS, the drill example remains visible. The illustration is decorative;
// the buttons carry the accessible explanation.
//
// With a `scene` number (0 to 3) the component renders that one scene on its
// own, without the phone frame. The homepage uses this on smaller screens,
// where each step opens its own example in place. Those examples are opened by
// a button, so they are readable by screen readers rather than decorative.
const { scene } = Astro.props;
const single = typeof scene === 'number';
const show = (i) => !single || scene === i;
---

<figure
  class:list={['phone', single && 'phone--bare']}
  id={single ? undefined : 'phone-demo'}
  aria-label={single ? 'Illustrative example, simulated and safe' : 'Illustrative example of ScamPrep practice drills arriving on a phone, simulated and safe'}
>

  <div class="phone__frame" aria-hidden={single ? undefined : 'true'}>
    <div class="phone__screen">
      {single && <p class="phone__label">Illustrative example</p>}
      {!single && <span class="phone__island"></span>}
      {!single && (
        <div class="phone__statusbar">
          <span class="phone__time">9:41</span>
          <span class="phone__status-right">
            <span class="phone__signal"><i></i><i></i><i></i><i></i></span>
            <span class="phone__battery"><i></i></span>
          </span>
        </div>
      )}

      <!-- Scene 1 — Enroll / opt-in -->
      {show(0) && (
      <div class:list={['scene', single && 'is-static']} data-scene="0">
        <div class="beat bubble bubble--in">
          Hi Mary, this is ScamPrep. Michael set up scam practice for you: a few short, friendly drills a month, so the real ones are easier to spot. Reply YES to start.
        </div>
        <div class="beat bubble bubble--out">YES</div>
        <div class="beat chip chip--ok"><span class="blip"></span>Opted in. Always in control</div>
      </div>
      )}

      <!-- Scene 2 — A simulated drill (default when JS is off) -->
      {show(1) && (
      <div class="scene is-static" data-scene="1">
        <div class="beat bubble bubble--in bubble--scam">
          <span class="bubble__tag">Simulated</span>
          USPS: your package is on hold. Pay a $1.95 redelivery fee at
          <span class="bubble__link">usps-track-19.co</span>
        </div>
        <div class="beat chip chip--ok"><span class="blip"></span>Didn't tap the link</div>
        <div class="beat callcard">
          <span class="callcard__ring">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#121110" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.8 19.8 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.12 4.18 2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z" />
            </svg>
          </span>
          <span class="callcard__who">
            <strong>Incoming call</strong>
            “Granddaughter in trouble” (spoofed number)
          </span>
        </div>
        <div class="beat chip chip--ok"><span class="blip"></span>Hung up, called the real number</div>
        <div class="beat banner">Drills passed. When one slips by, coached in 30 seconds.</div>
      </div>
      )}

      <!-- Scene 3 — Drip briefing -->
      {show(2) && (
      <div class:list={['scene', single && 'is-static']} data-scene="2">
        <div class="beat bubble bubble--in">
          <strong>ScamPrep heads-up:</strong> a new IRS scam is making the rounds. The tell: they threaten arrest unless you pay right away. The IRS never calls to threaten arrest or demand immediate payment.
        </div>
        <div class="beat chip">Quick read, and always current</div>
      </div>
      )}

      <!-- Scene 4 — Resilience Report -->
      {show(3) && (
      <div class:list={['scene', single && 'is-static']} data-scene="3">
        <div class="beat notif">
          <span class="notif__icon">
            <svg width="22" height="22" viewBox="10 10 76 76" fill="none">
              <path d="M 57.02 19.39 A 30 30 0 1 0 76.61 38.98" stroke="#121110" stroke-width="8.5" stroke-linecap="round" />
              <circle cx="48" cy="48" r="11" fill="#f0a11c" />
            </svg>
          </span>
          <span class="notif__body">
            <strong>Mary’s quarterly Resilience Report is ready</strong>
            Status: <span class="notif__delta">Mostly strong ↑</span><br />Spotted 12 of 15 practice scams
          </span>
        </div>
        <div class="beat chip chip--ok"><span class="blip"></span>Proof they’re getting savvier, without feeling supervised</div>
      </div>
      )}

      {!single && <span class="phone__home"></span>}
    </div>
  </div>
</figure>

<script>
  const phone = document.getElementById('phone-demo');
  if (phone) {
    phone.classList.add('phone--js');
    const scenes = Array.from(phone.querySelectorAll<HTMLElement>('.scene'));
    const setScene = (index: number) => {
      scenes.forEach((scene) => {
        scene.classList.remove('is-static');
        scene.classList.toggle('is-active', Number(scene.dataset.scene) === index);
      });
    };
    document.addEventListener('scamprep:hiwchange', (event) => {
      setScene((event as CustomEvent<{ index: number }>).detail.index);
    });
    const selected = Array.from(document.querySelectorAll('.hiw__card')).findIndex(
      (card) => card.getAttribute('aria-pressed') === 'true'
    );
    setScene(Math.max(0, selected));
  }
</script>

<style>
  .phone { margin: 0; display: flex; flex-direction: column; align-items: center; gap: 18px; }

  /* ---------- The device ----------
     A line drawing of a phone, not a dark slab (v1.1).
     One ink outline, a white screen, a camera island and a home
     indicator. No bezel gradient, no drop shadow. */
  .phone__frame {
    position: relative;
    width: min(312px, 86vw);
    border-radius: 44px;
    padding: 6px;
    background: var(--white);
    border: 2.5px solid var(--ink);
  }
  /* Side buttons: power on the right; volume up and down on the left (the
     second volume button is the box-shadow copy). */
  .phone__frame::before,
  .phone__frame::after {
    content: '';
    position: absolute;
    width: 3px;
    border-radius: 2px;
    background: var(--ink);
  }
  .phone__frame::before { right: -5.5px; top: 138px; height: 64px; }
  .phone__frame::after { left: -5.5px; top: 108px; height: 36px; box-shadow: 0 46px 0 var(--ink); }

  .phone__screen {
    position: relative;
    background: var(--paper-bg);
    border-radius: 36px;
    min-height: 528px;
    padding: 12px 14px 12px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }
  .phone__island {
    position: absolute;
    left: 50%;
    top: 11px;
    width: 88px;
    height: 25px;
    margin-left: -44px;
    border-radius: 13px;
    background: var(--ink);
  }
  .phone__statusbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--ink);
    padding: 3px 12px 0 14px;
    height: 31px;
    margin-bottom: 14px;
    flex: none;
  }
  .phone__time { letter-spacing: -0.01em; }
  .phone__status-right { display: inline-flex; align-items: center; gap: 6px; }
  .phone__signal { display: inline-flex; gap: 2px; align-items: flex-end; }
  .phone__signal i { width: 3px; background: var(--ink); border-radius: 1px; display: block; }
  .phone__signal i:nth-child(1) { height: 4px; }
  .phone__signal i:nth-child(2) { height: 6px; }
  .phone__signal i:nth-child(3) { height: 8px; }
  .phone__signal i:nth-child(4) { height: 10px; }
  .phone__battery {
    position: relative;
    display: inline-block;
    width: 22px;
    height: 11px;
    border: 1.5px solid var(--gray-400);
    border-radius: 3.5px;
  }
  .phone__battery::after {
    content: '';
    position: absolute;
    right: -4px;
    top: 2px;
    width: 1.5px;
    height: 4px;
    border-radius: 0 1px 1px 0;
    background: var(--gray-400);
  }
  .phone__battery i { position: absolute; top: 1.5px; bottom: 1.5px; left: 1.5px; width: 72%; border-radius: 1.5px; background: var(--ink); }
  .phone__home {
    flex: none;
    margin-top: auto;
    align-self: center;
    width: 108px;
    height: 5px;
    border-radius: 3px;
    background: var(--ink);
    opacity: 0.85;
  }

  /* ---------- Scenes ---------- */
  .scene { display: none; flex-direction: column; gap: 12px; padding-bottom: 18px; }
  /* No-JS fallback: show the drill scene statically. */
  .scene.is-static { display: flex; }
  .phone--js .scene { display: none; }
  .phone--js .scene.is-active { display: flex; }

  @media (prefers-reduced-motion: no-preference) {
    .phone--js .scene.is-active { animation: sceneIn 220ms ease-out both; }
  }
  @keyframes sceneIn { from { opacity: 0; } to { opacity: 1; } }

  /* ---------- A single scene, no device ----------
     Used inside the homepage steps on smaller screens. The visitor is already
     holding a phone, so the messages sit in a plain panel at reading size. */
  .phone--bare { display: block; }
  .phone--bare .phone__frame { width: auto; border: 0; border-radius: 0; padding: 0; background: transparent; }
  .phone--bare .phone__frame::before,
  .phone--bare .phone__frame::after { display: none; }
  .phone--bare .phone__screen { min-height: 0; border-radius: 0; padding: 0; background: transparent; overflow: visible; }
  .phone--bare .scene { padding-bottom: 0; }
  .phone--bare .bubble { font-size: 1rem; line-height: 1.5; }
  .phone--bare .chip { font-size: 0.875rem; }
  .phone--bare .banner,
  .phone--bare .callcard__who,
  .phone--bare .notif__body { font-size: 0.9375rem; }
  .phone--bare .callcard__who strong,
  .phone--bare .notif__body strong { font-size: 1rem; }
  .phone__label { margin: 0 0 12px; font-size: 0.875rem; font-weight: 700; line-height: 1.3; color: var(--amber-deep); }

  /* ---------- Message bubbles ---------- */
  .bubble {
    max-width: 88%;
    padding: 12px 14px;
    border-radius: 14px;
    font-size: 0.92rem;
    line-height: 1.45;
    color: var(--ink);
  }
  .bubble--in {
    background: var(--white);
    border: 1px solid var(--line);
    border-bottom-left-radius: 5px;
    align-self: flex-start;
  }
  /* The learner's own reply: honey, not a dark fill. */
  .bubble--out {
    background: var(--honey);
    color: var(--ink);
    border-bottom-right-radius: 5px;
    align-self: flex-end;
    font-weight: 700;
  }
  .bubble--scam { border-color: var(--line); background: var(--white); }
  /* Sits inside the first line of the message without making that line
     taller than the ones below it. */
  .bubble__tag {
    display: inline-block;
    font-size: 0.72rem;
    font-weight: 600;
    line-height: 1.2;
    color: var(--ink);
    background: var(--sand);
    border: 1px solid var(--line);
    border-radius: var(--radius-chip);
    padding: 1px 7px;
    margin: 0 3px 0 0;
    vertical-align: 0.08em;
  }
  .bubble__link { color: var(--amber-text); text-decoration: underline; word-break: break-all; }

  /* ---------- Chips & banner ---------- */
  .chip {
    align-self: center;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--ink);
    background: var(--sand);
    border-radius: var(--radius-chip);
    padding: 6px 14px;
    text-align: center;
  }
  .chip--ok { color: var(--amber-deep); background: var(--amber-tint); }
  .chip .blip { width: 7px; height: 7px; box-shadow: 0 0 0 3px rgba(240, 161, 28, 0.25); }
  .banner {
    background: var(--glow);
    color: var(--amber-deep);
    border-radius: var(--radius-ctrl);
    padding: 11px 14px;
    font-size: 0.88rem;
    font-weight: 700;
    text-align: center;
    line-height: 1.4;
  }

  /* ---------- Incoming call card ---------- */
  .callcard {
    display: flex;
    gap: 12px;
    align-items: center;
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: var(--radius-ctrl);
    padding: 12px 14px;
  }
  .callcard__ring {
    position: relative;
    flex: none;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--glow);
    display: grid;
    place-items: center;
  }
  .callcard__who { font-size: 0.86rem; line-height: 1.4; color: var(--gray-700); }
  .callcard__who strong { display: block; color: var(--ink); font-size: 0.94rem; }

  /* ---------- Report notification ---------- */
  .notif {
    display: flex;
    gap: 12px;
    align-items: flex-start;
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: var(--radius-ctrl);
    padding: 13px 14px;
  }
  .notif__icon { flex: none; display: grid; place-items: center; padding-top: 2px; }
  .notif__body { font-size: 0.86rem; line-height: 1.45; color: var(--gray-700); }
  .notif__body strong { display: block; color: var(--ink); font-size: 0.92rem; margin-bottom: 2px; }
  .notif__delta { color: var(--amber-deep); font-weight: 700; }
</style>
