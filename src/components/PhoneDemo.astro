---
// Animated phone mockup for the homepage "How it works" section.
// Each step of the walkthrough gets a matching "scene" on the phone:
//   1 — the opt-in welcome text     2 — a simulated drill (text + call)
//   3 — a drip briefing             4 — the Resilience Report notification
// The scenes are driven by the how-it-works script in index.astro, which
// dispatches a `scamprep:hiwchange` event whenever the active step changes.
//
// Progressive enhancement / accessibility:
// - Without JS, the drill scene (the most illustrative one) renders statically.
// - With prefers-reduced-motion, scenes still switch but beats appear instantly.
// - The whole phone is decorative for screen readers (the step panels carry the
//   real explanation), so the internals are aria-hidden.
---

<figure class="phone" id="phone-demo" aria-label="Illustrative example of ScamPrep practice drills arriving on a phone, simulated and safe">

  <div class="phone__frame" aria-hidden="true">
    <div class="phone__screen">
      <span class="phone__island"></span>
      <div class="phone__statusbar">
        <span class="phone__time">9:41</span>
        <span class="phone__status-right">
          <span class="phone__signal"><i></i><i></i><i></i><i></i></span>
          <span class="phone__battery"><i></i></span>
        </span>
      </div>

      <!-- Scene 1 — Enroll / opt-in -->
      <div class="scene" data-scene="0">
        <div class="beat bubble bubble--in" style="--d: 0.3s;">
          Hi Mary, this is ScamPrep. Michael set up scam practice for you: a few short, friendly drills a month, so the real ones are easier to spot. Reply YES to start.
        </div>
        <div class="beat bubble bubble--out" style="--d: 1.5s;">YES</div>
        <div class="beat chip chip--ok" style="--d: 2.3s;"><span class="blip"></span>Opted in. Always in control</div>
      </div>

      <!-- Scene 2 — A simulated drill (default when JS is off) -->
      <div class="scene is-static" data-scene="1">
        <div class="beat beat--buzz bubble bubble--in bubble--scam" style="--d: 0.3s;">
          <span class="bubble__tag">Simulated</span>
          USPS: your package is on hold. Pay a $1.99 redelivery fee at
          <span class="bubble__link">usps-track-19.co</span>
        </div>
        <div class="beat chip chip--ok" style="--d: 1.7s;"><span class="blip"></span>Didn't tap the link</div>
        <div class="beat beat--buzz callcard" style="--d: 2.7s;">
          <span class="callcard__ring">
            <span class="callcard__rings"></span>
            <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
              <circle cx="10" cy="10" r="6.5" fill="none" stroke="#332b23" stroke-width="1.6" />
              <circle cx="10" cy="10" r="2.2" fill="#f0a11c" />
            </svg>
          </span>
          <span class="callcard__who">
            <strong>Incoming call</strong>
            “Granddaughter in trouble” (spoofed number)
          </span>
        </div>
        <div class="beat chip chip--ok" style="--d: 4.2s;"><span class="blip"></span>Hung up, called the real number</div>
        <div class="beat banner" style="--d: 5.1s;">Drills passed. When one slips by, coached in 30 seconds.</div>
      </div>

      <!-- Scene 3 — Drip briefing -->
      <div class="scene" data-scene="2">
        <div class="beat bubble bubble--in" style="--d: 0.3s;">
          <strong>ScamPrep heads-up:</strong> a new IRS scam is making the rounds. The tell: they threaten arrest unless you pay right away. The IRS never calls to threaten arrest or demand immediate payment.
        </div>
        <div class="beat chip" style="--d: 1.9s;">Quick read, and always current</div>
      </div>

      <!-- Scene 4 — Resilience Report -->
      <div class="scene" data-scene="3">
        <div class="beat notif" style="--d: 0.3s;">
          <span class="notif__icon">
            <svg width="22" height="22" viewBox="0 0 32 32">
              <path d="M16 4 30 18h-6.6L16 10.6 8.6 18H2z" fill="#332b23" />
              <circle cx="16" cy="21.2" r="5.3" fill="#f0a11c" />
            </svg>
          </span>
          <span class="notif__body">
            <strong>Mary’s quarterly Resilience Report is ready</strong>
            Status: <span class="notif__delta">Mostly strong ↑</span><br />Spotted 12 of 15 practice scams
          </span>
        </div>
        <div class="beat chip chip--ok" style="--d: 1.8s;"><span class="blip"></span>Proof they’re getting savvier, without feeling supervised</div>
      </div>

      <span class="phone__home"></span>
    </div>
  </div>
</figure>

<script>
  const phone = document.getElementById('phone-demo');
  if (phone) {
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    phone.classList.add('phone--js');
    if (!reduce) phone.classList.add('phone--anim');
    const scenes = Array.from(phone.querySelectorAll('.scene'));

    const setScene = (i) => {
      scenes.forEach((s) => {
        const active = Number(s.dataset.scene) === i;
        s.classList.remove('is-static');
        if (active && !s.classList.contains('is-active')) {
          // Force a reflow between class toggles so CSS animations restart
          // every time a scene becomes active again.
          s.classList.remove('is-active');
          void s.offsetWidth;
          s.classList.add('is-active');
        } else if (!active) {
          s.classList.remove('is-active');
        }
      });
    };

    document.addEventListener('scamprep:hiwchange', (e) => setScene(e.detail.index));
    setScene(0);
  }
</script>

<style>
  .phone { margin: 0; display: flex; flex-direction: column; align-items: center; gap: 18px; }

  /* ---------- The device ----------
     Drawn the Lamplight way: a line drawing of a phone, not a dark slab.
     One walnut outline, a white screen, a camera island and a home
     indicator. No bezel gradient, no drop shadow. */
  .phone__frame {
    position: relative;
    width: min(312px, 86vw);
    border-radius: 44px;
    padding: 6px;
    background: var(--color-surface);
    border: 2.5px solid var(--color-text);
  }
  /* Side buttons: power on the right; volume up and down on the left (the
     second volume button is the box-shadow copy). */
  .phone__frame::before,
  .phone__frame::after {
    content: '';
    position: absolute;
    width: 3px;
    border-radius: 2px;
    background: var(--color-text);
  }
  .phone__frame::before { right: -5.5px; top: 138px; height: 64px; }
  .phone__frame::after { left: -5.5px; top: 108px; height: 36px; box-shadow: 0 46px 0 var(--color-text); }

  .phone__screen {
    position: relative;
    background: var(--paper-bg);
    border-radius: 36px;
    min-height: 528px;
    padding: 12px 14px 12px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }
  .phone__island {
    position: absolute;
    left: 50%;
    top: 11px;
    width: 88px;
    height: 25px;
    margin-left: -44px;
    border-radius: 13px;
    background: var(--ink);
  }
  .phone__statusbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--ink);
    padding: 3px 12px 0 14px;
    height: 31px;
    margin-bottom: 14px;
    flex: none;
  }
  .phone__time { letter-spacing: -0.01em; }
  .phone__status-right { display: inline-flex; align-items: center; gap: 6px; }
  .phone__signal { display: inline-flex; gap: 2px; align-items: flex-end; }
  .phone__signal i { width: 3px; background: var(--ink); border-radius: 1px; display: block; }
  .phone__signal i:nth-child(1) { height: 4px; }
  .phone__signal i:nth-child(2) { height: 6px; }
  .phone__signal i:nth-child(3) { height: 8px; }
  .phone__signal i:nth-child(4) { height: 10px; }
  .phone__battery {
    position: relative;
    display: inline-block;
    width: 22px;
    height: 11px;
    border: 1.5px solid var(--color-control-border);
    border-radius: 3.5px;
  }
  .phone__battery::after {
    content: '';
    position: absolute;
    right: -4px;
    top: 2px;
    width: 1.5px;
    height: 4px;
    border-radius: 0 1px 1px 0;
    background: var(--color-control-border);
  }
  .phone__battery i { position: absolute; top: 1.5px; bottom: 1.5px; left: 1.5px; width: 72%; border-radius: 1.5px; background: var(--ink); }
  .phone__home {
    flex: none;
    margin-top: auto;
    align-self: center;
    width: 108px;
    height: 5px;
    border-radius: 3px;
    background: var(--ink);
    opacity: 0.85;
  }

  /* ---------- Scenes ---------- */
  .scene { display: none; flex-direction: column; gap: 12px; padding-bottom: 18px; }
  /* No-JS fallback: show the drill scene statically. */
  .scene.is-static { display: flex; }
  .phone--js .scene { display: none; }
  .phone--js .scene.is-active { display: flex; }

  /* Beats: visible by default (no-JS / reduced motion). Only when the
     phone is allowed to animate do we hide them and play them in. */
  .phone--anim .scene.is-active .beat {
    opacity: 0;
    animation: beatIn 0.45s cubic-bezier(0.22, 0.61, 0.36, 1) forwards;
    animation-delay: var(--d, 0s);
  }
  .phone--anim .scene.is-active .beat--buzz {
    animation-name: beatIn, buzz;
    animation-duration: 0.45s, 0.5s;
    animation-delay: var(--d, 0s), calc(var(--d, 0s) + 0.1s);
    animation-fill-mode: forwards, none;
  }
  @keyframes beatIn {
    from { opacity: 0; transform: translateY(12px) scale(0.97); }
    to { opacity: 1; transform: none; }
  }
  @keyframes buzz {
    0%, 100% { transform: translateX(0); }
    15% { transform: translateX(-3px) rotate(-0.4deg); }
    30% { transform: translateX(3px) rotate(0.4deg); }
    45% { transform: translateX(-3px); }
    60% { transform: translateX(3px); }
    75% { transform: translateX(-2px); }
    90% { transform: translateX(2px); }
  }

  /* ---------- Message bubbles ---------- */
  .bubble {
    max-width: 88%;
    padding: 12px 14px;
    border-radius: 14px;
    font-size: 0.92rem;
    line-height: 1.45;
    color: var(--ink);
  }
  .bubble--in {
    background: var(--white);
    border: 1px solid var(--line);
    border-bottom-left-radius: 5px;
    align-self: flex-start;
  }
  /* The learner's own reply: honey, not a dark fill. */
  .bubble--out {
    background: var(--color-band);
    color: var(--color-text);
    border-bottom-right-radius: 5px;
    align-self: flex-end;
    font-weight: 700;
  }
  .bubble--scam { border-color: var(--line); background: var(--white); }
  .bubble__tag {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--color-text);
    background: var(--color-band-alt);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-chip);
    padding: 2px 8px;
    margin-bottom: 6px;
  }
  .bubble__link { color: var(--amber-text); text-decoration: underline; word-break: break-all; }

  /* ---------- Chips & banner ---------- */
  .chip {
    align-self: center;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--color-text);
    background: var(--color-band-alt);
    border-radius: var(--radius-chip);
    padding: 6px 14px;
    text-align: center;
  }
  .chip--ok { color: var(--amber-deep); background: var(--amber-tint); }
  .chip .blip { width: 7px; height: 7px; box-shadow: 0 0 0 3px rgba(240, 161, 28, 0.25); }
  .banner {
    background: var(--color-tint);
    color: var(--color-link);
    border-radius: var(--radius-ctrl);
    padding: 11px 14px;
    font-size: 0.88rem;
    font-weight: 700;
    text-align: center;
    line-height: 1.4;
  }

  /* ---------- Incoming call card ---------- */
  .callcard {
    display: flex;
    gap: 12px;
    align-items: center;
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: var(--radius-ctrl);
    padding: 12px 14px;
  }
  .callcard__ring {
    position: relative;
    flex: none;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--color-tint);
    display: grid;
    place-items: center;
  }
  .callcard__rings,
  .callcard__rings::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 50%;
    border: 1.5px solid rgba(240, 161, 28, 0.8);
    opacity: 0;
  }
  .phone--anim .scene.is-active .callcard__rings,
  .phone--anim .scene.is-active .callcard__rings::after {
    /* The simulated call rings twice and stops. Nothing loops. */
    animation: ringPulse 1.4s ease-out 2;
    animation-delay: calc(var(--d, 0s) + 0.3s);
  }
  .phone--anim .scene.is-active .callcard__rings::after { animation-delay: calc(var(--d, 0s) + 1s); }
  @keyframes ringPulse {
    0% { transform: scale(1); opacity: 0.8; }
    100% { transform: scale(1.85); opacity: 0; }
  }
  .callcard__who { font-size: 0.86rem; line-height: 1.4; color: var(--gray-700); }
  .callcard__who strong { display: block; color: var(--ink); font-size: 0.94rem; }

  /* ---------- Report notification ---------- */
  .notif {
    display: flex;
    gap: 12px;
    align-items: flex-start;
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: var(--radius-ctrl);
    padding: 13px 14px;
  }
  .notif__icon { flex: none; display: grid; place-items: center; padding-top: 2px; }
  .notif__body { font-size: 0.86rem; line-height: 1.45; color: var(--gray-700); }
  .notif__body strong { display: block; color: var(--ink); font-size: 0.92rem; margin-bottom: 2px; }
  .notif__delta { color: var(--amber-deep); font-weight: 700; }
</style>
