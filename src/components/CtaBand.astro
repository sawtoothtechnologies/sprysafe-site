---
const {
  headline = 'Practice scams before the real thing arrives.',
  body = 'Realistic practice, friendly coaching, and a report every three months, with nothing to install or manage.',
  cta = 'See plans',
  href = '/pricing',
  layout = 'center', // 'center' (default) or 'split': left copy + right-hand slot
  // Optional muted aside under the button; may contain HTML (e.g. a mailto link).
  // The default keeps the Stay in touch form reachable for people who aren't ready to buy.
  note = 'Not ready yet? <a href="/stay-in-touch">Stay in touch.</a>',
} = Astro.props;
const split = layout === 'split';
---

<section class:list={['section', 'cta-band', split ? 'cta-band--split' : 'center']}>
  <div class="wrap cta-band__inner">
    <div class="cta-band__copy">
      <h2>{headline}</h2>
      <p class="lede">{body}</p>
      <p style="margin-top: 28px;">
        <a class="btn btn--primary" href={href}>{cta}</a>
      </p>
      {note && <p class="cta-band__note" set:html={note} />}
    </div>
    {split && Astro.slots.has('default') && (
      <div class="cta-band__aside"><slot /></div>
    )}
  </div>
</section>

<style>
  .cta-band__inner { position: relative; }
  .cta-band .lede { max-width: 40rem; }
  /* The closing band is amber, not ink (v1.1): the page's one saturated
     moment before the dark footer. Ink text on amber is about 7:1. */
  /* Its top edge is a shallow arch, like the rim of a pool of light. */
  .cta-band {
    background: var(--amber);
    position: relative;
    border-radius: 50% 50% 0 0 / 56px 56px 0 0;
  }
  @media (max-width: 700px) {
    .cta-band { border-radius: 50% 50% 0 0 / 28px 28px 0 0; }
  }
  /* After a full-width sand band, the arch rises straight out of the sand:
     the spread shadow fills the corner notches with gray, and the clip-path
     keeps it inside the band's own box. */
  :global(.section--paper) + .cta-band {
    box-shadow: 0 0 0 100vmax var(--sand);
    clip-path: inset(0);
  }
  .cta-band h2, .cta-band .lede { color: var(--ink); }
  /* Centered like the lede above it; the split layout pulls it back to the left. */
  .cta-band__note { margin: 22px auto 0; font-size: 0.95rem; color: var(--ink); max-width: 40rem; }
  .cta-band--split .cta-band__note { margin-inline: 0; }
  /* The note arrives through set:html, so its link needs a :global rule to be styled
     (scoped styles don't reach injected markup). Ink on amber keeps the contrast. */
  .cta-band__note :global(a) { color: var(--ink); text-decoration: underline; text-underline-offset: 3px; }

  /* Split layout: copy left, a reserved right-hand column for the aside slot.
     With no aside, the right half stays open. */
  .cta-band--split .cta-band__inner {
    text-align: left;
    display: grid;
    gap: 40px 64px;
  }
  @media (min-width: 920px) {
    .cta-band--split .cta-band__inner {
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
      align-items: center;
    }
    /* Keep the copy in the left column even when the aside is absent. */
    .cta-band--split .cta-band__copy { grid-column: 1; }
  }
</style>
